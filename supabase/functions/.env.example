# Supabase Edge Function secrets for WSS Stripe (Stage A).
# Set with: supabase secrets set --env-file supabase/functions/.env  (NEVER commit real values)
# These live ONLY in the Edge Function runtime — never in VITE_* / the browser.

# Stripe (use TEST keys first; switch to live only after end-to-end verification)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create products/prices first — see STAGE_A_BILLING.md)
STRIPE_PRICE_OPERATIONS=     # recurring $399/mo
STRIPE_PRICE_GROWTH=         # recurring $899/mo
STRIPE_PRICE_TOPUP_50=       # one-time (amount TBD)
STRIPE_PRICE_TOPUP_100=      # one-time (amount TBD)
STRIPE_PRICE_TOPUP_250=      # one-time (amount TBD)
STRIPE_PRICE_DNS=            # one-time $100

# URLs
APP_URL=https://app.websitesupportstudio.com
SITE_URL=https://websitesupportstudio.com
ALLOWED_ORIGINS=https://websitesupportstudio.com,https://www.websitesupportstudio.com,https://app.websitesupportstudio.com

# Supabase (service role — webhook only; NEVER in the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (server-side only).
RESEND_API_KEY=
WSS_EMAIL_FROM=Website Support Studio <notifications@websitesupportstudio.com>
WSS_EMAIL_REPLY_TO=corristonconsulting@gmail.com
WSS_INTERNAL_NOTIFICATION_TO=corristonconsulting@gmail.com

# Optional: set if published Resend Template aliases/IDs should be used instead
# of the runtime HTML fallback. Values can be aliases or template IDs.
RESEND_TEMPLATE_WSS_CUSTOMER_WELCOME=wss-customer-welcome
RESEND_TEMPLATE_WSS_CUSTOMER_FOUNDER_PURCHASE_CONFIRMATION=wss-customer-founder-purchase-confirmation
RESEND_TEMPLATE_WSS_CUSTOMER_WEBSITE_BUILD_INTAKE_RECEIVED=wss-customer-website-build-intake-received
RESEND_TEMPLATE_WSS_CUSTOMER_REQUEST_RECEIVED=wss-customer-request-received
RESEND_TEMPLATE_WSS_CUSTOMER_REQUEST_UPDATED=wss-customer-request-updated
RESEND_TEMPLATE_WSS_CUSTOMER_REQUEST_COMPLETED=wss-customer-request-completed
RESEND_TEMPLATE_WSS_CUSTOMER_WEBSITE_LAUNCHED=wss-customer-website-launched
RESEND_TEMPLATE_WSS_CUSTOMER_PAYMENT_RECEIVED=wss-customer-payment-received
RESEND_TEMPLATE_WSS_INTERNAL_FOUNDER_PURCHASE=wss-internal-founder-purchase
RESEND_TEMPLATE_WSS_INTERNAL_CONTACT_SUBMISSION=wss-internal-contact-submission
RESEND_TEMPLATE_WSS_INTERNAL_CUSTOMER_SIGNUP=wss-internal-customer-signup
RESEND_TEMPLATE_WSS_INTERNAL_CUSTOMER_REQUEST=wss-internal-customer-request
RESEND_TEMPLATE_WSS_INTERNAL_CUSTOMER_REPLY=wss-internal-customer-reply
RESEND_TEMPLATE_WSS_INTERNAL_PAYMENT_FAILED=wss-internal-payment-failed
RESEND_TEMPLATE_WSS_INTERNAL_SUBSCRIPTION_CANCELED=wss-internal-subscription-canceled
