# ---- Phase A: real browser auth client (feature-flagged, OFF by default) ----
# Real auth is OFF unless VITE_WSS_REAL_AUTH_ENABLED is exactly "true".
# Only the PUBLIC anon key belongs here. NEVER put the service-role key in a
# VITE_* variable — VITE_* values are shipped to the browser.
VITE_WSS_REAL_AUTH_ENABLED=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
