# Website Support Studio — marketing site environment
#
# Analytics is OPTIONAL and OFF unless these are set. Set them in the Vercel
# project's Environment Variables (Production), not in committed files.
# Astro only exposes variables prefixed with PUBLIC_ to the browser.

# Google Analytics 4 measurement ID (gtag.js). Example: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Tag Manager container ID. Example: GTM-XXXXXXX
PUBLIC_GTM_ID=
