# Website Support Studio — marketing site environment
#
# Analytics is OPTIONAL and OFF unless these are set. Set them in the Vercel
# project's Environment Variables (Production), not in committed files.
# Astro only exposes variables prefixed with PUBLIC_ to the browser.

# Google Analytics 4 measurement ID (gtag.js). Defaults in code to G-BQJ2J9K94D.
# Set this only to override the production WSS property.
PUBLIC_GA4_ID=

# Google Tag Manager container ID. Example: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Stripe checkout (Stage A): the create-checkout-session Edge Function URL. When unset, the
# pricing "join now" buttons fall back to /contact. Not a secret (public function endpoint).
# Example: https://<project-ref>.supabase.co/functions/v1/create-checkout-session
PUBLIC_WSS_CHECKOUT_URL=

# Contact notification Edge Function URL. Not a secret. Production defaults to
# the WSS Supabase contact-notification endpoint; set this to override per env.
# If the endpoint cannot confirm delivery, the form shows an explicit failure.
# Example: https://<project-ref>.supabase.co/functions/v1/contact-notification
PUBLIC_WSS_CONTACT_NOTIFY_URL=

# Free website preview request Edge Function URL. The form on /free-website-preview
# posts here so the function can save a structured row and email Gary.
# Example: https://<project-ref>.supabase.co/functions/v1/website-preview-request
PUBLIC_WSS_WEBSITE_PREVIEW_REQUEST_URL=

# Website Health Score server-side audit. Optional; PageSpeed works without a
# key at low volume, but a key gives steadier quota for batch outreach runs.
PAGESPEED_API_KEY=

# Website Health Score lead capture webhook for Apollo/Zapier/Make. If unset,
# /api/website-health-lead falls back to the existing WSS preview request
# endpoint so captured leads are not dropped.
WSS_WEBSITE_SCORE_WEBHOOK_URL=

# Google Places API key for Website Health Score findability checks. Server-side
# only. Used to check Google Business Profile / Maps presence, reviews, and rating.
PLACES_API_KEY=
