{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/templates", "destination": "/website-gallery", "permanent": true },
    { "source": "/templates/", "destination": "/website-gallery", "permanent": true },
    { "source": "/gallery", "destination": "/website-gallery", "permanent": true },
    { "source": "/gallery/", "destination": "/website-gallery", "permanent": true },
    { "source": "/gallery/preview/:path*", "destination": "/website-gallery", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
