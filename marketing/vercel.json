{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/templates/luna", "destination": "/templates", "statusCode": 301 },
    { "source": "/templates/ridgeline-roofing", "destination": "/templates/sample/ridgeline-roofing", "statusCode": 301 },
    { "source": "/templates/ridgeline-roofing/services", "destination": "/templates/sample/ridgeline-roofing/services", "statusCode": 301 },
    { "source": "/templates/ridgeline-roofing/about", "destination": "/templates/sample/ridgeline-roofing/about", "statusCode": 301 },
    { "source": "/templates/ridgeline-roofing/contact", "destination": "/templates/sample/ridgeline-roofing/contact", "statusCode": 301 },
    { "source": "/templates/ridgeline-roofing/service-area", "destination": "/templates/sample/ridgeline-roofing/service-area", "statusCode": 301 },
    { "source": "/articles/concrete-contractor-website-design-seo-aio-geo", "destination": "/articles/concrete-contractor-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/electrician-website-design-seo-aio-geo", "destination": "/articles/electrician-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/garage-door-website-design-seo-aio-geo", "destination": "/articles/garage-door-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/hvac-website-design-seo-aio-geo", "destination": "/articles/hvac-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/irrigation-sprinkler-website-design-seo-aio-geo", "destination": "/articles/irrigation-sprinkler-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/landscaping-website-design-seo-aio-geo", "destination": "/articles/landscaping-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/pest-control-website-design-seo-aio-geo", "destination": "/articles/pest-control-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/plumber-website-design-seo-aio-geo", "destination": "/articles/plumber-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/pool-company-website-design-seo-aio-geo", "destination": "/articles/pool-company-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/pressure-washing-website-design-seo-aio-geo", "destination": "/articles/pressure-washing-website-design-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/roofing-website-templates-seo-aio-geo", "destination": "/articles/roofing-website-templates-seo-aeo-geo", "statusCode": 301 },
    { "source": "/articles/tree-service-website-design-seo-aio-geo", "destination": "/articles/tree-service-website-design-seo-aeo-geo", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
