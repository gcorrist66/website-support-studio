---
/**
 * GA4 analytics. Defaults to the production WSS measurement ID, with env override
 * support for non-production or future property changes.
 *
 *   PUBLIC_GA4_ID   e.g. "G-XXXXXXXXXX"  → Google Analytics 4 (gtag.js)
 *   PUBLIC_GTM_ID   e.g. "GTM-XXXXXXX"   → Google Tag Manager container
 *
 * Set these in the Vercel project's Environment Variables (Production). Astro
 * only exposes variables prefixed with PUBLIC_ to the client, by design.
 *
 * The matching <noscript> for GTM is emitted in BaseLayout, immediately after
 * <body>, per Google's installation guidance.
 */
const gaId = import.meta.env.PUBLIC_GA4_ID || "G-BQJ2J9K94D";
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

{
  gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = window.gtag || gtag;
        window.wssTrack = function (eventName, params) {
          if (!eventName || typeof window.gtag !== "function") return;
          window.gtag("event", eventName, params || {});
        };
        gtag("js", new Date());
        gtag("config", gaId, { anonymize_ip: true });
        document.addEventListener("click", function (event) {
          var target = event.target && event.target.closest ? event.target.closest("[data-ga-event]") : null;
          if (!target || typeof window.wssTrack !== "function") return;
          var eventName = target.getAttribute("data-ga-event");
          var secondaryEventName = target.getAttribute("data-ga-secondary-event");
          var label = target.getAttribute("data-ga-label") || target.textContent || "";
          var href = target.getAttribute("href") || "";
          window.wssTrack(eventName, { event_label: label.trim(), link_url: href });
          if (secondaryEventName) {
            window.wssTrack(secondaryEventName, { event_label: label.trim(), link_url: href });
          }
        });
      </script>
    </>
  )
}

{
  gtmId && (
    <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", gtmId);
    </script>
  )
}
