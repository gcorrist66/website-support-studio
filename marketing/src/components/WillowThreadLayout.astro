---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdaptableStyleProof from "./AdaptableStyleProof.astro";
import { willow, willowNav } from "../willowThread";

const { title, description, path } = Astro.props as { title: string; description: string; path: string };
const lunaPalettes = [
  { label: "Salon palette", colors: ["#2f211c", "#bf6f5e", "#fff8ef"] },
  { label: "Coffee palette", colors: ["#21150f", "#b8783f", "#f6efe2"] },
  { label: "Boutique palette", colors: ["#261b21", "#8f5b74", "#fbf5ed"] },
];
---

<BaseLayout title={title} description={description} path={path}>
  <div class="wt-site">
    <header class="wt-header">
      <a class="wt-logo" href="/templates/luna/boutique" aria-label="Willow Thread home"><span>Willow</span><small>Thread</small></a>
      <nav class="wt-nav" aria-label="Willow Thread navigation">
        {willowNav.map((item) => <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <a class="wt-visit" href="/templates/luna/boutique/visit">Plan Your Visit</a>
    </header>
    <section class="wt-conversion-strip" aria-label="Founder Website Package actions">
      <p>Like this boutique website?</p>
      <div>
        <a href={willow.checkoutHref} data-ga-event="click_willow_strip_build" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
        <a href={willow.checkoutHref} data-ga-event="click_willow_strip_luna" data-ga-secondary-event="stripe_payment_link_click">Start With Luna</a>
        <a href={willow.checkoutHref} data-ga-event="click_willow_strip_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a>
      </div>
    </section>
    <slot />
    <AdaptableStyleProof systemName="Luna" examples={lunaPalettes} />
    <section class="wt-founder-cta">
      <div>
        <p class="wt-eyebrow">Founder Website Package</p>
        <h2>Want a website like Willow Thread?</h2>
        <p>This sample business shows the style and completeness your $500 Founder Website can start from. We customize the words, photos, collections, services, and local details for your business.</p>
      </div>
      <div class="wt-actions">
        <a class="wt-btn wt-btn-primary" href={willow.checkoutHref} data-ga-event="click_willow_build_my_website" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
        <a class="wt-btn wt-btn-secondary" href={willow.checkoutHref} data-ga-event="click_willow_start_luna" data-ga-secondary-event="stripe_payment_link_click">Start With Luna</a>
        <a class="wt-btn wt-btn-quiet" href={willow.checkoutHref} data-ga-event="click_willow_use_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a>
      </div>
    </section>
    <footer class="wt-footer">
      <div><strong>{willow.name}</strong><p>{willow.location}</p><p>{willow.badge} · Fictional example. Not a real boutique.</p></div>
      <div><p>{willow.address}</p><p><a href={willow.phoneHref}>{willow.phoneLabel}</a></p></div>
    </footer>
    <div class="wt-sticky"><a href={willow.checkoutHref} data-ga-event="click_willow_mobile_sticky" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a></div>
  </div>

  <style is:inline>
    body[data-page^="/templates/luna/boutique"] .site-header,
    body[data-page^="/templates/luna/boutique"] .site-footer,
    body[data-page^="/templates/luna/boutique"] .skip-link { display:none; }
    body[data-page^="/templates/luna/boutique"] { background:#fbf5ed; }
    .wt-site { --wt-ink:#261b21; --wt-muted:#77606c; --wt-cream:#fbf5ed; --wt-petal:#f3e3df; --wt-moss:#7b7156; --wt-berry:#8f5b74; --wt-card:rgba(255,250,245,.78); min-height:100vh; color:var(--wt-ink); background:radial-gradient(circle at 10% 10%,rgba(143,91,116,.16),transparent 30rem),linear-gradient(180deg,#fffaf5,#f3e7df 58%,#fbf5ed); font-family:Georgia,"Times New Roman",serif; }
    .wt-site h1,.wt-site h2,.wt-site h3 { color:var(--wt-ink); font-family:Georgia,"Times New Roman",serif; letter-spacing:-.052em; }
    .wt-site p,.wt-site li { color:var(--wt-muted); }
    .wt-header { position:sticky; top:0; z-index:70; display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem clamp(1rem,4vw,3rem); border-bottom:1px solid rgba(38,27,33,.14); background:rgba(251,245,237,.9); backdrop-filter:blur(14px); }
    .wt-logo { display:grid; color:var(--wt-ink); line-height:.9; font-size:1.45rem; font-weight:900; }
    .wt-logo small { color:var(--wt-berry); font-size:.78rem; letter-spacing:.18em; text-transform:uppercase; }
    .wt-nav { display:flex; gap:1rem; align-items:center; flex-wrap:wrap; font-family:var(--font-mono); font-size:.82rem; }
    .wt-nav a,.wt-footer a { color:var(--wt-ink); }
    .wt-nav a[aria-current="page"] { color:var(--wt-berry); font-weight:900; }
    .wt-visit,.wt-btn,.wt-sticky a { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; padding:.85rem 1.1rem; border:1px solid var(--wt-berry); font-family:var(--font-mono); font-weight:900; font-size:.86rem; text-decoration:none; }
    .wt-visit,.wt-btn-primary,.wt-sticky a { background:var(--wt-ink); color:#fff; border-color:var(--wt-ink); }
    .wt-btn-secondary { background:#fffaf5; color:var(--wt-ink); }
    .wt-btn-quiet { color:var(--wt-ink); background:transparent; }
    .wt-conversion-strip { display:flex; align-items:center; justify-content:center; gap:1rem; flex-wrap:wrap; padding:.75rem 1rem; background:linear-gradient(90deg,var(--wt-ink),var(--wt-berry)); color:var(--wt-cream); }
    .wt-conversion-strip p { margin:0; color:var(--wt-cream); font-family:var(--font-mono); font-size:.78rem; font-weight:900; letter-spacing:.06em; text-transform:uppercase; }
    .wt-conversion-strip div { display:flex; gap:.55rem; flex-wrap:wrap; justify-content:center; }
    .wt-conversion-strip a { display:inline-flex; align-items:center; justify-content:center; min-height:2.15rem; padding:0 .85rem; border-radius:999px; background:var(--wt-moss); color:#fff; font-family:var(--font-mono); font-size:.74rem; font-weight:950; text-decoration:none; text-transform:uppercase; letter-spacing:.04em; }
    .wt-section { padding:clamp(3.5rem,8vw,6rem) clamp(1rem,4vw,3rem); }
    .wt-container { max-width:1120px; margin:0 auto; }
    .wt-eyebrow,.wt-sample { display:inline-flex; width:fit-content; border-radius:999px; font-family:var(--font-mono); font-size:.76rem; font-weight:900; letter-spacing:.04em; text-transform:uppercase; }
    .wt-eyebrow { color:var(--wt-berry); }
    .wt-sample { padding:.32rem .65rem; border:1px dashed rgba(143,91,116,.55); color:var(--wt-muted); background:rgba(255,250,245,.72); }
    .wt-hero-grid,.wt-split { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.9fr); gap:clamp(1.4rem,5vw,3.5rem); align-items:center; }
    .wt-hero h1 { max-width:11ch; margin:.8rem 0 0; font-size:clamp(3.1rem,11vw,7.2rem); line-height:.88; }
    .wt-lede { max-width:58ch; font-size:1.12rem; line-height:1.75; }
    .wt-actions { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:1.25rem; }
    .wt-photo-card { position:relative; min-height:480px; overflow:hidden; border-radius:2rem; border:1px solid rgba(38,27,33,.14); box-shadow:0 34px 90px rgba(38,27,33,.16); background:#ead8d0; }
    .wt-photo-card img,.wt-image { display:block; width:100%; height:100%; object-fit:cover; }
    .wt-caption { position:absolute; left:1rem; right:1rem; bottom:1rem; border-radius:999px; padding:.55rem .8rem; color:#fff; background:rgba(38,27,33,.78); font-family:var(--font-mono); font-size:.78rem; font-weight:800; }
    .wt-card-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1.4rem; }
    .wt-card { border:1px solid rgba(38,27,33,.14); border-radius:1.4rem; padding:1.25rem; background:var(--wt-card); box-shadow:0 18px 50px rgba(38,27,33,.07); }
    .wt-card h3 { margin:0; font-size:1.35rem; }
    .wt-price { margin:.7rem 0 0; color:var(--wt-berry) !important; font-family:var(--font-mono); font-weight:900; font-size:.9rem; }
    .wt-soft { background:rgba(243,227,223,.62); }
    .wt-gallery-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.9rem; margin-top:1.4rem; }
    .wt-gallery-tile { min-height:220px; display:flex; align-items:end; border-radius:1.6rem; padding:1rem; color:#fff; font-weight:900; background:linear-gradient(180deg,transparent,rgba(38,27,33,.78)),radial-gradient(circle at 18% 10%,#cda3a4,var(--wt-berry)); }
    .wt-info-list { display:grid; gap:.7rem; padding:0; margin:1rem 0 0; list-style:none; }
    .wt-info-list li { padding:.8rem; border-radius:1rem; background:rgba(255,250,245,.78); border:1px solid rgba(38,27,33,.12); }
    .wt-form { display:grid; gap:.85rem; }
    .wt-form label { display:grid; gap:.4rem; color:var(--wt-ink); font-family:var(--font-mono); font-weight:800; font-size:.82rem; }
    .wt-form input,.wt-form select,.wt-form textarea { width:100%; border:1px solid rgba(38,27,33,.2); border-radius:1rem; padding:.8rem; background:#fffaf5; font:inherit; }
    .wt-form textarea { min-height:120px; resize:vertical; }
    .wt-founder-cta { display:flex; align-items:center; justify-content:space-between; gap:1.25rem; margin:0 clamp(1rem,4vw,3rem) 2rem; padding:clamp(1.25rem,4vw,2rem); border-radius:2rem; background:linear-gradient(135deg,var(--wt-ink),var(--wt-berry)); color:#fff; border:4px solid var(--wt-moss); box-shadow:0 26px 70px rgba(38,27,33,.2); }
    .wt-founder-cta h2,.wt-founder-cta p { color:#fff; }
    .wt-footer { display:flex; justify-content:space-between; gap:1rem; padding:2rem clamp(1rem,4vw,3rem) 6rem; border-top:1px solid rgba(38,27,33,.14); }
    .wt-sticky { display:none; }
    @media (max-width:900px) { .wt-header{align-items:start}.wt-nav,.wt-visit{display:none}.wt-hero-grid,.wt-split,.wt-card-grid,.wt-gallery-grid,.wt-founder-cta,.wt-footer{grid-template-columns:1fr;display:grid}.wt-photo-card{min-height:330px}.wt-hero h1{max-width:100%}.wt-section{padding-left:1rem;padding-right:1rem}.wt-sticky{position:fixed;z-index:90;left:.75rem;right:.75rem;bottom:.75rem;display:block;padding:.35rem;border-radius:999px;background:rgba(255,250,245,.92);border:1px solid rgba(143,91,116,.28);box-shadow:0 16px 44px rgba(38,27,33,.2);backdrop-filter:blur(12px)}.wt-sticky a{width:100%} }
  </style>
</BaseLayout>
