---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdaptableStyleProof from "./AdaptableStyleProof.astro";
import { moonroom, moonroomNav } from "../moonroomCoffee";

const { title, description, path } = Astro.props as { title: string; description: string; path: string };
const lunaPalettes = [
  { label: "Salon palette", colors: ["#2f211c", "#bf6f5e", "#fff8ef"] },
  { label: "Coffee palette", colors: ["#21150f", "#b8783f", "#f6efe2"] },
  { label: "Boutique palette", colors: ["#261b21", "#8f5b74", "#fbf5ed"] },
];
---

<BaseLayout title={title} description={description} path={path} hideChrome>
  <div class="mc-site">
    <header class="mc-header">
      <a class="mc-logo" href="/" aria-label="Back to Website Support Studio homepage"><span>Moonroom</span><small>Coffee</small></a>
      <nav class="mc-nav" aria-label="Moonroom Coffee navigation">
        {moonroomNav.map((item) => <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <div class="mc-header-actions"><a class="mc-login" href="/templates/sample/back-office" data-ga-event="click_moonroom_back_office">Preview Back Office</a><a class="mc-visit" href="/templates/luna/coffee-shop/contact#visit">Plan Your Visit</a></div>
      <button class="mc-menu-toggle" type="button" aria-expanded="false" aria-controls="mc-mobile-drawer" aria-label="Open menu"><span></span><span></span><span></span></button>
    </header>
    <div class="mc-drawer" id="mc-mobile-drawer" hidden>
      <nav class="mc-drawer-nav" aria-label="Moonroom Coffee mobile navigation">
        {moonroomNav.map((item) => <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <div class="mc-drawer-actions">
        <a class="mc-login" href="/templates/sample/back-office" data-ga-event="click_moonroom_drawer_back_office">Preview Back Office</a>
        <a class="mc-visit" href="/templates/luna/coffee-shop/contact#visit" data-ga-event="click_moonroom_drawer_visit">Plan Your Visit</a>
      </div>
    </div>
    <section class="mc-conversion-strip" aria-label="Founder Website Package actions">
      <p>Like this coffee shop website?</p>
      <div>
        <a href={moonroom.checkoutHref} data-ga-event="click_moonroom_strip_build" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
        <a href={moonroom.checkoutHref} data-ga-event="click_moonroom_strip_luna" data-ga-secondary-event="stripe_payment_link_click">Start With Luna</a>
        <a href={moonroom.checkoutHref} data-ga-event="click_moonroom_strip_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a><a href="/templates/sample/back-office" data-ga-event="click_moonroom_strip_back_office">Preview Back Office</a>
      </div>
    </section>
    <slot />
    <AdaptableStyleProof systemName="Luna" examples={lunaPalettes} />
    <section class="mc-founder-cta">
      <div>
        <p class="mc-eyebrow">Founder Website Package</p>
        <h2>Want a website like Moonroom Coffee?</h2>
        <p>This sample business shows the style and completeness your $500 Founder Website can start from. We customize the words, photos, menu, services, and local details for your business.</p>
      </div>
      <div class="mc-actions">
        <a class="mc-btn mc-btn-primary" href={moonroom.checkoutHref} data-ga-event="click_moonroom_build_my_website" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
        <a class="mc-btn mc-btn-secondary" href={moonroom.checkoutHref} data-ga-event="click_moonroom_start_luna" data-ga-secondary-event="stripe_payment_link_click">Start With Luna</a>
        <a class="mc-btn mc-btn-quiet" href={moonroom.checkoutHref} data-ga-event="click_moonroom_use_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a>
      </div>
    </section>
    <footer class="mc-footer">
      <div><strong>{moonroom.name}</strong><p>{moonroom.location}</p><p>{moonroom.badge} · Fictional example. Not a real coffee shop.</p></div>
      <div><p>{moonroom.address}</p><p><a href={moonroom.phoneHref}>{moonroom.phoneLabel}</a></p></div>
    </footer>
    <div class="mc-sticky"><a class="mc-sticky-biz" href="/templates/luna/coffee-shop/contact#visit" data-ga-event="click_moonroom_mobile_sticky_visit">Plan Your Visit</a><a class="mc-sticky-build" href={moonroom.checkoutHref} data-ga-event="click_moonroom_mobile_sticky" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a></div>
  </div>

  <script is:inline>
    (function () {
      var toggle = document.querySelector(".mc-menu-toggle");
      var drawer = document.getElementById("mc-mobile-drawer");
      if (!toggle || !drawer) return;
      function open() { drawer.hidden = false; drawer.classList.add("is-open"); toggle.setAttribute("aria-expanded", "true"); toggle.setAttribute("aria-label", "Close menu"); }
      function close() { drawer.classList.remove("is-open"); drawer.hidden = true; toggle.setAttribute("aria-expanded", "false"); toggle.setAttribute("aria-label", "Open menu"); }
      toggle.addEventListener("click", function () { toggle.getAttribute("aria-expanded") === "true" ? close() : open(); });
      drawer.addEventListener("click", function (e) { if (e.target.closest("a")) close(); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { close(); toggle.focus(); } });
    })();
  </script>

  <style is:inline>
    body[data-page^="/templates/luna/coffee-shop"] .site-header,
    body[data-page^="/templates/luna/coffee-shop"] .site-footer,
    body[data-page^="/templates/luna/coffee-shop"] .skip-link { display: none; }
    body[data-page^="/templates/luna/coffee-shop"] { background:#f6efe2; }
    .mc-site { --mc-ink:#21150f; --mc-muted:#755f50; --mc-cream:#f6efe2; --mc-foam:#fffaf1; --mc-caramel:#b8783f; --mc-espresso:#3a2418; --mc-card:rgba(255,250,241,.78); min-height:100vh; color:var(--mc-ink); background:radial-gradient(circle at 85% 5%,rgba(184,120,63,.18),transparent 28rem),linear-gradient(180deg,#fffaf1,#f1e0ce 58%,#f7efe4); font-family:Georgia,"Times New Roman",serif; }
    .mc-site h1,.mc-site h2,.mc-site h3 { color:var(--mc-ink); font-family:Georgia,"Times New Roman",serif; letter-spacing:-.052em; }
    .mc-site p,.mc-site li { color:var(--mc-muted); }
    .mc-header { position:sticky; top:0; z-index:70; display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem clamp(1rem,4vw,3rem); border-bottom:1px solid rgba(58,36,24,.15); background:rgba(246,239,226,.9); backdrop-filter:blur(14px); }
    .mc-logo { display:grid; color:var(--mc-ink); line-height:.9; font-size:1.45rem; font-weight:900; }
    .mc-logo small { color:var(--mc-caramel); font-size:.78rem; letter-spacing:.18em; text-transform:uppercase; }
    .mc-nav { display:flex; gap:1rem; align-items:center; flex-wrap:wrap; font-family:var(--font-mono); font-size:.82rem; }
    .mc-nav a,.mc-footer a { color:var(--mc-ink); }
    .mc-nav a[aria-current="page"] { color:var(--mc-caramel); font-weight:900; }
    .mc-visit,.mc-login,.mc-btn,.mc-sticky a { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; padding:.85rem 1.1rem; border:1px solid var(--mc-caramel); font-family:var(--font-mono); font-weight:900; font-size:.86rem; text-decoration:none; }
    .mc-visit,.mc-btn-primary,.mc-sticky a { background:var(--mc-espresso); color:#fff; border-color:var(--mc-espresso); }
    .mc-login { background:#fffaf1; color:var(--mc-ink); border-color:rgba(58,36,24,.18); }
    .mc-header-actions { display:flex; align-items:center; gap:.55rem; }
    .mc-menu-toggle { display:none; flex-direction:column; justify-content:center; gap:5px; width:44px; height:44px; padding:0 10px; border:1px solid rgba(58,36,24,.18); border-radius:12px; background:#fffaf1; cursor:pointer; }
    .mc-menu-toggle span { display:block; height:2px; width:100%; background:var(--mc-ink); border-radius:2px; transition:transform .2s ease,opacity .2s ease; }
    .mc-menu-toggle[aria-expanded="true"] span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .mc-menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity:0; }
    .mc-menu-toggle[aria-expanded="true"] span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
    .mc-drawer { display:none; }
    .mc-drawer[hidden] { display:none; }
    .mc-drawer-nav { display:grid; gap:.2rem; }
    .mc-drawer-nav a { padding:.85rem .6rem; border-radius:.9rem; color:var(--mc-ink); font-family:var(--font-mono); font-weight:800; font-size:.95rem; text-decoration:none; }
    .mc-drawer-nav a[aria-current="page"] { color:var(--mc-caramel); background:rgba(184,120,63,.1); }
    .mc-drawer-actions { display:grid; gap:.55rem; margin-top:.9rem; padding-top:.9rem; border-top:1px solid rgba(58,36,24,.15); }
    .mc-drawer-actions a { width:100%; }
    .mc-btn-secondary { background:#fffaf1; color:var(--mc-ink); }
    .mc-btn-quiet { color:var(--mc-ink); background:transparent; }
    .mc-conversion-strip { display:flex; align-items:center; justify-content:center; gap:1rem; flex-wrap:wrap; padding:.75rem 1rem; background:linear-gradient(90deg,var(--mc-ink),var(--mc-espresso)); color:var(--mc-cream); }
    .mc-conversion-strip p { margin:0; color:var(--mc-cream); font-family:var(--font-mono); font-size:.78rem; font-weight:900; letter-spacing:.06em; text-transform:uppercase; }
    .mc-conversion-strip div { display:flex; gap:.55rem; flex-wrap:wrap; justify-content:center; }
    .mc-conversion-strip a { display:inline-flex; align-items:center; justify-content:center; min-height:2.15rem; padding:0 .85rem; border-radius:999px; background:var(--mc-foam); color:var(--mc-ink); border:2px solid var(--mc-caramel); font-family:var(--font-mono); font-size:.74rem; font-weight:950; text-decoration:none; text-transform:uppercase; letter-spacing:.04em; box-shadow:0 10px 26px rgba(33,21,15,.18); }
    .mc-section { padding:clamp(3.5rem,8vw,6rem) clamp(1rem,4vw,3rem); }
    .mc-container { max-width:1120px; margin:0 auto; }
    .mc-eyebrow,.mc-sample { display:inline-flex; width:fit-content; border-radius:999px; font-family:var(--font-mono); font-size:.76rem; font-weight:900; letter-spacing:.04em; text-transform:uppercase; }
    .mc-eyebrow { color:var(--mc-caramel); }
    .mc-sample { padding:.32rem .65rem; border:1px dashed rgba(184,120,63,.55); color:var(--mc-muted); background:rgba(255,250,241,.72); }
    .mc-hero-grid,.mc-split { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.9fr); gap:clamp(1.4rem,5vw,3.5rem); align-items:center; }
    .mc-hero h1 { max-width:11ch; margin:.8rem 0 0; font-size:clamp(2.35rem,9.2vw,5.4rem); line-height:.9; }
    .mc-lede { max-width:58ch; font-size:1.12rem; line-height:1.75; }
    .mc-actions { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:1.25rem; }
    .mc-photo-card { position:relative; min-height:360px; overflow:hidden; border-radius:2rem; border:1px solid rgba(58,36,24,.16); box-shadow:0 34px 90px rgba(33,21,15,.18); background:#dbc4a8; }
    .mc-photo-card img,.mc-image { display:block; width:100%; height:100%; object-fit:cover; }
    .mc-caption { position:absolute; left:1rem; right:1rem; bottom:1rem; border-radius:999px; padding:.55rem .8rem; color:#fff; background:rgba(33,21,15,.78); font-family:var(--font-mono); font-size:.78rem; font-weight:800; }
    .mc-card-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1.4rem; }
    .mc-card { border:1px solid rgba(58,36,24,.16); border-radius:1.4rem; padding:1.25rem; background:var(--mc-card); box-shadow:0 18px 50px rgba(33,21,15,.08); }
    .mc-card h3 { margin:0; font-size:1.35rem; }
    .mc-price { margin:.7rem 0 0; color:var(--mc-caramel) !important; font-family:var(--font-mono); font-weight:900; font-size:.9rem; }
    .mc-soft { background:rgba(219,196,168,.42); }
    .mc-gallery-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.9rem; margin-top:1.4rem; }
    .mc-gallery-tile { position:relative; margin:0; min-height:220px; overflow:hidden; border-radius:1.6rem; border:1px solid rgba(58,36,24,.16); box-shadow:0 18px 50px rgba(33,21,15,.1); background:#dbc4a8; }
    .mc-gallery-tile img { display:block; width:100%; height:100%; min-height:220px; object-fit:cover; }
    .mc-gallery-tile .mc-caption { margin:0; }
    .mc-info-list { display:grid; gap:.7rem; padding:0; margin:1rem 0 0; list-style:none; }
    .mc-info-list li { padding:.8rem; border-radius:1rem; background:rgba(255,250,241,.78); border:1px solid rgba(58,36,24,.12); }
    .mc-form { display:grid; gap:.85rem; }
    .mc-form label { display:grid; gap:.4rem; color:var(--mc-ink); font-family:var(--font-mono); font-weight:800; font-size:.82rem; }
    .mc-form input,.mc-form select,.mc-form textarea { width:100%; border:1px solid rgba(58,36,24,.2); border-radius:1rem; padding:.8rem; background:#fffaf1; font:inherit; }
    .mc-form textarea { min-height:120px; resize:vertical; }
    .mc-location-map { position:relative; height:172px; margin-top:1rem; border-radius:1.3rem; padding:0.7rem; border:1px solid rgba(58,36,24,.24); background:radial-gradient(circle at 24% 18%, #fffaf1, #dbc4a8); overflow:hidden; }
    .mc-location-pin { position:absolute; transform:translate(-50%,-85%); background:var(--mc-espresso); color:#fff; border-radius:999px; font-size:.7rem; font-weight:900; font-family:var(--font-mono); padding:.16rem .42rem; box-shadow:0 8px 22px rgba(33,21,15,.2); }
    .mc-location-label { display:inline-flex; background:var(--mc-ink); color:#fff; border-radius:999px; padding:.33rem .62rem; font-size:.74rem; font-family:var(--font-mono); font-weight:900; }
    .mc-location-chipset { display:flex; flex-wrap:wrap; gap:.55rem; margin-top:.8rem; }
    .mc-location-chipset span { padding:.26rem .66rem; border-radius:999px; border:1px solid rgba(58,36,24,.2); background:rgba(255,250,241,.82); font-family:var(--font-mono); font-size:.78rem; font-weight:900; }
    .mc-founder-cta { display:flex; align-items:center; justify-content:space-between; gap:1.25rem; margin:0 clamp(1rem,4vw,3rem) 2rem; padding:clamp(1.25rem,4vw,2rem); border-radius:2rem; background:linear-gradient(135deg,var(--mc-ink),var(--mc-espresso)); color:#fff; border:4px solid var(--mc-caramel); box-shadow:0 26px 70px rgba(33,21,15,.2); }
    .mc-founder-cta h2,.mc-founder-cta p { color:#fff; }
    .mc-founder-cta .mc-btn-primary { background:var(--mc-foam); color:var(--mc-ink); border-color:var(--mc-foam); box-shadow:0 14px 34px rgba(33,21,15,.24); }
    .mc-founder-cta .mc-btn-secondary,.mc-founder-cta .mc-btn-quiet { background:transparent; color:var(--mc-cream); border-color:rgba(246,239,226,.78); }
    .mc-footer { display:flex; justify-content:space-between; gap:1rem; padding:2rem clamp(1rem,4vw,3rem) 6rem; border-top:1px solid rgba(58,36,24,.15); }
    .mc-sticky { display:none; }
    @media (max-width:900px) { .mc-header{align-items:center}.mc-nav,.mc-header-actions{display:none}.mc-menu-toggle{display:flex}.mc-drawer{display:none;position:sticky;top:0;z-index:69;padding:1rem clamp(1rem,4vw,3rem) 1.25rem;background:rgba(246,239,226,.97);border-bottom:1px solid rgba(58,36,24,.15);backdrop-filter:blur(14px)}.mc-drawer.is-open{display:block}.mc-drawer[hidden]{display:none}.mc-hero-grid,.mc-split,.mc-card-grid,.mc-gallery-grid,.mc-founder-cta,.mc-footer{grid-template-columns:1fr;display:grid}.mc-photo-card{min-height:280px}.mc-location-map{height:152px}.mc-hero h1{max-width:100%;font-size:clamp(1.95rem,8vw,3.1rem)}.mc-section{padding-left:1rem;padding-right:1rem}.mc-sticky{position:fixed;z-index:90;left:.75rem;right:.75rem;bottom:.75rem;display:flex;gap:.4rem;padding:.35rem;border-radius:999px;background:rgba(255,250,241,.92);border:1px solid rgba(184,120,63,.28);box-shadow:0 16px 44px rgba(33,21,15,.2);backdrop-filter:blur(12px)}.mc-sticky a{flex:1;min-width:0;padding:.7rem .4rem;font-size:.78rem;white-space:nowrap}.mc-sticky-biz{background:#fffaf1;color:var(--mc-ink);border-color:rgba(58,36,24,.18)} }
  </style>
</BaseLayout>
