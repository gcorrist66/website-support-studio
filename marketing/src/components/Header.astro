---
import LogoLockup from "./LogoLockup.astro";
import Label from "./Label.astro";
import { NAV, APP_URL, JOIN_PATH } from "../consts";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container bar">
    <a href="/" aria-label="Website Support Studio — home">
      <LogoLockup size={28} />
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
            <Label text={`_${item.label}`} />
          </a>
        ))
      }
      <a class="btn btn-ghost" href={APP_URL}><Label text="_login" /></a>
      <a class="btn btn-green btn-cta" href={JOIN_PATH}><Label text="_join_now" /></a>
    </nav>
  </div>
</header>
