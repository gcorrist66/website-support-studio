---
import LogoLockup from "./LogoLockup.astro";
import { NAV, APP_URL, JOIN_PATH } from "../consts";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container bar">
    <a href="/" aria-label="Website Support Studio — home">
      <LogoLockup size={28} />
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-ghost" href={APP_URL}>Login</a>
      <a class="btn btn-primary btn-cta" href={JOIN_PATH}>Join Now</a>
    </nav>
  </div>
</header>
