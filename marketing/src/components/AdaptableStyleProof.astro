---
type PaletteExample = {
  label: string;
  colors: string[];
};

interface Props {
  systemName: string;
  examples: PaletteExample[];
}

const { systemName, examples } = Astro.props as Props;

const adaptableItems = ["Your colors", "Your logo", "Your photos", "Your services", "Your city"];
---

<section class="style-proof" aria-label={`${systemName} customization examples`}>
  <div>
    <p class="style-proof-eyebrow">Customizable style</p>
    <h2>{systemName} is not locked to these colors.</h2>
    <p>
      The layout, spacing, and conversion flow stay consistent. Your brand colors, logo, photos,
      services, and city change so the website feels like your business.
    </p>
    <ul>
      {adaptableItems.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="style-proof-palettes">
    {examples.map((example) => (
      <article>
        <strong>{example.label}</strong>
        <div>
          {example.colors.map((color) => <span style={`--swatch:${color};`} />)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .style-proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.85fr);
    gap: clamp(1rem, 4vw, 2rem);
    align-items: center;
    margin: 0 clamp(1rem, 4vw, 3rem) 1.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.82), transparent 16rem),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 18px 54px rgba(15, 23, 42, 0.08);
  }

  .style-proof h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.55rem);
    line-height: 1;
  }

  .style-proof p {
    max-width: 64ch;
    margin: 0.8rem 0 0;
  }

  .style-proof-eyebrow {
    display: inline-flex;
    margin: 0;
    font-size: 0.76rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .style-proof ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .style-proof li {
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(15, 23, 42, 0.1);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .style-proof-palettes {
    display: grid;
    gap: 0.75rem;
  }

  .style-proof-palettes article {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem;
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(15, 23, 42, 0.1);
  }

  .style-proof-palettes strong {
    font-size: 0.85rem;
  }

  .style-proof-palettes div {
    display: flex;
    gap: 0.4rem;
  }

  .style-proof-palettes span {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--swatch);
    border: 2px solid rgba(255, 255, 255, 0.78);
    box-shadow: 0 7px 18px rgba(15, 23, 42, 0.16);
  }

  @media (max-width: 820px) {
    .style-proof {
      grid-template-columns: 1fr;
      margin-bottom: 1rem;
    }

    .style-proof-palettes article {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
