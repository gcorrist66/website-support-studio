---
/**
 * Emits a JSON-LD <script> block. `schema` may be a single node or an array of
 * nodes (rendered as a graph-less list of script tags is avoided — we emit one
 * script per call). Pass an array to combine multiple types on one page.
 */
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}
const { schema } = Astro.props;
const json = JSON.stringify(schema);
---

<script type="application/ld+json" set:html={json} is:inline />
