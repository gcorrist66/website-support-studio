---
import { siteConfig, type SiteConfig } from "../data/site";

type JsonLdType = "home" | "services" | "gallery" | "about" | "contact" | "default";
interface Props {
  path: string;
  title: string;
  description: string;
  siteConfigOverride?: Partial<SiteConfig>;
  type?: JsonLdType;
}

const {
  path,
  title,
  description,
  type = "default",
  siteConfigOverride
} = Astro.props as Props;
const resolvedSiteConfig: SiteConfig = { ...siteConfig, ...(siteConfigOverride ?? {}) };
const canonical = new URL(path, resolvedSiteConfig.siteUrl).href;

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: resolvedSiteConfig.siteName,
  url: canonical,
  description: resolvedSiteConfig.description,
  inLanguage: "en-US"
};

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${canonical}#business`,
  name: resolvedSiteConfig.legalName,
  url: canonical,
  description,
  knowsAbout: resolvedSiteConfig.category,
  address: {
    "@type": "PostalAddress",
    addressLocality: resolvedSiteConfig.city,
    addressRegion: resolvedSiteConfig.state,
    addressCountry: resolvedSiteConfig.country
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: resolvedSiteConfig.ratingValue,
    reviewCount: resolvedSiteConfig.reviewCount
  }
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: resolvedSiteConfig.siteUrl
    },
    path !== "/" && {
      "@type": "ListItem",
      position: 2,
    name: title.replace(/\s+—.*/u, ""),
      item: canonical
    }
  ].filter(Boolean)
};

const servicePage = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical,
  about: {
    "@type": "LocalBusiness",
    name: resolvedSiteConfig.legalName
  }
};

const schema = [
  website,
  localBusiness,
  ...(type === "home" ? [breadcrumbs] : []),
  type === "services" ? servicePage : null
].filter(Boolean);

const content = schema;
---
<script type="application/ld+json" set:html={JSON.stringify(content)} />
