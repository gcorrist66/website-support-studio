const testimonials = portalConfig.testimonials;
---

<BaseLayout
  title={`${business.name} Owner Portal Demo`}
  description={`Static sample owner portal for the fictitious ${business.name} website.`}
  path={portalPath}
  hideChrome
>
  <div class="portal">
    <aside class="wss-demo-cta" aria-label="Website Support Studio free preview offer">
      <p><strong>Website Support Studio demo.</strong> Want a site and portal like this for your {portalConfig.audience}?</p>
      <a href={freePreviewPath}>Get my free preview -></a>
    </aside>

    <div class="portal-shell">
      <aside class="sidebar" aria-label={`${business.name} owner portal navigation`}>
        <a class="brand" href={portalPath} aria-label={`${business.name} owner portal home`}>
          <span>{brandMark}</span>
          <strong>{business.name}</strong>
        </a>
        <p class="demo-marker">DEMO SAMPLE · FICTITIOUS OWNER PORTAL</p>
        <nav>
          <a href="#dashboard">Dashboard</a>
          <a href="#leads">Leads</a>
          <a href="#testimonials">Testimonials</a>
          <a href="#submit-ticket">Submit Ticket</a>
        </nav>
        <a class="back-link" href={demoPath}>{portalConfig.backLabel}</a>
      </aside>

      <main class="workspace">
        <header class="topline">
          <div>
            <p class="eyebrow">Owner portal</p>
            <h1>{business.name} dashboard</h1>
          </div>
          <a href={demoPath}>{portalConfig.backLabel}</a>
        </header>

        <section class="view" id="dashboard" aria-labelledby="dashboard-title">
          <div class="section-head">
            <p class="eyebrow">Dashboard</p>
            <h2 id="dashboard-title">Site status</h2>
          </div>

          <div class="status-panel">
            <div>
              <span class="live-pill"><span></span> Live</span>
              <h3>Hosted and SSL secure</h3>
              <p>Last updated Jun 19, 2026 · 99.98% sample uptime</p>
            </div>
            <p class="ownership">You own your domain, site, and content. Monthly plan optional — cancel anytime.</p>
          </div>

          <div class="stat-grid" aria-label="Sample portal metrics">
            {stats.map((stat) => (
              <article>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
                <small>{stat.note}</small>
              </article>
            ))}
          </div>
        </section>

        <section class="view" id="leads" aria-labelledby="leads-title">
          <div class="section-head">
            <p class="eyebrow">Leads</p>
            <h2 id="leads-title">Estimate requests</h2>
          </div>

          <div class="lead-table" role="table" aria-label="Sample estimate requests">
            <div class="lead-row lead-head" role="row">
              <span role="columnheader">Name</span>
              <span role="columnheader">Town</span>
              <span role="columnheader">{portalConfig.leadIssueHeader}</span>
              <span role="columnheader">Date</span>
              <span role="columnheader">Status</span>
            </div>
            {leads.map((lead) => (
              <div class="lead-row" role="row">
                <span role="cell">{lead.name}</span>
                <span role="cell">{lead.town}</span>
                <span role="cell">{lead.issue}</span>
                <span role="cell">{lead.date}</span>
                <span role="cell"><mark>{lead.status}</mark></span>
              </div>
            ))}
          </div>
        </section>

        <section class="view" id="testimonials" aria-labelledby="testimonials-title">
          <div class="section-head section-head-row">
            <div>
              <p class="eyebrow">Testimonials</p>
              <h2 id="testimonials-title">Sample customer reviews</h2>
            </div>
            <button type="button">Request more reviews</button>
          </div>

          <div class="review-list">
            {testimonials.map((review) => (
              <article>
                <p>"{review.text}"</p>
                <span>{review.name} · {review.town}</span>
              </article>
            ))}
          </div>
        </section>

        <section class="view" id="submit-ticket" aria-labelledby="ticket-title">
          <div class="section-head">
            <p class="eyebrow">Submit Ticket</p>
            <h2 id="ticket-title">Ask Website Support Studio for a change</h2>
          </div>

          <form class="ticket-form">
            <label>
              Subject
              <select name="subject">
                <option>Update hours</option>
                <option>Add a photo</option>
                <option>Change phone</option>
                <option>Other</option>
              </select>
            </label>
            <label>
              Message
              <textarea name="message" rows="5" placeholder="Tell us what should change on the site."></textarea>
            </label>
            <button type="button">Submit</button>
            <p>Demo only — no ticket is sent.</p>
          </form>
        </section>
      </main>
    </div>
  </div>

  <style is:inline>
    body[data-page^="/templates/sample/"][data-page$="/portal"] .site-header,
    body[data-page^="/templates/sample/"][data-page$="/portal"] .site-footer,
    body[data-page^="/templates/sample/"][data-page$="/portal"] .skip-link{display:none}
    body[data-page^="/templates/sample/"][data-page$="/portal"]{background:#f8fafc}
    .portal{--accent:#f97316;--ink:#111827;--muted:#667085;--line:#e5e7eb;--soft:#f8fafc;min-height:100vh;background:#f8fafc;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}
    .portal *{box-sizing:border-box}.portal h1,.portal h2,.portal h3,.portal p{margin-top:0}.portal a{color:inherit}.portal p,.portal span,.portal label,.portal td,.portal li{line-height:1.55}.portal p{color:var(--muted)}
    .wss-demo-cta{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:center;gap:.9rem;padding:.6rem 1rem;background:#fff7ed;border-bottom:1px solid rgba(249,115,22,.22)}.wss-demo-cta p{margin:0;color:#7c2d12;font-size:.9rem;font-weight:700}.wss-demo-cta strong{color:var(--ink)}.wss-demo-cta a{display:inline-flex;align-items:center;justify-content:center;min-height:2.35rem;padding:.55rem .85rem;border-radius:.55rem;background:var(--ink);color:#fff;text-decoration:none;font-size:.86rem;font-weight:850;white-space:nowrap}
    .portal-shell{display:grid;grid-template-columns:260px minmax(0,1fr);min-height:calc(100vh - 58px)}
    .sidebar{position:sticky;top:3.55rem;align-self:start;height:calc(100vh - 58px);display:flex;flex-direction:column;gap:1.25rem;padding:1.25rem;background:#fff;border-right:1px solid var(--line)}
    .brand{display:flex;align-items:center;gap:.75rem;text-decoration:none}.brand span{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:.65rem;background:var(--ink);color:#fff;font-weight:900}.brand strong{font-size:.98rem}
    .demo-marker{margin:0;padding:.55rem .65rem;border:1px dashed rgba(249,115,22,.4);border-radius:.65rem;background:#fff7ed;color:#9a3412!important;font-size:.72rem;font-weight:850;letter-spacing:.05em;text-transform:uppercase}
    .sidebar nav{display:grid;gap:.25rem}.sidebar nav a{padding:.72rem .8rem;border-radius:.6rem;color:#344054;text-decoration:none;font-size:.92rem;font-weight:750}.sidebar nav a:hover,.sidebar nav a:focus{background:#fff7ed;color:#9a3412;outline:none}.back-link{margin-top:auto;padding:.72rem .8rem;border:1px solid var(--line);border-radius:.6rem;text-decoration:none;font-size:.9rem;font-weight:800;text-align:center}
    .workspace{min-width:0;padding:1.5rem clamp(1rem,3vw,2rem) 3rem}.topline{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.4rem}.topline h1{margin:0;font-size:1.55rem;line-height:1.2;letter-spacing:0}.topline a{display:inline-flex;align-items:center;justify-content:center;min-height:2.5rem;padding:.55rem .8rem;border:1px solid var(--line);border-radius:.55rem;background:#fff;text-decoration:none;font-size:.88rem;font-weight:800}
    .eyebrow{margin:0 0 .35rem;color:#c2410c!important;font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.view{scroll-margin-top:5rem;margin-bottom:1rem;padding:1.25rem;border:1px solid var(--line);border-radius:.85rem;background:#fff;box-shadow:0 10px 30px rgba(16,24,39,.04)}.section-head{margin-bottom:1rem}.section-head h2{margin:0;font-size:1.18rem;line-height:1.25;letter-spacing:0}.section-head-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}
    .status-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.6fr);gap:1rem;align-items:start;padding:1rem;border-radius:.75rem;background:var(--soft);border:1px solid var(--line)}.status-panel h3{margin:.75rem 0 .25rem;font-size:1rem}.status-panel p{margin-bottom:0}.live-pill{display:inline-flex;align-items:center;gap:.45rem;width:fit-content;padding:.35rem .55rem;border-radius:999px;background:#ecfdf3;color:#166534;font-size:.8rem;font-weight:900}.live-pill span{width:.55rem;height:.55rem;border-radius:999px;background:#22c55e}.ownership{padding:.85rem;border-radius:.65rem;background:#fff;color:#344054!important;font-size:.92rem}
    .stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;margin-top:1rem}.stat-grid article{padding:1rem;border:1px solid var(--line);border-radius:.75rem;background:#fff}.stat-grid strong{display:block;margin-bottom:.35rem;font-size:1.7rem;line-height:1;color:var(--ink)}.stat-grid span{display:block;color:#344054;font-weight:800}.stat-grid small{display:block;margin-top:.25rem;color:var(--muted)}
    .lead-table{overflow:hidden;border:1px solid var(--line);border-radius:.75rem}.lead-row{display:grid;grid-template-columns:1fr .9fr 1.4fr .7fr .8fr;gap:.75rem;align-items:center;padding:.85rem 1rem;border-top:1px solid var(--line);font-size:.92rem}.lead-row:first-child{border-top:0}.lead-head{background:var(--soft);color:#475467;font-size:.78rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.lead-row span:first-child{font-weight:850;color:var(--ink)}.lead-row mark{display:inline-flex;padding:.25rem .45rem;border-radius:999px;background:#fff7ed;color:#9a3412;font-size:.78rem;font-weight:850}
