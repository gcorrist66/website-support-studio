const tradeConfig = tradeConfigBySlug[business.slug as keyof typeof tradeConfigBySlug] ?? tradeConfigBySlug["ridgeline-roofing"];

const title =
  page === "home"
    ? tradeConfig.title
    : `${business.nav.find((item) => item.page === page)?.label ?? "Page"} - ${business.name}`;
const description =
  page === "home"
    ? tradeConfig.description
    : `${business.name} is a fictitious ${tradeConfig.categoryLabel.toLowerCase()} website demo for ${business.location}.`;
const currentPath = samplePath(business, page);
const freePreviewPath = "/free-website-preview";
const industryPathBySlug: Record<string, string> = {
  "ridgeline-roofing": "/for/roofing",
  "northwind-hvac": "/for/hvac",
  "mainline-plumbing": "/for/plumbing",
  "brightwire-electric": "/for/electrical",
  "bluewave-pools": "/for/pools",
  "greenline-irrigation": "/for/irrigation",
  "overpro-garage-doors": "/for/garage-doors",
  "shieldline-pest-control": "/for/pest-control",
  "evergreen-lawn-landscape": "/for/landscaping",
  "canopy-tree-care": "/for/tree-service",
  "cornerstone-concrete": "/for/concrete",
  "brightwash-exterior-cleaning": "/for/pressure-washing",
};
const conversionPath = industryPathBySlug[business.slug] ?? freePreviewPath;
const deadLinkPath = "#";
const demoHomePath = samplePath(business, "home");
const portalPath = `${demoHomePath}/portal`;
const previewImagePath = `/templates/${business.slug}-desktop.png`;
const serviceArea = business.serviceArea;
const serviceCities = serviceArea?.cityGroups.map((entry) => entry.city) ?? [];
const services = business.services.slice(0, tradeConfig.serviceCount);
const projectImages = tradeConfig.projectImages;
const trustBadges = tradeConfig.trustBadges;
const brandMark = business.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
const schemas =
  page === "home"
    ? [
        breadcrumbSchema([
          { name: "Home", path: "/" },
          { name: `${tradeConfig.trade} website design`, path: industryPathBySlug[business.slug] ?? "/for/roofing" },
          { name: `${business.name} example`, path: currentPath },
        ]),
      ]
    : [];
