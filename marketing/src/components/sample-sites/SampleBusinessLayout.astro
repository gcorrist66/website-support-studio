---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdaptableStyleProof from "../AdaptableStyleProof.astro";
import { WEBSITE_PACKAGE } from "../../consts";
import type { SampleBusiness, SamplePage } from "../../sampleBusinesses";
import { samplePath } from "../../sampleBusinesses";

const { business, page } = Astro.props as { business: SampleBusiness; page: SamplePage };
const title = page === "home" ? `${business.name} — ${business.category} Sample Website` : `${business.nav.find((item) => item.page === page)?.label ?? "Page"} — ${business.name}`;
const description = `${business.name} is a ${business.badge.toLowerCase()} ${business.category.toLowerCase()} website for ${business.location}.`;
const currentPath = samplePath(business, page);
const checkoutHref = WEBSITE_PACKAGE.ctaHref;
const stylePalettes = {
  summit: [
    { label: "Roofing palette", colors: ["#172033", "#f97316", "#eef2f7"] },
    { label: "HVAC palette", colors: ["#0f172a", "#0284c7", "#e0f2fe"] },
    { label: "Landscaping palette", colors: ["#1f2a1f", "#65a30d", "#f0f7ea"] },
  ],
  harbor: [
    { label: "Wellness palette", colors: ["#0f3a4a", "#7dd3fc", "#eff6ff"] },
    { label: "Clinic palette", colors: ["#12313f", "#14b8a6", "#ecfeff"] },
    { label: "Professional palette", colors: ["#1e293b", "#3b82f6", "#f8fafc"] },
  ],
  atlas: [
    { label: "Advisory palette", colors: ["#172033", "#c59b49", "#f8f5ef"] },
    { label: "Consultant palette", colors: ["#111827", "#64748b", "#f8fafc"] },
    { label: "Finance palette", colors: ["#0f172a", "#16a34a", "#ecfdf5"] },
  ],
  ember: [
    { label: "Restaurant palette", colors: ["#3a1f16", "#c2410c", "#fff7ed"] },
    { label: "Bakery palette", colors: ["#4a2c2a", "#d97706", "#fff8eb"] },
    { label: "Bar palette", colors: ["#1f1115", "#be123c", "#fff1f2"] },
  ],
  foundry: [
    { label: "Plumbing palette", colors: ["#102a2a", "#0f766e", "#ecfeff"] },
    { label: "Auto palette", colors: ["#171717", "#dc2626", "#f5f5f5"] },
    { label: "Trades palette", colors: ["#1f2937", "#f59e0b", "#fffbeb"] },
  ],
};
const paletteExamples = stylePalettes[business.systemKey as keyof typeof stylePalettes] ?? stylePalettes.summit;
---

<BaseLayout title={title} description={description} path={currentPath}>
  <div class="sb-site" style={`--sb-accent:${business.accent};--sb-dark:${business.dark};--sb-soft:${business.soft};`}>
    <header class="sb-header">
      <a class="sb-logo" href={samplePath(business)} aria-label={`${business.name} home`}><span>{business.name}</span><small>{business.category}</small></a>
      <nav class="sb-nav" aria-label={`${business.name} navigation`}>
        {business.nav.map((item) => <a href={item.href} aria-current={item.page === page ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <a class="sb-top-cta" href={checkoutHref} data-ga-event={`click_${business.slug}_header_build`} data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
    </header>

    <section class="sb-conversion-strip" aria-label="Founder Website Package actions">
      <p>Like this sample website?</p>
      <div>
        <a href={checkoutHref} data-ga-event={`click_${business.slug}_strip_build`} data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
        <a href={checkoutHref} data-ga-event={`click_${business.slug}_strip_start`} data-ga-secondary-event="stripe_payment_link_click">Start With {business.systemName}</a>
        <a href={checkoutHref} data-ga-event={`click_${business.slug}_strip_style`} data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a>
      </div>
    </section>

    {page === "home" && (
      <>
        <section class="sb-section sb-hero"><div class="sb-container sb-hero-grid"><div><p class="sb-sample">{business.badge}</p><p class="sb-eyebrow">{business.systemName} · {business.location}</p><h1>{business.headline}</h1><p class="sb-lede">{business.tagline} {business.description}</p><div class="sb-actions"><a class="sb-btn sb-btn-primary" href={samplePath(business, "contact")}>Request Info</a><a class="sb-btn sb-btn-secondary" href={samplePath(business, "services")}>{business.nav.find((item) => item.page === "services")?.label}</a><a class="sb-btn sb-btn-quiet" href={checkoutHref} data-ga-event={`click_${business.slug}_style`} data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a></div></div><figure class="sb-photo"><img src={business.heroImage} alt={business.heroAlt} width="1400" height="980" loading="eager" /><figcaption>{business.name} · fictional sample business</figcaption></figure></div></section>
        <section class="sb-section sb-soft"><div class="sb-container"><p class="sb-eyebrow">{business.servicesLabel}</p><h2>{business.servicesIntro}</h2><div class="sb-card-grid">{business.services.slice(0, 3).map((item) => <article class="sb-card"><h3>{item.name}</h3><p class="sb-meta">{item.meta}</p><p>{item.body}</p></article>)}</div><div class="sb-actions"><a class="sb-btn sb-btn-secondary" href={samplePath(business, "services")}>See details</a></div></div></section>
        <section class="sb-section"><div class="sb-container sb-split"><div><p class="sb-eyebrow">About</p><h2>{business.aboutHeadline}</h2><p>{business.aboutBody}</p><div class="sb-actions"><a class="sb-btn sb-btn-secondary" href={samplePath(business, "about")}>Read more</a></div></div><div class="sb-card"><h3>What makes it sales-ready</h3><ul class="sb-list">{business.trust.map((item) => <li>{item}</li>)}</ul></div></div></section>
        <section class="sb-section sb-soft"><div class="sb-container"><p class="sb-eyebrow">{business.proofLabel}</p><h2>{business.proofIntro}</h2><div class="sb-proof-grid">{business.proofItems.slice(0, 3).map((item) => <div class="sb-proof">{item}</div>)}</div></div></section>
      </>
    )}

    {page === "services" && (
      <><section class="sb-section sb-hero"><div class="sb-container"><p class="sb-sample">{business.badge}</p><p class="sb-eyebrow">{business.servicesLabel}</p><h1>{business.servicesLabel} with clear next steps.</h1><p class="sb-lede">{business.servicesIntro}</p></div></section><section class="sb-section sb-soft"><div class="sb-container"><div class="sb-card-grid">{business.services.map((item) => <article class="sb-card"><h3>{item.name}</h3><p class="sb-meta">{item.meta}</p><p>{item.body}</p></article>)}</div><div class="sb-actions"><a class="sb-btn sb-btn-primary" href={samplePath(business, "contact")}>Contact {business.name}</a></div></div></section></>
    )}

    {page === "about" && (
      <><section class="sb-section sb-hero"><div class="sb-container sb-split"><div><p class="sb-sample">{business.badge}</p><p class="sb-eyebrow">About</p><h1>{business.aboutHeadline}</h1><p class="sb-lede">{business.aboutBody}</p></div><div class="sb-card"><h3>Sample business profile</h3><p>This is a fictional example created to show how a finished Founder Website can communicate a business category, offer, location, and next step without invented endorsements.</p></div></div></section><section class="sb-section sb-soft"><div class="sb-container sb-split"><div><h2>Trust built into the page</h2><p>Real-looking business websites explain what the visitor can do next, where the company serves, and why the business fits the need.</p></div><div class="sb-card"><ul class="sb-list">{business.trust.map((item) => <li>{item}</li>)}</ul></div></div></section></>
    )}

    {page === "proof" && (
      <><section class="sb-section sb-hero"><div class="sb-container"><p class="sb-sample">{business.badge}</p><p class="sb-eyebrow">{business.proofLabel}</p><h1>Specific examples without fake results.</h1><p class="sb-lede">{business.proofIntro}</p></div></section><section class="sb-section sb-soft"><div class="sb-container"><div class="sb-proof-grid">{business.proofItems.map((item) => <div class="sb-proof">{item}</div>)}</div><div class="sb-actions"><a class="sb-btn sb-btn-primary" href={samplePath(business, "contact")}>Ask a Question</a></div></div></section></>
    )}

    {page === "contact" && (
      <><section class="sb-section sb-hero"><div class="sb-container"><p class="sb-sample">{business.badge}</p><p class="sb-eyebrow">Contact</p><h1>Contact {business.name}.</h1><p class="sb-lede">{business.contactPrompt} This is a sample business form UI; production lead capture is added during the real build.</p></div></section><section class="sb-section sb-soft"><div class="sb-container sb-split"><form class="sb-card sb-form"><h2>Send a request</h2><label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label><label>Topic<select name="topic" required><option value="">Choose one</option>{business.services.slice(0, 5).map((item) => <option>{item.name}</option>)}<option>General question</option></select></label><label>What should {business.name} know?<textarea name="notes"></textarea></label><button class="sb-btn sb-btn-primary" type="button">Send Request</button><p style="min-height:1.2rem;margin:0;">Sample form only. No message is sent from this demo.</p></form><div class="sb-card"><h2>Visit details</h2><p>{business.address}</p><p><a href={business.phoneHref}>{business.phoneLabel}</a></p><ul class="sb-list">{business.hours.map((hour) => <li>{hour}</li>)}</ul></div></div></section></>
    )}

    <AdaptableStyleProof systemName={business.systemName} examples={paletteExamples} />
    <section class="sb-founder-cta"><div><p class="sb-eyebrow">Founder Website Package</p><h2>Want a website like {business.name}?</h2><p>This sample business shows the style and completeness your $500 Founder Website can start from. We customize the words, photos, services, and local details for your business.</p></div><div class="sb-actions"><a class="sb-btn sb-btn-primary" href={checkoutHref} data-ga-event={`click_${business.slug}_build`} data-ga-secondary-event="stripe_payment_link_click">Build My Website</a><a class="sb-btn sb-btn-secondary" href={checkoutHref} data-ga-event={`click_${business.slug}_start`} data-ga-secondary-event="stripe_payment_link_click">Start With {business.systemName}</a><a class="sb-btn sb-btn-quiet" href={checkoutHref} data-ga-event={`click_${business.slug}_use_style`} data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a></div></section>
    <footer class="sb-footer"><div><strong>{business.name}</strong><p>{business.location}</p><p>{business.badge} · Fictional example. Not a real customer.</p></div><div><p>{business.address}</p><p><a href={business.phoneHref}>{business.phoneLabel}</a></p></div></footer>
    <div class="sb-sticky"><a href={checkoutHref} data-ga-event={`click_${business.slug}_mobile_sticky`} data-ga-secondary-event="stripe_payment_link_click">Build My Website</a></div>
  </div>

  <style is:inline>
    body[data-page^="/templates/sample/"] .site-header,body[data-page^="/templates/sample/"] .site-footer,body[data-page^="/templates/sample/"] .skip-link{display:none}body[data-page^="/templates/sample/"]{background:#f8f6f1}.sb-site{min-height:100vh;color:var(--sb-dark);background:radial-gradient(circle at 82% 6%,color-mix(in srgb,var(--sb-accent) 18%,transparent),transparent 30rem),linear-gradient(180deg,#fff,var(--sb-soft) 58%,#fff);font-family:Georgia,"Times New Roman",serif}.sb-site h1,.sb-site h2,.sb-site h3{color:var(--sb-dark);font-family:Georgia,"Times New Roman",serif;letter-spacing:-.052em}.sb-site p,.sb-site li{color:color-mix(in srgb,var(--sb-dark) 62%,#fff)}.sb-header{position:sticky;top:0;z-index:70;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem clamp(1rem,4vw,3rem);border-bottom:1px solid color-mix(in srgb,var(--sb-dark) 14%,transparent);background:rgba(255,255,255,.86);backdrop-filter:blur(14px)}.sb-logo{display:grid;color:var(--sb-dark);line-height:.95;font-size:1.35rem;font-weight:900}.sb-logo small{color:var(--sb-accent);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase}.sb-nav{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;font-family:var(--font-mono);font-size:.82rem}.sb-nav a,.sb-footer a{color:var(--sb-dark)}.sb-nav a[aria-current="page"]{color:var(--sb-accent);font-weight:900}.sb-top-cta,.sb-btn,.sb-sticky a{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:.85rem 1.1rem;border:1px solid var(--sb-accent);font-family:var(--font-mono);font-weight:900;font-size:.86rem;text-decoration:none}.sb-top-cta,.sb-btn-primary,.sb-sticky a{background:var(--sb-dark);color:#fff;border-color:var(--sb-dark)}.sb-btn-secondary{background:#fff;color:var(--sb-dark)}.sb-btn-quiet{color:var(--sb-dark);background:transparent}.sb-conversion-strip{display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap;padding:.75rem 1rem;background:linear-gradient(90deg,var(--sb-dark),color-mix(in srgb,var(--sb-dark) 82%,var(--sb-accent)));color:#fff}.sb-conversion-strip p{margin:0;color:#fff;font-family:var(--font-mono);font-size:.78rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.sb-conversion-strip div{display:flex;gap:.55rem;flex-wrap:wrap;justify-content:center}.sb-conversion-strip a{display:inline-flex;align-items:center;justify-content:center;min-height:2.15rem;padding:0 .85rem;border-radius:999px;background:var(--sb-accent);color:var(--sb-dark);font-family:var(--font-mono);font-size:.74rem;font-weight:950;text-decoration:none;text-transform:uppercase;letter-spacing:.04em}.sb-section{padding:clamp(3.5rem,8vw,6rem) clamp(1rem,4vw,3rem)}.sb-container{max-width:1120px;margin:0 auto}.sb-eyebrow,.sb-sample{display:inline-flex;width:fit-content;border-radius:999px;font-family:var(--font-mono);font-size:.76rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.sb-eyebrow{color:var(--sb-accent)}.sb-sample{padding:.32rem .65rem;border:1px dashed color-mix(in srgb,var(--sb-accent) 55%,transparent);background:rgba(255,255,255,.68)}.sb-hero-grid,.sb-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:clamp(1.4rem,5vw,3.5rem);align-items:center}.sb-hero h1{max-width:12ch;margin:.8rem 0 0;font-size:clamp(3rem,10vw,6.8rem);line-height:.9}.sb-lede{max-width:60ch;font-size:1.12rem;line-height:1.75}.sb-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.25rem}.sb-photo{position:relative;min-height:480px;overflow:hidden;border-radius:2rem;border:1px solid color-mix(in srgb,var(--sb-dark) 14%,transparent);box-shadow:0 34px 90px rgba(20,20,20,.16);background:var(--sb-soft)}.sb-photo img{display:block;width:100%;height:100%;object-fit:cover}.sb-photo figcaption{position:absolute;left:1rem;right:1rem;bottom:1rem;border-radius:999px;padding:.55rem .8rem;color:#fff;background:rgba(0,0,0,.68);font-family:var(--font-mono);font-size:.78rem;font-weight:800}.sb-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.4rem}.sb-card{border:1px solid color-mix(in srgb,var(--sb-dark) 14%,transparent);border-radius:1.4rem;padding:1.25rem;background:rgba(255,255,255,.78);box-shadow:0 18px 50px rgba(20,20,20,.07)}.sb-card h3{margin:0;font-size:1.35rem}.sb-meta{margin:.7rem 0 0;color:var(--sb-accent)!important;font-family:var(--font-mono);font-weight:900;font-size:.9rem}.sb-soft{background:color-mix(in srgb,var(--sb-soft) 72%,#fff)}.sb-proof-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.9rem;margin-top:1.4rem}.sb-proof{min-height:210px;display:flex;align-items:end;border-radius:1.6rem;padding:1rem;color:#fff;font-weight:900;background:linear-gradient(180deg,transparent,rgba(0,0,0,.74)),radial-gradient(circle at 18% 12%,var(--sb-accent),var(--sb-dark))}.sb-list{display:grid;gap:.7rem;padding:0;margin:1rem 0 0;list-style:none}.sb-list li{padding:.8rem;border-radius:1rem;background:rgba(255,255,255,.74);border:1px solid color-mix(in srgb,var(--sb-dark) 12%,transparent)}.sb-form{display:grid;gap:.85rem}.sb-form label{display:grid;gap:.4rem;color:var(--sb-dark);font-family:var(--font-mono);font-weight:800;font-size:.82rem}.sb-form input,.sb-form select,.sb-form textarea{width:100%;border:1px solid color-mix(in srgb,var(--sb-dark) 20%,transparent);border-radius:1rem;padding:.8rem;background:#fff;font:inherit}.sb-form textarea{min-height:120px;resize:vertical}.sb-founder-cta{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin:0 clamp(1rem,4vw,3rem) 2rem;padding:clamp(1.25rem,4vw,2rem);border-radius:2rem;background:linear-gradient(135deg,var(--sb-dark),color-mix(in srgb,var(--sb-dark) 78%,var(--sb-accent)));color:#fff;border:4px solid color-mix(in srgb,var(--sb-accent) 68%,#fff);box-shadow:0 26px 70px rgba(0,0,0,.2)}.sb-founder-cta h2,.sb-founder-cta p{color:#fff}.sb-footer{display:flex;justify-content:space-between;gap:1rem;padding:2rem clamp(1rem,4vw,3rem) 6rem;border-top:1px solid color-mix(in srgb,var(--sb-dark) 14%,transparent)}.sb-sticky{display:none}@media(max-width:900px){.sb-header{align-items:start}.sb-nav,.sb-top-cta{display:none}.sb-hero-grid,.sb-split,.sb-card-grid,.sb-proof-grid,.sb-founder-cta,.sb-footer{grid-template-columns:1fr;display:grid}.sb-conversion-strip{padding:.65rem .85rem}.sb-photo{min-height:330px}.sb-hero h1{max-width:100%}.sb-section{padding-left:1rem;padding-right:1rem}.sb-sticky{position:fixed;z-index:90;left:.75rem;right:.75rem;bottom:.75rem;display:block;padding:.35rem;border-radius:999px;background:rgba(255,255,255,.92);border:1px solid color-mix(in srgb,var(--sb-accent) 28%,transparent);box-shadow:0 16px 44px rgba(0,0,0,.2);backdrop-filter:blur(12px)}.sb-sticky a{width:100%}}
  </style>
</BaseLayout>
