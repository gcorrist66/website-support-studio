---
import LogoLockup from "./LogoLockup.astro";
import Label from "./Label.astro";
import { NAV, FOOTER_LEGAL, CONTACT, ORG } from "../consts";

const year = 2026;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-col">
        <LogoLockup size={26} />
        <p style="margin-top:1rem; max-width:34ch; color:var(--text-muted); font-size:0.86rem;">
          Managed website operations and support for organizations with revenue-critical websites.
        </p>
      </div>

      <div class="footer-col">
        <h4><Label text="_navigation" /></h4>
        {NAV.map((item) => <a href={item.href}><Label text={`_${item.label}`} /></a>)}
      </div>

      <div class="footer-col">
        <h4><Label text="_legal" /></h4>
        {FOOTER_LEGAL.map((item) => <a href={item.href}><Label text={`_${item.label}`} /></a>)}
      </div>

      <div class="footer-col">
        <h4><Label text="_contact" /></h4>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <a href={CONTACT.bookingUrl} target="_blank" rel="noopener"><Label text="_book_a_call" /></a>
        <a href={CONTACT.linkedin} target="_blank" rel="noopener"><Label text="_linkedin" /></a>
      </div>
    </div>

    <div class="footer-meta">
      <div class="accent-bar" style="max-width:160px; margin-bottom:1rem;"></div>
      <p style="margin:0 0 0.25rem;">
        <Label text="_operated_by" /> — {ORG.legalName} · {ORG.address.locality}, {ORG.address.region}
      </p>
      <p style="margin:0;">© {year} Website Support Studio</p>
    </div>
  </div>
</footer>
