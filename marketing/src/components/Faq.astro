---
/**
 * FAQ list — renders {q, a} pairs as visible text that exactly matches
 * FAQPage structured data.
 */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="faq">
  {
    items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>
