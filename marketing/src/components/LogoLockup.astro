---
/**
 * Brand lockup — 4-quadrant logomark (amber / cyan / mulberry / blue) + the
 * monospace wordmark with a brand-blue underscore between words. Mirrors the
 * React LogoLockup in the operator console so both surfaces share one mark.
 */
interface Props {
  size?: number;
  text?: string;
  markOnly?: boolean;
  /** Brand-test variant: prepend a leading blue underscore -> _website_support_studio */
  lead?: boolean;
}
const { size = 30, text = "website support studio", markOnly = false, lead = false } = Astro.props;
const gap = size * 0.05;
const cell = (size - gap) / 2;
const radius = size * 0.07;
const words = text.split(" ");
---

<span class="lockup" style={`--lk: ${size}px`}>
  <svg
    width={size}
    height={size}
    viewBox={`0 0 ${size} ${size}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={markOnly ? "Website Support Studio" : undefined}
    aria-hidden={markOnly ? undefined : "true"}
  >
    <rect x="0" y="0" width={cell} height={cell} rx={radius} fill="var(--brand-amber)" />
    <rect x={cell + gap} y="0" width={cell} height={cell} rx={radius} fill="var(--brand-cyan)" />
    <rect x="0" y={cell + gap} width={cell} height={cell} rx={radius} fill="var(--brand-mulberry)" />
    <rect x={cell + gap} y={cell + gap} width={cell} height={cell} rx={radius} fill="var(--brand-blue)" />
  </svg>
  {
    !markOnly && (
      <span class="wordmark">
        {lead && <span class="us">_</span>}
        {words.map((w, i) => (
          <>
            {i > 0 && <span class="us">_</span>}
            {w}
          </>
        ))}
      </span>
    )
  }
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--lk) * 0.35);
  }
  .lockup svg {
    flex-shrink: 0;
  }
  .wordmark {
    font-family: var(--font-mono);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: calc(var(--lk) * 0.55);
    line-height: 1;
    white-space: nowrap;
    color: var(--wordmark-ink);
  }
  .wordmark .us {
    color: var(--wordmark-accent);
  }
</style>
