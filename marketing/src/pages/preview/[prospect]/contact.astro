---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getProspectConfig } from "../../../data/prospectPreviews";

export function getStaticPaths() {
  return [
    { params: { prospect: "authentic-air-solutions" } },
    { params: { prospect: "consistent-ac" } }
  ];
}

const { prospect } = Astro.params;
const prospectConfig = getProspectConfig(prospect);

if (!prospectConfig) {
  throw new Error(`Unknown prospect slug: ${prospect}`);
}

const basePath = `/preview/${prospectConfig.slug}`;
const isLeadGeneration = prospectConfig.designSystem === "lead-generation";
const closingSection = prospectConfig.closingSection;

const resolveProspectHref = (href: string) => {
  if (href.startsWith("http") || href.startsWith("#")) {
    return href;
  }
  if (href.startsWith(basePath)) {
    return href;
  }
  return href.startsWith("/") ? `${basePath}${href}` : `${basePath}/${href}`;
};
---
<SiteLayout
  title="Contact"
  description={prospectConfig.description}
  path={`${basePath}/contact`}
  type="contact"
  basePath={basePath}
  designSystem={prospectConfig.designSystem}
  siteConfigOverride={prospectConfig}
>
  <section>
    <p class="eyebrow">Contact</p>
    <h1>Request a service estimate</h1>
    <p class="lead">{prospectConfig.contactSummary}</p>
  </section>

  <section>
    <form id="contact-form" aria-labelledby="appointment-heading">
      <h2 id="appointment-heading">Service request</h2>
      <label for="name">Name
        <input id="name" name="name" autocomplete="name" required />
      </label>
      <label for="email">Email
        <input id="email" name="email" type="email" autocomplete="email" required />
      </label>
      <label for="service">Service
        <select id="service" name="service" required>
          <option value="">Choose a service</option>
          {prospectConfig.serviceCatalog.map((service) => (
            <option value={service.title}>{service.title}</option>
          ))}
        </select>
      </label>
      <label for="notes">{prospectConfig.contactNotesLabel}
        <textarea id="notes" name="notes" maxlength="500"></textarea>
      </label>
      <button type="submit">Send request</button>
      <p id="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section>
    <h2>Visit</h2>
    <p>{prospectConfig.city}, {prospectConfig.state}</p>
    <p>{prospectConfig.contactVisit}</p>
    <p class="muted">{prospectConfig.googleBusinessProfileSearchUrl ? "Google Business Profile details are available through the source link." : "Google Business Profile link can be added once the source URL is provided."}</p>
  </section>
  <section class:list={["closing-cta", isLeadGeneration ? "closing-cta--lead" : "closing-cta--modern"]}>
    <h2>{closingSection.title}</h2>
    <p class="lead">{closingSection.copy}</p>
    <div class="cta-row">
      <a class="button" href={resolveProspectHref(closingSection.primary.href)}>{closingSection.primary.label}</a>
      {closingSection.secondary ? (
        <a class="button button--green" href={resolveProspectHref(closingSection.secondary.href)}>
          {closingSection.secondary.label}
        </a>
      ) : null}
    </div>
  </section>
</SiteLayout>

<script is:inline>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    status.textContent = "Thanks for sharing your service details. Your request is captured for review.";
    form.reset();
  });
</script>
