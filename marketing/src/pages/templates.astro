---
import BaseLayout from "../layouts/BaseLayout.astro";
import FounderTrustLayer from "../components/FounderTrustLayer.astro";
import Label from "../components/Label.astro";
import { breadcrumbSchema, serviceSchema } from "../schema";
import {
  FOUNDER_WEBSITE_INCLUDES,
  DESIGN_SYSTEMS,
  DESIGN_SYSTEM_CUSTOMIZABLE,
  DESIGN_SYSTEM_CUSTOM_WORK,
  WEBSITE_PACKAGE,
} from "../consts";

const schemas = [
  serviceSchema({
    name: "Founder Website Package — Design Systems",
    description:
      "Design system starting points for local businesses. Choose a website style and Website Support Studio customizes it to your business. Every $500 Founder Website includes 5 pages, mobile optimization, contact forms, click-to-call, basic SEO, launch, and 30 days of support.",
    serviceType: "Website design and launch",
    path: "/templates",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Design Systems", path: "/templates" },
  ]),
];
---

<BaseLayout
  title="Design Systems — Choose the website style you want"
  description="Design system starting points for local businesses. Choose a website style and Website Support Studio customizes the words, photos, colors, services, and calls to action for your business. Every Founder Website includes 5 pages, mobile optimization, contact forms, click-to-call, basic SEO, hosting, SSL, launch, and 30 days of support."
  path="/templates"
  schemas={schemas}
>
  <section class="hero" style="padding-bottom:1.5rem;">
    <div class="container">
      <p class="kicker"><Label text="_design_systems" /></p>
      <h1>Choose the website style you want.</h1>
      <p class="lede">
        Choose a design system that feels right. We customize the words, photos, colors, services,
        calls to action, and local trust signals for your business.
      </p>
      <ul class="conversion-proof-strip" aria-label="Founder Website Package quick facts">
        <li><strong>$500</strong><span>one-time build</span></li>
        <li><strong>$199/month</strong><span>locked while active</span></li>
        <li><strong>You own it</strong><span>site, domain, content</span></li>
        <li><strong>Back Office</strong><span>leads, requests, plan</span></li>
      </ul>
      <div class="hero-actions" style="margin-top:1.25rem;">
        <a
          class="btn btn-green btn-cta"
          href={WEBSITE_PACKAGE.ctaHref}
          data-ga-event="click_build_my_website"
          data-ga-secondary-event="stripe_payment_link_click"
        >
          Build My Website
        </a>
        <a class="btn btn-ghost" href="/templates/sample/back-office/">Preview Back Office</a>
        <a class="btn btn-ghost" href="/pricing">See Pricing</a>
      </div>
      <div class="accent-bar" style="max-width:240px; margin-top:2rem;"></div>
    </div>
  </section>

  <!-- Every Founder Website includes -->
  <section class="section" style="padding-top:2rem;">
    <div class="container">
      <p class="kicker"><Label text="_whats_included" /></p>
      <h2 style="margin-top:0;">Every Founder Website includes</h2>
      <ul class="template-feature-strip" aria-label="Every Founder Website includes">
        {FOUNDER_WEBSITE_INCLUDES.map((item) => <li>{item}</li>)}
      </ul>
      <p style="margin-top:1rem; color:var(--text-muted); max-width:62ch;">
        One-time {WEBSITE_PACKAGE.price}. After launch: optional website support at{" "}
        {WEBSITE_PACKAGE.afterLaunch.founder}. {WEBSITE_PACKAGE.afterLaunch.standard} You own your
        website and all your accounts.
      </p>
    </div>
  </section>

  <FounderTrustLayer />

  <!-- Design system starting points -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_starting_points" /></p>
      <h2 style="margin-top:0;">Design systems that can become your business website.</h2>
      <div style="display:grid; gap:2rem; margin-top:2rem;">
        {
          DESIGN_SYSTEMS.map((t) => (
            <div class="card design-system-card" id={t.key} style="scroll-margin-top:5rem;">
              <div class="grid grid-2" style="align-items:start;">
                <div class="model-preview model-preview-large">
                  <img src={t.preview.image} alt={t.preview.alt} width="1100" height="720" loading="lazy" />
                  <div class="model-preview-ui">
                    <span>{t.preview.label}</span>
                    <strong>{t.name}</strong>
                  </div>
                </div>
                <div style="display:flex; flex-direction:column; min-height:100%;">
                  <h3 style="margin:0;">{t.name}</h3>
                  <p class="design-system-fit">{t.industry}</p>
                  <p style="margin:0.65rem 0 0; color:var(--text-muted);">{t.personality}</p>
                  <p style="margin:0.8rem 0 0; color:var(--text);">{t.preview.headline}</p>
                  <ul class="model-signals" aria-label={`${t.name} visual signals`}>
                    {t.preview.signals.map((signal) => <li>{signal}</li>)}
                  </ul>
                  <div class="design-system-adapt-box">
                    <p><strong>Finished sample sites:</strong> {t.sampleSites.map((site) => site.label.replace(" Sample", "")).join(", ")}</p>
                    <p><strong>Good for:</strong> {t.fits.join(", ")}.</p>
                  </div>
                  <p style="margin:1rem 0 0; font-weight:700; color:var(--text-strong);">Industries it fits</p>
                  <ul class="model-signals" aria-label={`${t.name} industries`}>
                    {t.fits.map((fit) => <li>{fit}</li>)}
                  </ul>
                  <p style="margin:1rem 0 0; font-weight:700; color:var(--text-strong);">Included pages</p>
                  <ul class="design-system-pages">
                    {t.pages.map((page) => (
                      <li>{page}</li>
                    ))}
                  </ul>
                  <p style="margin:1.25rem 0 0; font-weight:700; color:var(--text-strong);">Included features</p>
                  <ul style="padding-left:1.1rem; margin:0.5rem 0 0; color:var(--text);">
                    {t.features.map((f) => (
                      <li style="margin-bottom:0.35rem;">{f}</li>
                    ))}
                  </ul>
                  <div class="design-system-actions">
                    <a
                      class="btn btn-green btn-cta"
                      href={WEBSITE_PACKAGE.ctaHref}
                      data-ga-event="click_template_start"
                      data-ga-secondary-event="stripe_payment_link_click"
                      data-ga-label={t.key}
                    >
                      Start With This Style
                    </a>
                    {t.sampleSites.map((site) => (
                      <a class="btn btn-ghost" href={site.href} data-ga-event="click_sample_site" data-ga-label={`${t.key}_${site.label.toLowerCase().replaceAll(" ", "_")}`}>
                        {site.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Customizable vs custom work -->
  <section class="section" id="whats-customizable">
    <div class="container">
      <p class="kicker"><Label text="_whats_customizable" /></p>
      <h2 style="margin-top:0;">Made yours, not made from scratch.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Design systems keep the $500 price possible. We start from a proven website style and adapt it to your business —
        anything beyond that is quoted separately as custom work.
      </p>
      <div class="grid grid-2" style="margin-top:2rem; align-items:start;">
        <div class="card">
          <h3 style="margin-top:0;">Customizable — included in $500</h3>
          <ul style="padding-left:1.1rem; margin:1rem 0 0; color:var(--text);">
            {DESIGN_SYSTEM_CUSTOMIZABLE.map((item) => <li style="margin-bottom:0.4rem;">{item}</li>)}
          </ul>
        </div>
        <div class="card">
          <h3 style="margin-top:0;">Requires custom work — quoted separately</h3>
          <ul style="padding-left:1.1rem; margin:1rem 0 0; color:var(--text);">
            {DESIGN_SYSTEM_CUSTOM_WORK.map((item) => <li style="margin-bottom:0.4rem;">{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_get_started" /></p>
      <h2 style="margin-top:0;">Pick a website style. We do the rest.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        {WEBSITE_PACKAGE.tagline} One-time {WEBSITE_PACKAGE.price} — built, launched, and supported
        for 30 days.
      </p>
      <div class="hero-actions">
        <a
          class="btn btn-green btn-cta"
          href={WEBSITE_PACKAGE.ctaHref}
          data-ga-event="click_build_my_website"
          data-ga-secondary-event="stripe_payment_link_click"
        >
          <Label text={WEBSITE_PACKAGE.ctaLabel} />
        </a>
        <a class="btn btn-ghost" href="/templates/sample/back-office/" data-ga-event="click_back_office_preview">Preview Back Office</a>
        <a class="btn btn-ghost" href="/pricing" data-ga-event="click_pricing">See Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>
