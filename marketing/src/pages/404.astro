---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found on Website Support Studio."
  path="/404"
  noindex={true}
>
  <section class="section">
    <div class="container" style="max-width:620px; text-align:center;">
      <p class="kicker">error_404</p>
      <h1>This page could not be found.</h1>
      <p class="lede" style="margin:1rem auto;">
        The page you requested doesn't exist or may have moved.
      </p>
      <div class="hero-actions" style="justify-content:center;">
        <a class="btn btn-primary" href="/">return home</a>
        <a class="btn btn-ghost" href="/services">view services</a>
      </div>
    </div>
  </section>
</BaseLayout>
