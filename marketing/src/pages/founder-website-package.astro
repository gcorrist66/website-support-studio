---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import WebsiteOperationsDeskSection from "../components/WebsiteOperationsDeskSection.astro";
import { breadcrumbSchema, serviceSchema } from "../schema";
import { CONTACT, DESIGN_SYSTEMS, WEBSITE_PACKAGE } from "../consts";

const homepageDesignSystems = DESIGN_SYSTEMS.slice(0, 6);
const includedItems = [
  "Website Operations Desk access",
  "Ongoing website support",
  "SEO best practices",
  "AEO (Answer Engine Optimization)",
  "GEO (Generative Engine Optimization)",
  "Technical maintenance guidance",
  "Content update assistance",
  "Launch support",
];

const schemas = [
  serviceSchema({
    name: "Founder Website Package",
    description:
      "A professional website for your business, starting at $500. Website Support Studio builds it, customizes it, and launches it.",
    path: "/founder-website-package",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Founder Website Package", path: "/founder-website-package" },
  ]),
];
---

<BaseLayout
  title="Founder Website Package — $500 Websites"
  description="Get a professional website for your business. Website Support Studio builds it, customizes it, and launches it. Starting at $500."
  path="/founder-website-package"
  schemas={schemas}
>
  <section class="home-hero home-hero--tight">
    <div class="container home-hero-grid">
      <div>
        <p class="kicker"><Label text="_founder_website_package" /></p>
        <h1>Get a professional website for your business.</h1>
        <p class="lede">
          We build it. We customize it. We launch it.
          Starting at $500.
        </p>
        <div class="home-price-strip" aria-label="Founder Website Package summary">
          <span><strong>Starting at $500</strong></span>
          <span><strong>Customized</strong> for your business</span>
          <span><strong>Launched</strong> for you</span>
        </div>
        <div class="hero-actions home-actions">
          <a class="btn btn-green btn-cta" href={WEBSITE_PACKAGE.ctaHref} data-ga-event="click_build_my_website" data-ga-secondary-event="stripe_payment_link_click"><Label text="_build_my_website" /></a>
          <a class="btn btn-ghost" href="#examples" data-ga-event="click_founder_view_samples">View Sample Sites</a>
          <a class="btn btn-ghost" href="/website-gallery" data-ga-event="click_founder_website_gallery">Website Gallery</a>
          <a class="btn btn-ghost" href="/contact" data-ga-event="click_founder_book_call">Book A Call</a>
        </div>
        <p class="home-flow-copy">
          Enter your website and answer a few questions. We'll email you a private link to review your mockup.
          One request per website/domain.
        </p>
      </div>
      <aside class="home-sample-request-card" aria-labelledby="sample-request-heading">
        <div class="home-card-topbar"><span></span><span></span><span></span></div>
        <p class="kicker">Custom Sample Site</p>
        <h2 id="sample-request-heading">Don't like our samples? Let us build you a sample site.</h2>
        <p>
          Enter your website and answer a few questions. We'll email you a private link to review your mockup.
          One request per website/domain.
        </p>
        <form class="home-sample-form" action={`mailto:${CONTACT.email}`} method="post" enctype="text/plain">
          <label>
            <span>Your website URL</span>
            <input type="url" name="website_url" placeholder="https://yourwebsite.com" required />
          </label>
          <label>
            <span>What do you like about your site?</span>
            <textarea name="what_you_like" rows="2" placeholder="What should we keep or build on?"></textarea>
          </label>
          <label>
            <span>What don't you like about your site?</span>
            <textarea name="what_you_dont_like" rows="2" placeholder="What feels outdated, unclear, or frustrating?"></textarea>
          </label>
          <label>
            <span>What do you wish your website had?</span>
            <textarea name="website_wishlist" rows="2" placeholder="Bookings, stronger pages, lead capture, better support..."></textarea>
          </label>
          <button class="btn btn-green" type="submit" data-ga-event="click_founder_request_sample_site">
            Request My Sample Site
          </button>
        </form>
      </aside>
    </div>
  </section>

  <section class="section included-section" aria-labelledby="included-heading">
    <div class="container included-card">
      <div>
        <p class="kicker"><Label text="_build_support_optimize" /></p>
        <h2 id="included-heading">Every Website Includes</h2>
        <p>
          Your website is not handed off and forgotten. Website Support Studio helps maintain, support, and improve your website after launch.
        </p>
      </div>
      <ul class="included-list">
        {includedItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <WebsiteOperationsDeskSection />

  <section class="section package-score-cta" aria-labelledby="package-score-heading">
    <div class="container package-score-card">
      <div>
        <p class="kicker"><Label text="_website_score" /></p>
        <h2 id="package-score-heading">Not ready to request a website?</h2>
        <p>Get a free Website Score in minutes.</p>
      </div>
      <div class="score-review-list">
        <p>We'll review:</p>
        <ul>
          <li>Speed</li>
          <li>Mobile experience</li>
          <li>Local SEO</li>
          <li>Trust signals</li>
          <li>Conversion opportunities</li>
        </ul>
      </div>
      <a class="btn btn-green btn-cta" href="/website-health" data-ga-event="click_founder_website_score_cta">Get My Free Website Score</a>
    </div>
  </section>

  <section class="section home-examples" id="examples">
    <div class="container">
      <div class="home-section-head">
        <div>
          <p class="kicker"><Label text="_sample_websites" /></p>
          <h2>See what your $500 website can look like.</h2>
        </div>
        <p>
          Choose a demo-only, approved, or anonymized website style you like. We customize the words,
          photos, colors, services, calls to action, and local details for your business.
        </p>
      </div>
      <div class="model-gallery home-model-gallery">
        {
          homepageDesignSystems.map((t) => (
            <article class="card model-card">
              <div class="model-preview">
                <img src={t.preview.image} alt={t.preview.alt} width="1100" height="720" loading="lazy" />
                <div class="model-preview-ui">
                  <span>{t.preview.label}</span>
                  <strong>{t.name}</strong>
                </div>
              </div>
              <p class="template-industry">{t.industry}</p>
              <h3>{t.preview.headline}</h3>
              <ul class="model-signals" aria-label={`${t.name} visual signals`}>
                {t.preview.signals.map((signal) => <li>{signal}</li>)}
              </ul>
              <p class="design-system-adapt">
                Starts from {t.adaptableFrom}; can become {t.adaptableTo.slice(0, 3).join(", ")}.
              </p>
              <div class="design-system-actions">
                <a
                  class="btn btn-green btn-cta"
                  href={WEBSITE_PACKAGE.ctaHref}
                  data-ga-event="click_template_start"
                  data-ga-secondary-event="stripe_payment_link_click"
                  data-ga-label={t.key}
                >
                  Start With This Style
                </a>
                {t.sampleSites.slice(0, 2).map((site) => (
                  <a class="btn btn-ghost" href={site.href} data-ga-event="click_founder_sample_site" data-ga-label={`${t.key}_${site.label.toLowerCase().replaceAll(" ", "_")}`}>
                    {site.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      <div class="hero-actions home-actions" style="margin-top:1.5rem;">
        <a class="btn btn-green btn-cta" href="/website-gallery" data-ga-event="click_founder_full_website_gallery">View Website Gallery</a>
        <a class="btn btn-ghost" href="/templates" data-ga-event="click_founder_model_gallery_all">View All Sample Sites</a>
      </div>
    </div>
  </section>

  <style>
    .home-hero--tight { padding:clamp(1.15rem,3vw,2.4rem) 0 clamp(.85rem,2vw,1.5rem); }
    .home-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(300px,.72fr); gap:clamp(1.25rem,4vw,2.5rem); align-items:center; }
    .home-hero h1 { max-width:11ch; margin:.55rem 0 0; font-size:clamp(1.95rem,5.4vw,3.8rem); line-height:.95; letter-spacing:-.06em; }
    .home-hero .lede { max-width:64ch; margin-top:1rem; }
    .home-price-strip { display:flex; flex-wrap:wrap; gap:.55rem; margin-top:1rem; }
    .home-price-strip span { display:inline-flex; align-items:center; gap:.35rem; border:1px solid var(--border); border-radius:999px; padding:.55rem .75rem; background:var(--surface); color:var(--text-muted); font-size:.92rem; }
    .home-price-strip strong { color:var(--text); }
    .home-actions { gap:.65rem; margin-top:1.1rem; }
    .home-flow-copy { max-width:58ch; margin:1rem 0 0; color:var(--text-muted); font-size:.95rem; line-height:1.55; }
    .home-sample-request-card { border:1px solid var(--border); border-radius:1.5rem; padding:1rem; background:linear-gradient(180deg,#fff,var(--surface-muted)); box-shadow:0 22px 70px rgba(15,23,42,.08); }
    .home-card-topbar { display:flex; gap:.35rem; margin-bottom:1rem; }
    .home-card-topbar span { width:.7rem; height:.7rem; border-radius:999px; background:var(--border); }
    .home-sample-request-card h2 { margin:.25rem 0 .65rem; font-size:1.35rem; }
    .home-sample-request-card p { margin:.4rem 0 0; color:var(--text-muted); line-height:1.55; }
    .home-sample-form { display:grid; gap:.7rem; margin-top:1rem; }
    .home-sample-form label { display:grid; gap:.3rem; }
    .home-sample-form span { color:var(--text); font-size:.8rem; font-weight:900; }
    .home-sample-form input,
    .home-sample-form textarea { width:100%; border:1px solid var(--border); border-radius:.8rem; padding:.65rem .7rem; background:#fff; color:var(--text); font:inherit; }
    .home-sample-form textarea { resize:vertical; }
    .home-sample-form input::placeholder,
    .home-sample-form textarea::placeholder { color:var(--text-subtle); }
    .home-sample-form .btn { justify-content:center; margin-top:.15rem; }
    .included-section { padding-top:clamp(1.25rem,3vw,2rem); padding-bottom:clamp(1.25rem,3vw,2rem); background:var(--surface-muted); }
    .included-card { display:grid; gap:1.25rem; align-items:start; border:1px solid var(--border); border-radius:8px; background:#fff; padding:clamp(1.25rem,3vw,2rem); box-shadow:0 18px 50px rgba(11,18,32,.06); }
    .included-card h2 { margin:0; font-size:clamp(1.65rem,4vw,2.7rem); line-height:1; letter-spacing:0; }
    .included-card p { max-width:62ch; margin:.75rem 0 0; color:var(--text-muted); letter-spacing:0; }
    .included-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.55rem .85rem; margin:0; padding:0; list-style:none; }
    .included-list li { display:flex; gap:.5rem; align-items:flex-start; color:#334155; font-weight:800; letter-spacing:0; }
    .included-list li::before { content:"✓"; color:var(--brand-blue); font-weight:900; }
    .package-score-cta { padding-top:clamp(1.25rem,3vw,2rem); padding-bottom:clamp(1.25rem,3vw,2rem); background:var(--surface); }
    .package-score-card { display:grid; gap:1rem; align-items:center; border:1px solid var(--border); border-radius:8px; background:linear-gradient(135deg,rgba(53,220,234,.13),rgba(244,177,66,.17)),#fff; padding:clamp(1.25rem,3vw,2rem); box-shadow:0 18px 50px rgba(11,18,32,.08); }
    .package-score-card h2 { max-width:15ch; margin:0; font-size:clamp(1.65rem,4vw,2.7rem); line-height:1; letter-spacing:0; }
    .package-score-card p { margin:.55rem 0 0; color:var(--text-muted); letter-spacing:0; }
    .score-review-list { border:1px solid rgba(15,23,42,.1); border-radius:8px; background:rgba(255,255,255,.74); padding:1rem; }
    .score-review-list p { margin:0 0 .6rem; color:var(--text-strong); font-weight:900; }
    .score-review-list ul { display:grid; gap:.45rem; margin:0; padding:0; list-style:none; }
    .score-review-list li { display:flex; align-items:center; gap:.5rem; color:#334155; font-weight:800; letter-spacing:0; }
    .score-review-list li::before { content:"✓"; color:var(--brand-blue); font-weight:900; }
    .home-examples { padding-top:clamp(1.7rem,4vw,3rem); }
    .home-section-head { display:grid; grid-template-columns:minmax(0,.95fr) minmax(260px,.7fr); gap:1rem; align-items:end; margin-bottom:1.25rem; }
    .home-section-head h2 { margin-top:0; }
    .home-section-head p { margin:0; color:var(--text-muted); line-height:1.65; }
    .home-model-gallery { margin-top:0; }
    @media (min-width:900px) { .included-card { grid-template-columns:minmax(0,.82fr) minmax(360px,1fr); } .package-score-card { grid-template-columns:minmax(0,.9fr) minmax(260px,.62fr) auto; } }
    @media (max-width:900px) { .home-hero-grid,.home-section-head { grid-template-columns:1fr; } .home-hero h1 { max-width:100%; font-size:clamp(2.8rem,14vw,4.5rem); } }
    @media (max-width:640px) { .home-hero--tight { padding-top:1.75rem; } .home-actions .btn,.package-score-card .btn { width:100%; justify-content:center; } .home-price-strip span { width:100%; } .included-list { grid-template-columns:1fr; } }
  </style>
</BaseLayout>
