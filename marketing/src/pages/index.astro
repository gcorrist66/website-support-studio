---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import { serviceSchema } from "../schema";
import { CONTACT, JOIN_PATH } from "../consts";

const schemas = [
  serviceSchema({
    name: "Website Support Studio",
    description:
      "Managed website operations and support for organizations with revenue-critical websites: single-desk intake, defined response workflows, operational visibility, and human-approved execution.",
    path: "/",
  }),
];
---

<BaseLayout
  title="Website Support Studio — Managed Website Operations & Support"
  description="Managed website operations and support for organizations with revenue-critical websites. One desk for every request, defined response workflows, operational visibility, and human accountability on every change."
  path="/"
  schemas={schemas}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker"><Label text="_managed_website_operations" /></p>
        <h1>run your revenue-critical website as operations, not as a backlog of favors.</h1>
        <p class="lede">
          Website Support Studio is a managed operations and support desk for organizations whose websites
          drive revenue. One place for every request, a defined workflow from intake to closure, and a
          mandatory human approval before anything ships.
        </p>
        <div class="hero-actions">
          <a class="btn btn-green btn-cta" href={JOIN_PATH}><Label text="_join_now" /></a>
          <a class="btn btn-ghost" href="/services">See How It Works</a>
        </div>
        <div class="accent-bar" style="max-width:240px; margin-top:2.5rem;"></div>
      </div>

      <aside class="hero-sample-card" aria-labelledby="sample-site-heading">
        <p class="kicker"><Label text="_sample_site_request" /></p>
        <h2 id="sample-site-heading">Don't like our samples? Let us build you a sample site.</h2>
        <p>
          Send us your current URL and a few notes. We will use that context to shape a sample direction
          around your actual business instead of a generic demo.
        </p>
        <form class="sample-request-form" action={`mailto:${CONTACT.email}`} method="post" enctype="text/plain">
          <label>
            <span>Your website URL</span>
            <input type="url" name="website_url" placeholder="https://yourwebsite.com" required />
          </label>
          <label>
            <span>What do you like about your site?</span>
            <textarea name="what_you_like" rows="3" placeholder="What should we preserve or build on?"></textarea>
          </label>
          <label>
            <span>What don't you like about your site?</span>
            <textarea name="what_you_dont_like" rows="3" placeholder="What feels outdated, confusing, or hard to manage?"></textarea>
          </label>
          <label>
            <span>What do you wish your website had?</span>
            <textarea name="website_wishlist" rows="3" placeholder="Bookings, lead capture, better pages, analytics, support desk..."></textarea>
          </label>
          <button class="btn btn-green btn-cta" type="submit">Request My Sample Site</button>
        </form>
      </aside>
    </div>
  </section>

  <!-- Definition / summary block for answer engines -->
  <section class="section" style="padding-top:1rem;">
    <div class="container">
      <div class="summary" style="max-width:760px;">
        <strong>In one sentence.</strong> Website Support Studio consolidates website, marketing, and
        operations requests into a single managed desk — with operational visibility, defined response
        workflows, and human accountability at every approval point — so revenue-critical sites stay
        reliable and never ship unreviewed changes.
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_problem" /></p>
      <h2>Websites generate revenue. Their support rarely matches their importance.</h2>
      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card">
          <h3>Support is fragmented</h3>
          <p>Requests live in email, chat, project tools, and hallway asks. No one sees the full queue, and work falls through the gaps.</p>
        </div>
        <div class="card">
          <h3>Agencies disappear</h3>
          <p>External partners rotate staff and deprioritize accounts. The knowledge of how your site is wired leaves with them.</p>
        </div>
        <div class="card">
          <h3>Internal teams are overloaded</h3>
          <p>The people who could make a change are already running campaigns, releases, and incidents. Maintenance loses.</p>
        </div>
        <div class="card">
          <h3>Ownership is unclear</h3>
          <p>When something breaks, the first hour goes to deciding whose job it is — exactly when accountability matters most.</p>
        </div>
        <div class="card">
          <h3>Changes ship unreviewed</h3>
          <p>Under pressure, edits go live without a second set of eyes. Defects and brand drift reach customers first.</p>
        </div>
        <div class="card">
          <h3>No record of decisions</h3>
          <p>Without an audit trail, "who changed this and who approved it" has no answer when leadership or compliance asks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The approach — expanded around the _daemon concept -->
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_approach" /></p>
      <h2>One operating model, run like a daemon.</h2>
      <div class="summary" style="max-width:780px; margin-top:1rem;">
        <strong><Label text="_daemon" />.</strong> Think of Website Support Studio as a daemon for your
        website — an always-on operational process that watches one queue, picks up every request, and runs
        it through the same disciplined lifecycle. It doesn't sleep, it doesn't lose tickets, and it never
        ships without sign-off. The four commitments below are how that daemon runs.
      </div>
      <dl class="deflist grid grid-2" style="margin-top:2rem;">
        <div class="card">
          <dt>Operational visibility</dt>
          <dd>Every request enters one desk and becomes visible work — with a status, an owner, and a stage. The queue is shared, not scattered across inboxes.</dd>
        </div>
        <div class="card">
          <dt>Managed support</dt>
          <dd>The Website Support Studio support process triages, prepares, and delivers each change. You get the outcome without staffing, training, and supervising the work yourself.</dd>
        </div>
        <div class="card">
          <dt>Defined response workflows</dt>
          <dd>Each request follows a deterministic lifecycle — received, triaged, drafted, approved, delivered, closed — with defined handling for urgent and exceptional cases.</dd>
        </div>
        <div class="card">
          <dt>Accountability</dt>
          <dd>No customer-facing change ships without a mandatory human approval. The platform records who approved what, and when, for every request.</dd>
        </div>
      </dl>
      <div class="hero-actions">
        <a class="btn btn-ghost" href="/services">Explore Services</a>
        <a class="btn btn-ghost" href="/articles/introducing-website-support-studio">Read the Launch Announcement</a>
      </div>
    </div>
  </section>

  <!-- Questions → single source of truth at /faqs -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Questions, answered.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        How requests work, response times, platforms, approvals, and pricing — all in one place.
      </p>
      <p style="margin-top:1.25rem;">
        <a href="/faqs" style="font-weight:600;"><Label text="see_all_questions" /> →</a>
      </p>
    </div>
  </section>
</BaseLayout>
