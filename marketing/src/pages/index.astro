---
import SiteLayout from "../layouts/SiteLayout.astro";
import { featuredServices, siteConfig, galleryHighlights } from "../data/site";
---
<SiteLayout
  title="Home"
  description="MH Electrical and Solar is a Denver, CO electrician helping users request services and get project clarity."
  path="/"
  type="home"
>
  <section class="hero">
    <div class="hero-split">
      <div class="hero-copy">
        <p class="eyebrow">Electrical Services</p>
        <h1>Reliable electrical support from Denver, CO.</h1>
        <p class="lead">
          MH Electrical and Solar helps you get started with clear next steps, transparent request handling, and realistic service planning.
          Google Business profile rating: {siteConfig.ratingValue} from {siteConfig.reviewCount} customer reviews.
        </p>
        <div class="cta-row">
          <a class="button" href="/services">View Services</a>
          <a class="button" href="/contact">Request Appointment</a>
        </div>
      </div>

      <form class="hero-card" id="wss-reimagine-form" novalidate>
        <p class="hero-card-kicker">custom sample request</p>
        <h2>Don't like our samples? Let us build you a sample site.</h2>
        <p>Tell us what is working, what is not, and what your current website should finally be able to do.</p>
        <label>Your website URL<input name="website" type="url" required autocomplete="url" placeholder="https://example.com" /></label>
        <label>What do you like about your current site?<textarea name="what-you-like" required></textarea></label>
        <label>What don't you like about your current site?<textarea name="what-you-dislike" required></textarea></label>
        <label>What do you wish your website had?<textarea name="website-wishlist" required></textarea></label>
        <button class="button button--green" type="submit">Build My Sample Site</button>
        <p id="wss-reimagine-status" role="status" aria-live="polite" class="hero-form-status"></p>
      </form>
    </div>
  </section>

  <section>
    <h2>What you can request today</h2>
    <div class="card-grid">
      {featuredServices.map((service) => (
        <article class="card">
          <h2>{service.title}</h2>
          <p class="service-meta">{service.duration} · {service.price}</p>
          <p>{service.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Why this page is structured this way</h2>
    <div class="card-grid">
      <article class="card">
        <h3>Designed to convert</h3>
        <p>Clear sections and fast loading let you move from details to a request quickly.</p>
      </article>
      <article class="card">
        <h3>Conversion-focused flow</h3>
        <p>Primary actions lead visitors to service details and a request form with direct contact follow-up.</p>
      </article>
      <article class="card">
        <h3>Mobile-first form</h3>
        <p>Fast loading sections and accessible controls support users on any device.</p>
      </article>
    </div>
  </section>

  <section>
    <h2>Service planning examples</h2>
    <div class="gallery">
      {galleryHighlights.slice(0, 4).map((item) => (
        <article class="gallery-item">
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Next action</h2>
    <p class="muted">Use the form to share your project details, timeline, and contact window.</p>
    <div class="cta-row">
      <a class="button" href="/contact">Open request form</a>
      {siteConfig.googleBusinessProfileSearchUrl && <a class="button" href={siteConfig.googleBusinessProfileSearchUrl} rel="nofollow">Google Business Profile</a>}
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById("wss-reimagine-form");
      const status = document.getElementById("wss-reimagine-status");
      if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

      // TODO: connect this submit hook to an email + CRM route later
      // Example endpoint: /api/wss-reimagine-lead
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        status.textContent = "";

        if (!form.checkValidity()) {
          status.textContent = "Please complete all required fields before submitting.";
          return;
        }

        const data = {
          website: (form.querySelector('input[name="website"]').value || "").trim(),
          whatYouLike: (form.querySelector('textarea[name="what-you-like"]').value || "").trim(),
          whatYouDislike: (form.querySelector('textarea[name="what-you-dislike"]').value || "").trim(),
          websiteWishlist: (form.querySelector('textarea[name="website-wishlist"]').value || "").trim()
        };

        // Simulated success response while backend is offline.
        // Replace the block below with the actual submission call in the TODO hook above.
        console.log("WSS reimagine form payload (TODO wire-up):", data);
        status.textContent = "Thanks. Your sample-site brief is queued for review.";
        form.reset();
      });
    })();
  </script>
</SiteLayout>
