---
import BaseLayout from "../layouts/BaseLayout.astro";
import FounderTrustLayer from "../components/FounderTrustLayer.astro";
import Label from "../components/Label.astro";
import { serviceSchema } from "../schema";
import { JOIN_PATH, TEMPLATES, WEBSITE_PACKAGE } from "../consts";

const schemas = [
  serviceSchema({
    name: "Website Support Studio",
    description:
      "A $500 one-time Founder Website Package: a professional, mobile-optimized website with contact forms, basic SEO, and launch, plus 30 days of post-launch support — then optional managed operations from $199/month. Operated by Corriston Consulting, LLC. Customers own their analytics and advertising accounts.",
    path: "/",
  }),
];

const homepageModelWebsites = TEMPLATES.slice(0, 6);
---

<BaseLayout
  title="Website Support Studio — Get a Professional Website for $500"
  description="Get a professional website for $500 — mobile-optimized, contact forms, basic SEO, and launch, plus 30 days of post-launch support. Then optional managed operations from $199/month. You own your website and all your accounts."
  path="/"
  schemas={schemas}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="kicker"><Label text="_founder_website_package" /></p>
      <h1>Get a professional website for $500.</h1>
      <p class="lede">
        A complete, mobile-optimized website — with contact forms, basic SEO, and launch included, plus
        30 days of post-launch support. Then we keep it running: $199/month for your first 6 months,
        $399/month after. You own your website and all your accounts.
      </p>
      <div class="hero-actions">
        <a class="btn btn-green btn-cta" href={WEBSITE_PACKAGE.ctaHref} data-ga-event="click_build_my_website" data-ga-secondary-event="stripe_payment_link_click"><Label text="_build_my_website" /></a>
        <a class="btn btn-ghost" href={JOIN_PATH} data-ga-event="click_pricing">See Pricing</a>
      </div>
      <div class="accent-bar" style="max-width:240px; margin-top:2.5rem;"></div>
    </div>
  </section>

  <FounderTrustLayer />

  <!-- Model website gallery — polished examples for outreach -->
  <section class="section" id="examples" style="padding-top:1.5rem;">
    <div class="container">
      <p class="kicker"><Label text="_model_websites" /></p>
      <h2 style="margin-top:0;">See what your $500 website can look like.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Model websites for local businesses. Pick the one closest to your business — we customize
        the words, photos, colors, and service areas for you.
      </p>
      <div class="model-gallery">
        {
          homepageModelWebsites.map((t) => (
            <article class="card model-card">
              <div class="model-preview">
                <img src={t.preview.image} alt={t.preview.alt} width="1100" height="720" loading="lazy" />
                <div class="model-preview-ui">
                  <span>{t.preview.label}</span>
                  <strong>{t.name}</strong>
                </div>
              </div>
              <p class="template-industry">{t.industry}</p>
              <h3>{t.preview.headline}</h3>
              <ul class="model-signals" aria-label={`${t.name} visual signals`}>
                {t.preview.signals.map((signal) => <li>{signal}</li>)}
              </ul>
              <div class="template-actions">
                <a
                  class="btn btn-green btn-cta"
                  href={WEBSITE_PACKAGE.ctaHref}
                  data-ga-event="click_template_start"
                  data-ga-secondary-event="stripe_payment_link_click"
                  data-ga-label={t.key}
                >
                  Start With This Website
                </a>
                <a class="btn btn-ghost" href={`/templates#${t.key}`} data-ga-event="click_template_details" data-ga-label={t.key}>
                  Compare Starting Points
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="hero-actions" style="margin-top:1.5rem;">
        <a class="btn btn-ghost" href="/templates" data-ga-event="click_model_gallery_all">
          See All Model Websites
        </a>
      </div>
    </div>
  </section>

  <!-- Definition / summary block for answer engines -->
  <section class="section" style="padding-top:1rem;">
    <div class="container">
      <div class="summary" style="max-width:760px;">
        <strong>In one sentence.</strong> Website Support Studio builds and launches a professional
        website for a one-time $500 — then optionally keeps it running with managed operations
        ($199/month for your first six months, $399/month after) — while you keep ownership of your
        website and every analytics and advertising account.
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_problem" /></p>
      <h2>Websites generate revenue. Their support rarely matches their importance.</h2>
      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card">
          <h3>Support is fragmented</h3>
          <p>Requests live in email, chat, project tools, and hallway asks. No one sees the full queue, and work falls through the gaps.</p>
        </div>
        <div class="card">
          <h3>Agencies disappear</h3>
          <p>External partners rotate staff and deprioritize accounts. The knowledge of how your site is wired leaves with them.</p>
        </div>
        <div class="card">
          <h3>Internal teams are overloaded</h3>
          <p>The people who could make a change are already running campaigns, releases, and incidents. Maintenance loses.</p>
        </div>
        <div class="card">
          <h3>Ownership is unclear</h3>
          <p>When something breaks, the first hour goes to deciding whose job it is — exactly when accountability matters most.</p>
        </div>
        <div class="card">
          <h3>Changes ship unreviewed</h3>
          <p>Under pressure, edits go live without a second set of eyes. Defects and brand drift reach customers first.</p>
        </div>
        <div class="card">
          <h3>No record of decisions</h3>
          <p>Without an audit trail, "who changed this and who approved it" has no answer when leadership or compliance asks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The approach — expanded around the _daemon concept -->
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_approach" /></p>
      <h2>One operating model, run like a daemon.</h2>
      <div class="summary" style="max-width:780px; margin-top:1rem;">
        <strong><Label text="_daemon" />.</strong> Think of Website Support Studio as a daemon for your
        website — an always-on operational process that watches one queue, picks up every request, and runs
        it through the same disciplined lifecycle. It doesn't sleep, it doesn't lose tickets, and it never
        ships without sign-off. The four commitments below are how that daemon runs.
      </div>
      <dl class="deflist grid grid-2" style="margin-top:2rem;">
        <div class="card">
          <dt>Operational visibility</dt>
          <dd>Every request enters one desk and becomes visible work — with a status, an owner, and a stage. The queue is shared, not scattered across inboxes.</dd>
        </div>
        <div class="card">
          <dt>Managed support</dt>
          <dd>The Website Support Studio support process triages, prepares, and delivers each change. You get the outcome without staffing, training, and supervising the work yourself.</dd>
        </div>
        <div class="card">
          <dt>Defined response workflows</dt>
          <dd>Each request follows a deterministic lifecycle — received, triaged, drafted, approved, delivered, closed — with defined handling for urgent and exceptional cases.</dd>
        </div>
        <div class="card">
          <dt>Accountability</dt>
          <dd>No customer-facing change ships without a mandatory human approval. The platform records who approved what, and when, for every request.</dd>
        </div>
      </dl>
      <div class="hero-actions">
        <a class="btn btn-ghost" href="/services">Explore Services</a>
        <a class="btn btn-ghost" href="/articles/introducing-website-support-studio">Read the Launch Announcement</a>
      </div>
    </div>
  </section>

  <!-- Questions → single source of truth at /faqs -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Questions, answered.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        How requests work, response times, platforms, approvals, and pricing — all in one place.
      </p>
      <p style="margin-top:1.25rem;">
        <a href="/faqs" style="font-weight:600;"><Label text="see_all_questions" /> →</a>
      </p>
    </div>
  </section>
</BaseLayout>
