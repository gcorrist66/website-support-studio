---

<BaseLayout
  title="Website Support Studio - Free Custom Website Preview"
  description="Request a free custom website preview for your business. Website Support Studio creates practical homepage previews, website improvements, and ongoing support for small businesses."
  path="/"
  schemas={schemas}
  hideChrome
>
  <header class="wss-local-header">
    <div class="container wss-local-header-inner">
      <a href="/" aria-label="Website Support Studio home">
        <LogoLockup size={28} />
      </a>
      <a class="btn btn-green btn-cta" href="#custom-preview-form" data-ga-event="click_home_header_free_preview">Free preview</a>
    </div>
  </header>

  <section class="wss-home-hero" id="custom-preview">
    <div class="container wss-home-hero-grid">
      <div class="wss-home-hero-copy">
        <p class="kicker"><Label text="_free_custom_website_preview" /></p>
        <h1>Get a free custom website preview for your business.</h1>
        <p class="lede">
          Send us your current website. We will create a custom homepage preview for your real business so you can see
          what your next website could look like before you spend a dollar.
        </p>
        <div class="wss-home-actions">
          <a class="btn btn-green btn-cta" href="#custom-preview-form" data-ga-event="click_home_free_preview">Request your free preview</a>
        </div>
        <div class="wss-proof-strip" aria-label="Preview offer details">
          {proofPoints.map((point) => <span>{point}</span>)}
        </div>
      </div>

      <aside class="wss-preview-card" aria-labelledby="custom-preview-form-heading">
        <div class="home-card-topbar"><span></span><span></span><span></span></div>
        <p class="kicker">Free preview request</p>
        <h2 id="custom-preview-form-heading">Request a preview for your business</h2>
        <p>
          We will review your current site and create a homepage concept built around your actual services and buyers.
          No payment required to see the preview.
        </p>
        <p class="wss-delivery-note">Most previews are delivered within 2-3 business days.</p>
        <form class="wss-preview-form" id="custom-preview-form" action={`mailto:${CONTACT.email}`} method="post" enctype="text/plain">
          <label>
            <span>Website URL</span>
            <input name="website_url" type="url" required autocomplete="url" placeholder="https://example.com" />
          </label>
          <label>
            <span>Business Type</span>
            <input name="business_type" type="text" required placeholder="Roofing, HVAC, plumbing, salon..." />
          </label>
          <label>
            <span>Email Address</span>
            <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          </label>
          <label>
            <span>Optional challenge</span>
            <textarea name="challenge" rows="3" placeholder="What is not working well enough right now?"></textarea>
          </label>
          <button class="btn btn-green btn-cta" type="submit" data-ga-event="click_home_preview_form_submit">Get My Free Preview</button>
        </form>
      </aside>
    </div>
  </section>

  <section class="section wss-how" id="how-it-works">
    <div class="container">
      <div class="wss-section-head">
        <div>
          <p class="kicker"><Label text="_how_it_works" /></p>
          <h2>A simple way to see the direction before you approve the build.</h2>
        </div>
        <p>
          The preview gives you something concrete to judge with your team. If it feels right, we can turn it into a full website and support it after launch.
        </p>
      </div>
      <div class="wss-step-grid">
        {howItWorks.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wss-transformations" id="transformations">
    <div class="container">
      <div class="wss-section-head">
        <div>
          <p class="kicker"><Label text="_before_and_after" /></p>
          <h2>Side-by-side transformations make the improvement visible.</h2>
        </div>
        <p>
          The preview is not decoration. It shows how an outdated page can become easier to understand, trust, and contact.
        </p>
      </div>
      <div class="wss-transformation-grid">
        {transformations.map((item) => (
          <article class="wss-transformation-card">
            <p class="wss-transformation-type">{item.businessType}</p>
            <div class="wss-before-after-mockups">
              <div class="wss-before-mockup">
                <p class="wss-transformation-label">Before</p>
                <h3>{item.beforeTitle}</h3>
                <div class="wss-old-site-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <ul>
                  {item.before.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              <div class="wss-after-mockup">
                <p class="wss-transformation-label wss-transformation-label-after">After</p>
                <h3>{item.afterTitle}</h3>
                <div class="wss-new-site-layout" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <ul>
                  {item.after.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </div>
            <strong>{item.outcome}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wss-gallery-section" id="preview-inspiration">
    <div class="container">
      <div class="wss-section-head">
        <div>
          <p class="kicker"><Label text="_industry_gallery" /></p>
          <h2>Industry gallery for breadth, relevance, and ideas.</h2>
        </div>
        <p>
          The gallery stays broad on purpose. It shows the industries Website Support Studio can understand, while your preview is shaped around your business, service mix, and customer questions.
        </p>
      </div>

      <div class="wss-filter-row" aria-label="Preview focus areas">
        {previewFocusAreas.map((category) => <span>{category}</span>)}
      </div>

      <div class="wss-industry-grid">
        {industryConcepts.map((concept) => (
          <article class="wss-industry-card">
            <div class="wss-industry-image">
              <img
                src={concept.image}
                srcset={`${concept.image.replace("w=900", "w=480")} 480w, ${concept.image} 900w, ${concept.image.replace("w=900", "w=1200")} 1200w`}
                sizes="(min-width: 1024px) 31vw, (min-width: 768px) 46vw, 92vw"
                alt={`${concept.businessType} website preview concept`}
                loading="lazy"
                decoding="async"
                width="900"
                height="600"
              />
              <div class="wss-industry-overlay">
                <p>{concept.businessType}</p>
                <strong>{concept.title}</strong>
                <em>{concept.tag}</em>
              </div>
            </div>
            <div class="wss-industry-copy">
              <div>
                <p>{concept.businessType}</p>
                <h3>{concept.title}</h3>
              </div>
              <span>{concept.tag}</span>
            </div>
            <p class="wss-industry-outcome">{concept.outcome}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wss-trust-section" id="website-support-trust">
    <div class="container wss-trust-grid">
      <div>
        <p class="kicker"><Label text="_website_support_experience" /></p>
        <h2>Practical website help from preview through improvement.</h2>
      </div>
      <div class="wss-trust-list">
        {trustPoints.map((point) => <p>{point}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-card wss-final-cta">
      <div>
        <p class="kicker"><Label text="_after_the_preview" /></p>
        <h2>If the direction is right, we can build it and support it.</h2>
        <p>
          Website Support Studio creates custom preview concepts, builds practical websites, and provides ongoing support
          so the site keeps working after launch.
        </p>
      </div>
