---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import Faq from "../components/Faq.astro";
import { WEBSITE_PACKAGE } from "../consts";
import { breadcrumbSchema, faqSchema } from "../schema";
import { FAQ_GROUPS, ALL_FAQS } from "../faqs";

// The single source of truth for FAQ structured data lives here, on /faqs.
const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "FAQs", path: "/faqs" },
  ]),
  faqSchema(ALL_FAQS),
];
---

<BaseLayout
  title="FAQs"
  description="Answers about Website Support Studio pricing, ownership, support requests, response times, platforms, approvals, top-ups, and getting started."
  path="/faqs"
  schemas={schemas}
>
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h1>questions, answered.</h1>
      <p class="lede" style="margin-top:1rem;">
        Everything about cost, what happens next, what you own, Website Requests, sample sites, and support — in one place.
      </p>
      <div class="hero-actions" style="margin-top:1.25rem;">
        <a class="btn btn-primary" href={WEBSITE_PACKAGE.ctaHref}>Build My Website</a>
        <a class="btn btn-ghost" href="/templates/">View Sample Sites</a>
        <a class="btn btn-ghost" href="/templates/sample/back-office/">Preview Back Office</a>
      </div>

      {
        FAQ_GROUPS.map((group) => (
          <div style="margin-top:2.5rem;">
            <p class="kicker" style="margin-bottom:0.75rem;"><Label text={group.marker} /></p>
            <Faq items={group.items} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container cta-card cta-card--founder">
      <div>
        <p class="kicker"><Label text="_ready_to_start" /></p>
        <h2>Have enough clarity to move forward?</h2>
        <p>
          Build the website first, then keep it supported with Website Support Studio after launch.
        </p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={WEBSITE_PACKAGE.ctaHref}>Build My Website</a>
        <a class="btn btn-ghost" href="/pricing">Review Pricing</a>
        <a class="btn btn-ghost" href="/templates/sample/back-office/">Preview Back Office</a>
      </div>
    </div>
  </section>
</BaseLayout>
