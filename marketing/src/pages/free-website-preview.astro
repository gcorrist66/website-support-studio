---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import { SITE_URL, WEBSITE_PREVIEW_REQUEST_URL } from "../consts";
import { breadcrumbSchema, faqSchema, ID } from "../schema";

const pagePath = "/free-website-preview";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Free Website Preview",
    serviceType: "Free website preview request",
    description:
      "Website Support Studio reviews a business owner's questionnaire and prepares a free website preview for their business. No paid commitment is required to request the preview.",
    url: new URL(pagePath, SITE_URL).href,
    provider: { "@id": ID.org },
    areaServed: { "@type": "Country", name: "United States" },
    audience: {
      "@type": "Audience",
      audienceType: "Small business owners and local service businesses",
    },
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      description: "Free website preview request with no paid commitment required.",
    },
  },
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Free Website Preview", path: pagePath },
  ]),
  faqSchema([
    {
      q: "Is the Website Support Studio preview free?",
      a: "Yes. Business owners can request a free website preview by answering a questionnaire. There is no paid commitment required to submit the request.",
    },
    {
      q: "What happens after I submit the questionnaire?",
      a: "Website Support Studio reviews your goals, style preferences, services, audience, and inspiration websites, then prepares a free preview for you to review.",
    },
    {
      q: "Do AI agents automatically build my website?",
      a: "No. Website Support Studio is an operator-led service. AI agents may help the team review structured submissions and prepare work, but the service is reviewed by people.",
    },
  ]),
];

const previewEndpoint = WEBSITE_PREVIEW_REQUEST_URL;
---

<BaseLayout
  title="Free Website Preview"
  description="Let us build your free website preview today. Answer a few questions and Website Support Studio will review your business goals, style, services, and audience to prepare a free preview."
  path={pagePath}
  image="/og/og-free-preview.png"
  schemas={schemas}
>
  <section class="preview-hero">
    <div class="container preview-hero-grid">
      <div class="preview-hero-copy">
        <p class="kicker"><Label text="_free_website_preview" /></p>
        <h1>Let us build your free website preview — today.</h1>
        <p class="lede">
          We'll create a custom homepage preview for your business before you spend a dollar. No payment. No obligation. One per business.
        </p>
        <div class="preview-actions">
          <a class="btn btn-green btn-cta" href="#preview-questionnaire" data-ga-event="click_free_preview_hero_cta">Get My Free Website Preview</a>
          <a class="btn btn-ghost" href="#preview-examples" data-ga-event="click_free_preview_examples">See Example Previews</a>
        </div>
        <p class="micro-trust">Reviewed by a real person · Most previews are delivered within a few hours · One per business</p>
      </div>

      <aside class="hero-form-card" id="preview-questionnaire" aria-label="Free website preview questionnaire">
        <div class="form-card-head">
          <p>Free preview request</p>
          <h2>Tell us about your business.</h2>
          <span>No payment or commitment. We use this to prepare a better homepage preview.</span>
          <strong class="preview-ops-note">Every preview is evaluated with SEO, AEO, GEO, and Website Operations Desk best practices in mind.</strong>
          <strong class="preview-wod-callout">Every approved website includes Website Operations Desk support after launch.</strong>
        </div>

        <form class="preview-form" data-endpoint={previewEndpoint} novalidate>
          <input type="text" name="company_website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="form-status" role="status" aria-live="polite" hidden></div>

          <div class="field-pair">
            <label>
              <span>Name *</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Email *</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </div>

          <div class="field-pair">
            <label>
              <span>Phone</span>
              <input name="phone" autocomplete="tel" inputmode="tel" />
            </label>
            <label>
              <span>Business name *</span>
              <input name="business_name" autocomplete="organization" required />
            </label>
          </div>

          <div class="field-pair">
            <label>
              <span>Current website URL, optional</span>
              <input type="url" name="current_website_url" placeholder="https://example.com" />
            </label>
            <label>
              <span>Business type / industry</span>
              <input name="industry" placeholder="Roofing, law firm, salon, consulting..." />
            </label>
          </div>

          <label>
            <span>What does your business do? *</span>
            <textarea name="business_description" rows="3" required placeholder="Tell us what you sell, who you help, and what customers usually ask for."></textarea>
          </label>

          <fieldset>
            <legend>What pages do you need?</legend>
            <div class="check-grid">
              {["Home", "About", "Services", "Contact", "Pricing", "Gallery", "Blog"].map((page) => (
                <label><input type="checkbox" name="pages_needed" value={page} /> <span>{page}</span></label>
              ))}
            </div>
          </fieldset>

          <label>
            <span>What style do you like?</span>
            <input name="preferred_style" placeholder="Modern, simple, bold, luxury, friendly, local, professional..." />
          </label>

          <label>
            <span>Competitor or inspiration websites</span>
            <textarea name="inspiration_websites" rows="2" placeholder="Paste links or describe sites you like."></textarea>
          </label>

          <label>
            <span>Primary goal *</span>
            <select name="primary_goal" required>
              <option value="">Select a goal</option>
              <option value="get_leads">Get leads</option>
              <option value="book_appointments">Book appointments</option>
              <option value="sell_products">Sell products</option>
              <option value="look_more_professional">Look more professional</option>
              <option value="replace_old_website">Replace old website</option>
              <option value="other">Other</option>
            </select>
          </label>

          <label>
            <span>Services/products to highlight</span>
            <textarea name="services_to_highlight" rows="2"></textarea>
          </label>

          <label>
            <span>Target customers</span>
            <textarea name="target_customers" rows="2" placeholder="Who should the website speak to?"></textarea>
          </label>

          <fieldset>
            <legend>Logo/brand colors available?</legend>
            <div class="radio-row">
              <label><input type="radio" name="logo_brand_colors_available" value="yes" /> <span>Yes</span></label>
              <label><input type="radio" name="logo_brand_colors_available" value="no" /> <span>No</span></label>
            </div>
          </fieldset>

          <label>
            <span>Anything else we should know?</span>
            <textarea name="additional_notes" rows="3"></textarea>
          </label>

          <button class="btn btn-green btn-cta" type="submit" data-ga-event="submit_free_preview_request">Get My Free Website Preview</button>
          <p class="privacy-note">Submitting this form creates a structured preview request for Website Support Studio to review. No paid commitment is created by this form.</p>
        </form>
      </aside>
    </div>
  </section>

  <section class="trust-strip-section" aria-label="Website preview trust points">
    <div class="container trust-badges">
      <span>Human reviewed</span>
      <span>Built by Website Support Studio</span>
      <span>One free preview per business</span>
      <span>No obligation</span>
    </div>
  </section>

  <section class="section how-it-works">
    <div class="container">
      <div class="section-head">
        <p class="kicker"><Label text="_how_it_works" /></p>
        <h2>A simple path from request to preview.</h2>
      </div>
      <div class="steps-grid">
        <article>
          <span>01</span>
          <h3>Answer a few questions</h3>
          <p>Share your business, goals, style preferences, and the services you want customers to notice first.</p>
        </article>
        <article>
          <span>02</span>
          <h3>We build your preview</h3>
          <p>Website Support Studio reviews the brief and prepares a custom homepage preview for your business.</p>
        </article>
        <article>
          <span>03</span>
          <h3>We send it to you</h3>
          <p>You receive the preview so you can see what a modern, clearer website direction could look like.</p>
        </article>
        <article>
          <span>04</span>
          <h3>You decide if you want it built</h3>
          <p>No pressure and no payment required to review the preview. You choose the next step.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section website-score-cta" aria-labelledby="website-score-heading">
    <div class="container website-score-card">
      <div>
        <p class="kicker"><Label text="_website_score" /></p>
        <h2 id="website-score-heading">Not ready for a full website preview?</h2>
        <p>Get a free website score in minutes.</p>
      </div>
      <div class="score-checks">
        <p>We analyze:</p>
        <ul>
          <li>Speed</li>
          <li>Mobile experience</li>
          <li>Local SEO</li>
          <li>Trust signals</li>
          <li>Conversion opportunities</li>
        </ul>
      </div>
      <a class="btn btn-green btn-cta" href="/website-health" data-ga-event="click_free_preview_website_score_cta">Get My Free Website Score</a>
    </div>
  </section>

  <section class="section preview-gallery" id="preview-examples">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="kicker"><Label text="_website_inspiration" /></p>
          <h2>See what your business could look like</h2>
        </div>
        <p>
          These are browser-framed sample previews designed to show the kind of polished homepage direction we can prepare from your business details.
        </p>
      </div>

      <div class="mock-preview-grid" aria-label="Sample website preview mockups">
        {[
          {
            className: "landscaping",
            browser: "greenridge.example",
            brand: "Green Ridge Landscapes",
            nav: ["Services", "Portfolio", "Maintenance"],
            cta: "Request an Estimate",
            eyebrow: "Landscaping",
            title: "Outdoor living, lawn care, and clean curb appeal without the runaround.",
            body: "A gallery-led homepage with a quick estimate path and seasonal service cues.",
            services: ["Landscape Design", "Weekly Lawn Care", "Patio + Stonework"],
            proof: ["4.9 local rating", "18 years serving homeowners", "Booked in 2 minutes"],
          },
          {
            className: "roofing",
            browser: "summitline.example",
            brand: "Summitline Roofing",
            nav: ["Repairs", "Replacements", "Storm Help"],
            cta: "Schedule Inspection",
            eyebrow: "Roofing",
            title: "Roof repair and replacement made clear from the first click.",
            body: "A trust-forward layout built around emergency help, inspection requests, and proof.",
            services: ["Storm Damage", "Full Replacement", "Insurance Guidance"],
            proof: ["Licensed + insured", "Financing available", "Photo-backed inspections"],
          },
          {
            className: "law",
            brand: "Bennett & Cole Law",
            browser: "bennettcole.example",
            nav: ["Practice Areas", "Attorneys", "Results"],
            cta: "Book Consultation",
            eyebrow: "Law Firm",
            title: "Calm, credible legal guidance when the next step matters.",
            body: "A polished professional site that makes practice areas, confidence, and consultation easy to find.",
            services: ["Family Law", "Estate Planning", "Business Counsel"],
            proof: ["Confidential intake", "Local court experience", "Plain-English process"],
          },
          {
            className: "hvac",
            brand: "Northstar Heating & Air",
            browser: "northstarair.example",
            nav: ["Repair", "Install", "Maintenance"],
            cta: "Get Service Today",
            eyebrow: "HVAC",
            title: "Fast heating and AC service with the phone call impossible to miss.",
            body: "A utility-first homepage for emergency repair, tuneups, and replacement quotes.",
            services: ["AC Repair", "Heating Service", "Maintenance Plans"],
            proof: ["Same-day appointments", "Upfront diagnostics", "Seasonal tuneups"],
          },
          {
            className: "restaurant",
            brand: "Juniper Table",
            browser: "junipertable.example",
            nav: ["Menu", "Reservations", "Private Dining"],
            cta: "Reserve a Table",
            eyebrow: "Restaurant",
            title: "A neighborhood dining room with the menu, mood, and reservation path up front.",
            body: "A warm editorial layout with featured dishes, hours, and high-intent booking links.",
            services: ["Dinner Menu", "Weekend Brunch", "Private Events"],
            proof: ["Open tonight", "Seasonal menu", "Private room seats 24"],
          },
          {
            className: "dental",
            brand: "Cedar Grove Dental",
            browser: "cedargrovedental.example",
            nav: ["Services", "New Patients", "Insurance"],
            cta: "Book Appointment",
            eyebrow: "Dental",
            title: "A friendlier dental homepage that helps new patients feel ready to book.",
            body: "A clean, reassuring layout for care options, insurance details, and appointment flow.",
            services: ["Cleanings", "Cosmetic Dentistry", "Emergency Visits"],
            proof: ["New patients welcome", "Insurance guidance", "Family-friendly care"],
          },
        ].map((preview) => (
          <article class={`mock-site ${preview.className}`}>
            <div class="browser-chrome" aria-hidden="true">
              <div class="browser-dots"><span></span><span></span><span></span></div>
              <span>{preview.browser}</span>
            </div>
            <div class="mock-page">
              <div class="mock-nav">
                <strong>{preview.brand}</strong>
                <div>
                  {preview.nav.map((item) => <span>{item}</span>)}
                </div>
                <em>{preview.cta}</em>
              </div>
              <div class="mock-hero-shot">
                <div class="mock-hero-copy">
                  <small>{preview.eyebrow}</small>
                  <h3>{preview.title}</h3>
                  <p>{preview.body}</p>
                  <b>{preview.cta}</b>
                </div>
                <div class="mock-art" aria-hidden="true">
                  <span></span>
                  <span></span>
                </div>
              </div>
              <div class="mock-service-row">
                {preview.services.map((service) => <span>{service}</span>)}
              </div>
              <div class="mock-proof-row">
                {preview.proof.map((proof) => <span>{proof}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="gallery-cta">
        <p>Sample previews only. Your preview is prepared around your real business details, services, service area, and next best call to action.</p>
        <a class="btn btn-green btn-cta" href="/free-website-preview" data-ga-event="click_preview_gallery_cta">Get My Free Website Preview</a>
      </div>
    </div>
  </section>

  <section class="section urgency-block">
    <div class="container urgency-card">
      <div>
        <p class="kicker"><Label text="_free_preview_offer" /></p>
        <h2>Most previews are delivered within a few hours.</h2>
        <p>Only one free preview per website — no payment, no obligation. We review your answers and prepare a focused homepage direction you can judge before spending a dollar.</p>
      </div>
      <a class="btn btn-green btn-cta" href="#preview-questionnaire" data-ga-event="click_free_preview_offer_cta">Start My Free Preview</a>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>See your business as a modern website</h2>
      <p>Send the brief now and give Website Support Studio enough detail to prepare a useful first preview.</p>
      <a class="btn btn-green btn-cta" href="#preview-questionnaire" data-ga-event="click_free_preview_final_cta">Get My Free Website Preview</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.querySelector(".preview-form");
      if (!form) return;
      var status = form.querySelector(".form-status");
      var button = form.querySelector("button[type='submit']");

      function setStatus(message, kind) {
        if (!status) return;
        status.hidden = false;
        status.textContent = message;
        status.dataset.kind = kind;
      }

      function values(name) {
        return Array.prototype.map.call(form.querySelectorAll("[name='" + name + "']:checked"), function (input) {
          return input.value;
        });
      }

      form.addEventListener("submit", async function (event) {
        event.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          setStatus("Please complete the required fields, then submit again.", "error");
          return;
        }

        var data = new FormData(form);
        var payload = {
          page_source: "free_website_preview_landing_page",
          source_url: window.location.href,
          referrer: document.referrer || "",
          user_agent: navigator.userAgent || "",
          company_website: String(data.get("company_website") || ""),
          name: String(data.get("name") || ""),
          email: String(data.get("email") || ""),
          phone: String(data.get("phone") || ""),
          business_name: String(data.get("business_name") || ""),
          current_website_url: String(data.get("current_website_url") || ""),
          industry: String(data.get("industry") || ""),
          business_description: String(data.get("business_description") || ""),
          pages_needed: values("pages_needed"),
          preferred_style: String(data.get("preferred_style") || ""),
          inspiration_websites: String(data.get("inspiration_websites") || ""),
          primary_goal: String(data.get("primary_goal") || ""),
          services_to_highlight: String(data.get("services_to_highlight") || ""),
          target_customers: String(data.get("target_customers") || ""),
          logo_brand_colors_available: String(data.get("logo_brand_colors_available") || ""),
          additional_notes: String(data.get("additional_notes") || "")
        };

        var endpoint = form.dataset.endpoint;
        if (!endpoint) {
          setStatus("This form is not configured yet. Please email corristonconsulting@gmail.com.", "error");
          return;
        }

        button.disabled = true;
        button.textContent = "Sending...";
        setStatus("Sending your preview request...", "pending");

        try {
          var response = await fetch(endpoint, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload)
          });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok || !result.ok) {
            throw new Error(result.message || result.error || "submission_failed");
          }
          form.reset();
          setStatus("Thanks — we received your website preview request. We’ll review your answers and prepare your free preview.", "success");
        } catch (error) {
          var fallback = "We could not submit the request from this page. Please email corristonconsulting@gmail.com with your details.";
          setStatus(error && error.message && error.message !== "submission_failed" ? error.message : fallback, "error");
        } finally {
          button.disabled = false;
          button.textContent = "Get My Free Website Preview";
        }
      });
    })();
  </script>

  <style>
    :global(body[data-page="/free-website-preview"]) {
      background: #fff8ed;
    }

    .preview-hero {
      padding: clamp(1.25rem, 3vw, 2.6rem) 0 clamp(1.5rem, 3vw, 2.5rem);
      background:
        radial-gradient(circle at 15% 12%, rgba(244, 177, 66, 0.24), transparent 32%),
        linear-gradient(135deg, #fffaf1 0%, #f3fbf7 58%, #eef7ff 100%);
    }

    .preview-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
      align-items: start;
    }

    .preview-hero-copy h1 {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(2.2rem, 9vw, 4.8rem);
      line-height: 0.96;
      letter-spacing: 0;
    }

    .preview-hero-copy .lede {
      margin: 1rem 0 0;
      max-width: 55ch;
      color: #334155;
      font-size: clamp(1.02rem, 2vw, 1.22rem);
      line-height: 1.55;
      letter-spacing: 0;
    }

    .preview-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.15rem;
    }

    .micro-trust {
      max-width: 48ch;
      margin: 0.95rem 0 0;
      color: #475569;
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0;
    }

    .trust-strip-section {
      padding: 0.9rem 0;
      background: #0b1220;
    }

    .trust-badges {
      display: grid;
      gap: 0.55rem;
    }

    .trust-badges span {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      padding: 0.7rem 0.85rem;
      color: #f8fafc;
      font-size: 0.9rem;
      font-weight: 800;
      letter-spacing: 0;
    }

    .trust-badges span::before {
      content: "";
      width: 0.65rem;
      height: 0.65rem;
      border-radius: 999px;
      background: #35dcea;
      box-shadow: 0 0 0 4px rgba(53, 220, 234, 0.13);
      flex: 0 0 auto;
    }

    .hero-form-card,
    .mock-site,
    .website-score-card,
    .urgency-card,
    .final-cta-inner {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
    }

    .hero-form-card {
      overflow: hidden;
    }

    .form-card-head {
      padding: 1rem 1rem 0.8rem;
      background:
        linear-gradient(90deg, rgba(244, 177, 66, 0.14), rgba(53, 220, 234, 0.14)),
        #ffffff;
      border-bottom: 1px solid var(--border);
    }

    .form-card-head p,
    .form-card-head h2,
    .form-card-head span {
      margin: 0;
      letter-spacing: 0;
    }

    .form-card-head p {
      color: var(--brand-blue);
      font-size: 0.78rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .form-card-head h2 {
      margin-top: 0.25rem;
      color: var(--text-strong);
      font-size: clamp(1.25rem, 4vw, 1.7rem);
      line-height: 1.1;
    }

    .form-card-head span {
      display: block;
      margin-top: 0.35rem;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .preview-ops-note {
      display: block;
      margin-top: 0.7rem;
      border: 1px solid rgba(4, 67, 251, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.7);
      padding: 0.72rem;
      color: var(--text-strong);
      font-size: 0.84rem;
      line-height: 1.45;
      letter-spacing: 0;
    }

    .preview-wod-callout {
      display: block;
      margin-top: 0.55rem;
      border: 1px solid rgba(23, 99, 63, 0.18);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.76);
      padding: 0.7rem;
      color: #17633f;
      font-size: 0.84rem;
      line-height: 1.45;
      letter-spacing: 0;
    }

    .section {
      padding: clamp(2.2rem, 5vw, 4.3rem) 0;
    }

    .section-head {
      max-width: 800px;
      margin-bottom: 1.25rem;
    }

    .section-head h2,
    .urgency-card h2,
    .final-cta h2 {
      margin: 0;
      color: var(--text-strong);
      letter-spacing: 0;
    }

    .section-head p,
    .privacy-note,
    .urgency-card p,
    .final-cta p {
      color: var(--text-muted);
      letter-spacing: 0;
    }

    .section-head.split {
      display: grid;
      gap: 0.85rem;
      max-width: none;
      align-items: end;
    }

    .steps-grid,
    .mock-preview-grid {
      display: grid;
      gap: 0.9rem;
    }

    .steps-grid article {
      padding: 1.05rem;
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 8px;
      background: #fffefa;
      box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
    }

    .steps-grid span {
      display: inline-flex;
      margin-bottom: 0.65rem;
      color: var(--brand-blue);
      font-weight: 900;
      letter-spacing: 0;
    }

    .steps-grid h3,
    .mock-site h3 {
      margin: 0;
      color: var(--text-strong);
      letter-spacing: 0;
    }

    .steps-grid p,
    .mock-site p {
      margin-bottom: 0;
