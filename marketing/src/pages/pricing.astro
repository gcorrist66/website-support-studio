---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, faqSchema, serviceSchema } from "../schema";
import { CONTACT } from "../consts";

// Enterprise engagements are scoped and priced per organization — no public
// figures. Tiers describe scope and accountability, not a price list.
const tiers = [
  {
    name: "Desk",
    summary: "Managed intake and operational visibility.",
    points: [
      "Single-desk request intake",
      "Triage and classification within the support process",
      "Status tracking and operational visibility",
      "Expert recommendations and guidance",
    ],
  },
  {
    name: "Operations",
    summary: "Managed execution with human-approved changes.",
    recommended: true,
    points: [
      "Everything in Desk",
      "Approved website and CMS changes",
      "Image swaps, link and form fixes, page updates",
      "Mandatory human approval on every change",
      "Per-request audit trail",
    ],
  },
  {
    name: "Growth",
    summary: "Multi-site operations and expanded delivery.",
    points: [
      "Everything in Operations",
      "Coverage across multiple sites",
      "Staging and draft change support",
      "Expanded implementation and platform support",
      "Operational reporting",
    ],
  },
];

const faqs = [
  {
    q: "How much does Website Support Studio cost?",
    a: "Engagements are scoped and priced per organization based on the number of sites and request volume involved. We provide a quote after a short scoping conversation.",
  },
  {
    q: "Why isn't pricing published?",
    a: "Enterprise engagements vary by site count, request volume, platforms, and required response posture. Publishing a single figure would misrepresent the work, so we scope and quote each organization directly.",
  },
  {
    q: "How do I get a quote?",
    a: "Book a scoping call or email us. We confirm scope, sites, and expected request volume, then provide pricing for the appropriate tier.",
  },
];

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Engagement Tiers",
    description:
      "Managed website operations and support, scoped and priced per organization across Desk, Operations, and Growth tiers.",
    path: "/pricing",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing" },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  title="Pricing"
  description="Website Support Studio engagements are scoped and priced per organization across Desk, Operations, and Growth tiers. Book a scoping call for a quote."
  path="/pricing"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker">pricing</p>
      <h1>Scoped per organization. Priced after a short conversation.</h1>
      <p class="lede" style="margin-top:1rem;">
        Enterprise engagements vary by site count, request volume, platforms, and required response posture.
        We scope and quote each organization directly rather than publishing a single figure that would
        misrepresent the work.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={CONTACT.bookingUrl} target="_blank" rel="noopener">book a scoping call</a>
        <a class="btn btn-ghost" href={`mailto:${CONTACT.email}`}>email for a quote</a>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker">engagement_tiers</p>
      <h2>Three tiers, by scope and accountability.</h2>
      <div class="grid grid-3" style="margin-top:2rem; align-items:start;">
        {
          tiers.map((t) => (
            <div class="card" style={t.recommended ? "border:2px solid var(--brand-blue);" : ""}>
              {t.recommended && (
                <p class="kicker" style="color:var(--brand-blue); margin-bottom:0.5rem;">most_common</p>
              )}
              <h3 style="margin-top:0;">{t.name}</h3>
              <p style="color:var(--text-muted); font-size:0.9rem;">{t.summary}</p>
              <p style="font-weight:700; color:var(--text-strong); margin:1rem 0 0.5rem;">Contact for pricing</p>
              <ul style="padding-left:1.1rem; margin:0.75rem 0 0; color:var(--text);">
                {t.points.map((p) => <li style="margin-bottom:0.4rem;">{p}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <p style="margin-top:1.5rem; color:var(--text-muted); max-width:62ch;">
        All tiers operate inside the same defined response workflow with a mandatory human approval gate.
        Tiers differ in the scope of execution and the number of sites covered, not in the level of
        accountability.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker">questions</p>
      <h2>Frequently asked questions</h2>
      <div class="faq" style="margin-top:1.5rem;">
        {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</BaseLayout>
