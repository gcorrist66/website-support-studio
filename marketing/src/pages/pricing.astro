---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import { breadcrumbSchema, serviceSchema } from "../schema";
import { PLANS, ADDONS, CHECKOUT_URL, CONTACT, FOUNDER_PRICING } from "../consts";

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Plans",
    description:
      "Managed website operations and support. Operations is $399/month with founder pricing at $199.50/month for the first 6 months for the first 25 customers; Growth is $899/month (up to 5 sites, 150 Capacity Units); Enterprise custom.",
    path: "/pricing",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing" },
  ]),
];
---

<BaseLayout
  title="Pricing"
  description="Website Support Studio plans: Operations $399/month with founder pricing at $199.50/month for the first 6 months for the first 25 customers, Growth $899/month, and custom Enterprise. Capacity top-ups available."
  path="/pricing"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_pricing" /></p>
      <h1>plans priced in <Label text="capacity_units" />.</h1>
      <p class="lede" style="margin-top:1rem;">
        Every plan is a managed website operations desk with a monthly allotment of Capacity Units.
        Pick a plan, check out securely, and start your website project. After purchase, you create
        your account and complete a short onboarding.
      </p>
      <p class="kicker" style="margin-top:1rem;"><Label text="_founder_pricing" /></p>
      <p class="lede" style="margin-top:0.35rem;">
        Founder pricing is {FOUNDER_PRICING.discountPercent}% off Operations for your first {FOUNDER_PRICING.discountMonths} months.
        Then the plan moves to the standard {PLANS[0].price}{PLANS[0].cadence}. <strong>{FOUNDER_PRICING.spotsLeft} founder spots remaining.</strong>
      </p>
    </div>
  </section>

  <section class="section" id="plans" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_plans" /></p>
      <div class="grid grid-3" style="margin-top:2rem; align-items:start;">
        {
          PLANS.map((plan) => {
            const featured = "recommended" in plan && plan.recommended;
            const isOperations = plan.key === "operations";
            const founderApplies =
              FOUNDER_PRICING.active && (FOUNDER_PRICING.appliesTo as readonly string[]).includes(plan.key);
            const checkoutPlanKey = founderApplies && "founderPlanKey" in plan ? plan.founderPlanKey : plan.key;
            return (
              <div>
                {featured && (
                  <p class="kicker" style="margin-bottom:0.6rem;"><Label text="_most_common" /></p>
                )}
                <div class={founderApplies ? "card founder-card" : "card"} style={!founderApplies && featured ? "border:2px solid var(--brand-blue);" : ""}>
                  <h3 style="margin-top:0;"><Label text={`_${plan.name.toLowerCase()}`} /></h3>
                  {founderApplies && isOperations ? (
                    <div class="founder-offer">
                      <div class="founder-badge-row">
                        <span class="founder-badge"><Label text="_founder_pricing" /></span>
                        <span class="founder-spots">{FOUNDER_PRICING.spotsLeft} of {FOUNDER_PRICING.totalSpots} spots left</span>
                      </div>
                      <p class="founder-discount">{plan.founderDiscountLabel} for your first {FOUNDER_PRICING.discountMonths} months</p>
                      <p class="founder-price-line">
                        <span class="founder-price">{plan.founderPrice}</span>
                        <span class="founder-cadence">{plan.cadence}</span>
                      </p>
                      <p class="founder-regular">
                        for {FOUNDER_PRICING.discountMonths} months, then <strong>{plan.price}{plan.cadence}</strong>
                      </p>
                      <p class="founder-regular">regularly <s>{plan.price}{plan.cadence}</s></p>
                      <p class="founder-note">
                        limited to the first {FOUNDER_PRICING.totalSpots} customers. _join_now uses founder checkout automatically while spots remain.
                      </p>
                    </div>
                  ) : (
                    <p style="margin:0.25rem 0 0;">
                      <span style="font-size:1.9rem; font-weight:800; letter-spacing:-0.03em;">{plan.price}</span>
                      <span style="color:var(--text-muted);">{plan.cadence}</span>
                    </p>
                  )}
                  <p style="color:var(--text-muted); font-size:0.9rem; margin:0.5rem 0 0;">{plan.sites} · {plan.cu}</p>
                  <p style="margin:0.75rem 0 0;">{founderApplies && isOperations ? plan.founderBlurb : plan.blurb}</p>
                  <ul style="padding-left:1.1rem; margin:1rem 0 1.25rem; color:var(--text);">
                    {plan.points.map((p) => <li style="margin-bottom:0.4rem;">{p}</li>)}
                  </ul>
                  {plan.cta === "checkout" ? (
                    <button
                      class="btn btn-green btn-cta"
                      type="button"
                      data-plan={checkoutPlanKey}
                      data-regular-plan={plan.key}
                      style="width:100%; justify-content:center;"
                    >
                      <Label text="_join_now" />
                    </button>
                  ) : (
                    <a class="btn btn-ghost" href="/contact" style="width:100%; justify-content:center;">contact sales</a>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
      <p style="margin-top:1.25rem; color:var(--text-muted); max-width:62ch;">
        All plans operate inside the same defined response workflow with a mandatory human approval gate.
        Founder pricing currently applies to Operations only. Plans differ in monthly Capacity Units and the number of websites covered.
      </p>
    </div>
  </section>

  <!-- Capacity Units explainer -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_capacity_units" /></p>
      <h2>How Capacity Units work</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Capacity Units measure the effort of each request, so you always know what's included in your
        website project. Monthly Capacity Units refresh every month and do not roll over. Need more in
        a busy month? Add a top-up anytime.
      </p>
      <div class="card" style="margin-top:1rem;">
        <h3 style="margin-top:0;">Credit policy</h3>
        <ul style="margin:0; padding-left:1.1rem; color:var(--text-muted);">
          <li>Monthly Capacity Units refresh each month and do not roll over.</li>
          <li>Purchased top-up credits stay on your account until used.</li>
          <li>Top-up credits do roll over and are used after monthly credits run out.</li>
        </ul>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem;">
        {
          ADDONS.map((a) => (
            <div class="card">
              <h3 style="margin-top:0;">{a.name}</h3>
              <p style="color:var(--text-muted); margin:0;">{a.note}</p>
              {a.key.startsWith("topup_") ? (
                <p style="margin:1rem 0 0;">
                  <button class="btn btn-green" data-addon={a.key}><Label text="buy_top_up" /></button>
                </p>
              ) : null}
            </div>
          ))
        }
      </div>
      <p style="margin-top:1rem; color:var(--text-muted); font-size:0.9rem;">
        Top-ups and DNS assistance are available to active customers from your account after you join.
      </p>
    </div>
  </section>

  <!-- Questions → single source of truth at /faqs -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Questions, answered.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Cost, Capacity Units, top-ups, getting started, and custom plans — all in one place.
      </p>
      <p style="margin-top:1.25rem;">
        <a href="/faqs" style="font-weight:600;"><Label text="see_all_questions" /> →</a>
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ CHECKOUT_URL, fallback: CONTACT.email }}>
    document.addEventListener("click", async (e) => {
      const btn = e.target.closest("[data-plan], [data-addon]");
      if (!btn) return;
      e.preventDefault();
      const plan = btn.getAttribute("data-plan");
      const addon = btn.getAttribute("data-addon");
      if (!CHECKOUT_URL) {
        window.location.href = "/contact";
        return;
      }
      const original = btn.innerHTML;
      btn.setAttribute("disabled", "true");
      btn.textContent = "redirecting…";
      try {
        const res = await fetch(CHECKOUT_URL, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(plan ? { plan } : { addon }),
        });
        const data = await res.json();
        if (data && data.url) {
          window.location.href = data.url;
          return;
        }
        window.location.href = "/contact";
      } catch (_) {
        window.location.href = "/contact";
      } finally {
        btn.removeAttribute("disabled");
        btn.innerHTML = original;
      }
    });
  </script>
</BaseLayout>
