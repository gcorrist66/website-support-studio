---
import BaseLayout from "../layouts/BaseLayout.astro";
import FounderTrustLayer from "../components/FounderTrustLayer.astro";
import Faq from "../components/Faq.astro";
import Label from "../components/Label.astro";
import { breadcrumbSchema, faqSchema, serviceSchema } from "../schema";
import { PLANS, ADDONS, CHECKOUT_URL, CONTACT, FOUNDER_PRICING, WEBSITE_PACKAGE, ACCOUNT_OWNERSHIP } from "../consts";
import { PRICING_PAGE_FAQS } from "../faqs";

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Founder Website Package & Plans",
    description:
      "Founder Website Package: a $500 one-time professional website (mobile optimization, contact forms, basic SEO, launch, and 30 days of support). After launch, optional website support is $199/month, locked in while your account remains active. Growth is $899/month; Enterprise custom. Customers own their analytics and advertising accounts.",
    path: "/pricing",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing" },
  ]),
  faqSchema(PRICING_PAGE_FAQS),
];
---

<BaseLayout
  title="Pricing: $500 Site + $199 Support"
  description="See WSS pricing: a $500 Founder Website Package, optional $199/month support after launch, Growth plans, top-ups, ownership, and next steps."
  path="/pricing"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_founder_website_package" /></p>
      <h1>Launch for $500. Keep it running from $199/month.</h1>
      <p class="lede" style="margin-top:1rem;">
        Start with the Founder Website Package — a professional website built and launched for you.
        After launch, optional website support keeps it healthy. You own your website and all your accounts.
      </p>
      <div class="hero-actions" style="margin-top:1.25rem;">
        <a class="btn btn-green btn-cta" href={WEBSITE_PACKAGE.ctaHref} data-ga-event="click_founder_package_payment" data-ga-secondary-event="stripe_payment_link_click">
          Build My Website
        </a>
        <a class="btn btn-ghost" href="/templates/">View Sample Sites</a>
        <a class="btn btn-ghost" href="/templates/sample/back-office/">Preview Back Office</a>
      </div>

      <div class="card founder-card" style="margin-top:2rem; max-width:560px;">
        <div class="founder-badge-row">
          <span class="founder-badge"><Label text="_founder_website_package" /></span>
          <span class="founder-spots">{WEBSITE_PACKAGE.cadence}</span>
        </div>
        <p class="founder-price-line">
          <span class="founder-price">{WEBSITE_PACKAGE.price}</span>
          <span class="founder-cadence"> one-time</span>
        </p>
        <p style="margin:0.5rem 0 0; color:var(--text-muted);">{WEBSITE_PACKAGE.tagline}</p>
        <ul style="padding-left:1.1rem; margin:1rem 0 1.25rem; color:var(--text);">
          {WEBSITE_PACKAGE.includes.map((item) => <li style="margin-bottom:0.4rem;">{item}</li>)}
        </ul>
        <p style="margin:0 0 1.25rem; color:var(--text-muted);">
          After launch: optional website support at <strong>{WEBSITE_PACKAGE.afterLaunch.founder}</strong>. {WEBSITE_PACKAGE.afterLaunch.standard}
        </p>
        <a class="btn btn-green btn-cta" href={WEBSITE_PACKAGE.ctaHref} style="width:100%; justify-content:center;" data-ga-event="click_founder_package_payment" data-ga-secondary-event="stripe_payment_link_click">
          <Label text={WEBSITE_PACKAGE.ctaLabel} />
        </a>
      </div>
    </div>
  </section>

  <FounderTrustLayer />

  <section class="section" id="plans" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_after_launch" /></p>
      <h2 style="margin:0.4rem 0 0;">Keep your website updated after launch</h2>
      <p class="lede" style="margin-top:0.75rem; max-width:62ch;">
        Optional after your website launches. Founder support is $199/month and stays locked in while
        your account remains active. Send Website Requests from your Back Office, review updates, and cancel anytime.
      </p>
      <div class="grid grid-3" style="margin-top:2rem; align-items:start;">
        {
          PLANS.map((plan) => {
            const featured = "recommended" in plan && plan.recommended;
            const isOperations = plan.key === "operations";
            const founderApplies =
              FOUNDER_PRICING.active && (FOUNDER_PRICING.appliesTo as readonly string[]).includes(plan.key);
            const checkoutPlanKey = founderApplies && "founderPlanKey" in plan ? plan.founderPlanKey : plan.key;
            return (
              <div>
                {featured && (
                  <p class="kicker" style="margin-bottom:0.6rem;"><Label text="_most_common" /></p>
                )}
                <div class={founderApplies ? "card founder-card" : "card"} style={!founderApplies && featured ? "border:2px solid var(--brand-blue);" : ""}>
                  <h3 style="margin-top:0;"><Label text={`_${plan.name.toLowerCase()}`} /></h3>
                  {founderApplies && isOperations ? (
                    <div class="founder-offer">
                      <div class="founder-badge-row">
                        <span class="founder-badge"><Label text="_founder_pricing" /></span>
                        <span class="founder-spots">{FOUNDER_PRICING.spotsLeft} of {FOUNDER_PRICING.totalSpots} spots left</span>
                      </div>
                      <p class="founder-discount">Founder rate locked while your account remains active</p>
                      <p class="founder-price-line">
                        <span class="founder-price">{plan.founderPrice}</span>
                        <span class="founder-cadence">{plan.cadence}</span>
                      </p>
                      <p class="founder-regular">
                        Founder customers keep this rate for as long as their account remains active.
                      </p>
                      <p class="founder-note">Limited to the first {FOUNDER_PRICING.totalSpots} customers. _join_now uses founder checkout automatically while spots remain.</p>
                    </div>
                  ) : (
                    <p style="margin:0.25rem 0 0;">
                      <span style="font-size:1.9rem; font-weight:800; letter-spacing:-0.03em;">{plan.price}</span>
                      <span style="color:var(--text-muted);">{plan.cadence}</span>
                    </p>
                  )}
                  <p style="color:var(--text-muted); font-size:0.9rem; margin:0.5rem 0 0;">{plan.sites} · {plan.cu}</p>
                  <p style="margin:0.75rem 0 0;">{founderApplies && isOperations ? plan.founderBlurb : plan.blurb}</p>
                  <ul style="padding-left:1.1rem; margin:1rem 0 1.25rem; color:var(--text);">
                    {plan.points.map((p) => <li style="margin-bottom:0.4rem;">{p}</li>)}
                  </ul>
                  {plan.cta === "checkout" ? (
                    <button
                      class="btn btn-green btn-cta"
                      type="button"
                      data-plan={checkoutPlanKey}
                      data-regular-plan={plan.key}
                      style="width:100%; justify-content:center;"
                    >
                      <Label text="_join_now" />
                    </button>
                  ) : (
                    <a class="btn btn-ghost" href="/contact" style="width:100%; justify-content:center;">contact sales</a>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
      <p style="margin-top:1.25rem; color:var(--text-muted); max-width:62ch;">
        We prepare website updates for you, keep request status visible, and get your approval before changes go live.
        Founder pricing is locked in while your account remains active. Plans differ in monthly Website Requests and the number of websites covered.
      </p>
    </div>
  </section>

  <!-- Website Requests explainer -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_website_requests" /></p>
      <h2>How Website Requests work</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Website Requests measure the effort of each request, so you always know what's included in your
        website project. Monthly Website Requests refresh every month and do not roll over. Need more in
        a busy month? Add a top-up anytime.
      </p>
      <div class="card" style="margin-top:1rem;">
        <h3 style="margin-top:0;">Credit policy</h3>
        <ul style="margin:0; padding-left:1.1rem; color:var(--text-muted);">
          <li>Monthly Website Requests refresh each month and do not roll over.</li>
          <li>Purchased top-up credits stay on your account until used.</li>
          <li>Top-up credits do roll over and are used after monthly credits run out.</li>
        </ul>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem;">
        {
          ADDONS.map((a) => (
            <div class="card">
              <h3 style="margin-top:0;">{a.name}</h3>
              <p style="color:var(--text-muted); margin:0;">{a.note}</p>
              {a.key.startsWith("topup_") ? (
                <p style="margin:1rem 0 0;">
                  <button class="btn btn-green" data-addon={a.key}><Label text="buy_top_up" /></button>
                </p>
              ) : null}
            </div>
          ))
        }
      </div>
      <p style="margin-top:1rem; color:var(--text-muted); font-size:0.9rem;">
        Top-ups and DNS assistance are available to active customers from your account after you join.
      </p>
    </div>
  </section>

  <!-- Account ownership -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_you_own_it" /></p>
      <h2>{ACCOUNT_OWNERSHIP.headline}</h2>
      <p class="lede" style="margin-top:0.75rem;">{ACCOUNT_OWNERSHIP.detail}</p>
      <ul style="margin:1rem 0 0; padding-left:1.1rem; color:var(--text);">
        {ACCOUNT_OWNERSHIP.accounts.map((a) => <li style="margin-bottom:0.4rem;">{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Questions, answered.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Cost, Website Requests, top-ups, getting started, and custom plans.
      </p>
      <Faq items={PRICING_PAGE_FAQS} />
      <p style="margin-top:1.25rem;">
        <a href="/faqs" style="font-weight:600;"><Label text="see_all_questions" /> →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container cta-card cta-card--founder">
      <div>
        <p class="kicker"><Label text="_next_step" /></p>
        <h2>Ready to secure your Founder Website Package?</h2>
        <p>
          Start with the $500 website build, then keep your site supported for $199/month while your account remains active.
        </p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={WEBSITE_PACKAGE.ctaHref}>Build My Website</a>
        <a class="btn btn-ghost" href="/templates">View Sample Sites</a>
        <a class="btn btn-ghost" href="/templates/sample/back-office/">Preview Back Office</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ CHECKOUT_URL, fallback: CONTACT.email }}>
    document.addEventListener("click", async (e) => {
      const btn = e.target.closest("[data-plan], [data-addon]");
      if (!btn) return;
      e.preventDefault();
      const plan = btn.getAttribute("data-plan");
      const addon = btn.getAttribute("data-addon");
      if (window.wssTrack) {
        window.wssTrack("click_pricing", { plan: plan || "", addon: addon || "" });
      }
      if (!CHECKOUT_URL) {
        window.location.href = "/contact";
        return;
      }
      const original = btn.innerHTML;
      btn.setAttribute("disabled", "true");
      btn.textContent = "redirecting…";
      try {
        const res = await fetch(CHECKOUT_URL, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(plan ? { plan } : { addon }),
        });
        const data = await res.json();
        if (data && data.url) {
          window.location.href = data.url;
          return;
        }
        window.location.href = "/contact";
      } catch (_) {
        window.location.href = "/contact";
      } finally {
        btn.removeAttribute("disabled");
        btn.innerHTML = original;
      }
    });
  </script>
</BaseLayout>
