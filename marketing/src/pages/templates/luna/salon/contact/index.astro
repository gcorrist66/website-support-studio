---
import MarigoldManeLayout from "../../../../../components/MarigoldManeLayout.astro";
import { marigold, marigoldServices } from "../../../../../marigoldMane";
---
<MarigoldManeLayout title="Contact — MH Electrical and Solar" description="Service request page for MH Electrical and Solar." path="/templates/luna/salon/contact">
  <section class="mm-section mm-hero">
    <div class="mm-container">
      <p class="mm-sample">{marigold.badge}</p>
      <p class="mm-eyebrow">Contact</p>
      <h1>Request your electrical project estimate.</h1>
      <p class="mm-lede">Share your project details and preferred timing so we can set up a follow-up quickly.</p>
    </div>
  </section>
  <section class="mm-section mm-soft" id="appointment">
    <div class="mm-container mm-split">
      <form class="mm-card mm-form" id="marigold-form">
        <h2>Service request</h2>
        <label>Name<input name="name" required /></label>
        <label>Email<input name="email" type="email" required /></label>
        <label>Service<select name="service" required><option value="">Choose one</option>{marigoldServices.map((service) => <option>{service.name}</option>)}</select></label>
        <label>Project details<textarea name="notes"></textarea></label>
        <button class="mm-btn mm-btn-primary" type="submit">Send Request</button>
        <p id="marigold-status" role="status" style="min-height:1.2rem; margin:0;"></p>
      </form>
      <div class="mm-card">
        <h2>Visit details</h2>
        <p>{marigold.city}, {marigold.state}</p>
        <p>Rating: {marigold.ratingValue} · Reviews: {marigold.reviewCount}</p>
      </div>
    </div>
  </section>
  <script is:inline>
    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== "marigold-form") return;
      event.preventDefault();
      const status = document.getElementById("marigold-status");
      if (status instanceof HTMLElement) status.textContent = "Thanks for your request. A team member will follow up with the next step.";
    });
  </script>
</MarigoldManeLayout>
