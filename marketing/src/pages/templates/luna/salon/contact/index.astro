---
import MarigoldManeLayout from "../../../../../components/MarigoldManeLayout.astro";
import { marigold, marigoldServices } from "../../../../../marigoldMane";
---
<MarigoldManeLayout title="Contact — Marigold & Mane" description="Contact and appointment request page for the fictional Marigold & Mane sample salon website." path="/templates/luna/salon/contact">
  <section class="mm-section mm-hero"><div class="mm-container"><p class="mm-sample">{marigold.badge}</p><p class="mm-eyebrow">Contact</p><h1>Request an appointment.</h1><p class="mm-lede">Tell Marigold & Mane what you are considering and the sample salon will reply with next steps. This form is non-submitting for demo safety.</p></div></section>
  <section class="mm-section mm-soft" id="appointment"><div class="mm-container mm-split"><form class="mm-card mm-form" id="marigold-form"><h2>Appointment request</h2><label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label><label>Service<select name="service" required><option value="">Choose one</option>{marigoldServices.map((service) => <option>{service.name}</option>)}</select></label><label>What are you hoping for?<textarea name="notes"></textarea></label><button class="mm-btn mm-btn-primary" type="submit">Send Request</button><p id="marigold-status" role="status" style="min-height:1.2rem; margin:0;"></p></form><div class="mm-card"><h2>Visit details</h2><p>{marigold.address}</p><p><a href={marigold.phoneHref}>{marigold.phoneLabel}</a></p><ul class="mm-info-list">{marigold.hours.map((hour) => <li>{hour}</li>)}</ul></div></div></section>
  <script is:inline>document.addEventListener("submit",(event)=>{const form=event.target;if(!(form instanceof HTMLFormElement)||form.id!=="marigold-form")return;event.preventDefault();const status=document.getElementById("marigold-status");if(status instanceof HTMLElement)status.textContent="This is a sample business form. Production lead capture is added during the real build.";});</script>
</MarigoldManeLayout>
