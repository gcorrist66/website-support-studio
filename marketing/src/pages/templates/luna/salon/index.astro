---
import MarigoldManeLayout from "../../../../components/MarigoldManeLayout.astro";
import { marigold, marigoldServices, marigoldGallery, marigoldTrust } from "../../../../marigoldMane";
---
<MarigoldManeLayout title="Marigold & Mane — Sample Salon Website" description="A sales-ready sample salon website for Marigold & Mane with services, gallery, story, hours, location, and appointment paths." path="/templates/luna/salon">
  <section class="mm-section mm-hero"><div class="mm-container mm-hero-grid"><div><p class="mm-sample">{marigold.badge}</p><p class="mm-eyebrow">{marigold.location}</p><h1>Color that grows out softly.</h1><p class="mm-lede">{marigold.tagline} A calm, appointment-only salon for lived-in blonding, dimensional color, and cuts that still feel like you.</p><div class="mm-actions"><a class="mm-btn mm-btn-primary" href="/templates/luna/salon/contact#appointment">Request Appointment</a><a class="mm-btn mm-btn-secondary" href="/templates/luna/salon/services">View Services</a><a class="mm-btn mm-btn-quiet" href={marigold.checkoutHref} data-ga-event="click_marigold_home_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a></div></div><figure class="mm-photo-card"><img src={marigold.heroImage} alt={marigold.heroAlt} width="1400" height="980" loading="eager" /><figcaption class="mm-caption">{marigold.name} · fictional salon sample</figcaption></figure></div></section>
  <section class="mm-section mm-soft"><div class="mm-container"><p class="mm-eyebrow">Services</p><h2>Simple menu. Clear next step.</h2><div class="mm-card-grid">{marigoldServices.slice(0, 3).map((service) => <article class="mm-card"><h3>{service.name}</h3><p class="mm-price">{service.price} · {service.time}</p><p>{service.body}</p></article>)}</div><div class="mm-actions"><a class="mm-btn mm-btn-secondary" href="/templates/luna/salon/services">See full service menu</a></div></div></section>
  <section class="mm-section"><div class="mm-container mm-split"><div><p class="mm-eyebrow">Meet the stylist</p><h2>A quieter salon experience, designed around maintenance you can keep.</h2><p>Marigold & Mane is written as a small owner-led salon, not a chain. The sample story focuses on thoughtful consultations, natural grow-out, and clear appointment planning so the website feels ready for a real stylist to personalize.</p><div class="mm-actions"><a class="mm-btn mm-btn-secondary" href="/templates/luna/salon/about">Read the story</a></div></div><div class="mm-card"><h3>Why guests book</h3><ul class="mm-info-list">{marigoldTrust.map((item) => <li>{item}</li>)}</ul></div></div></section>
  <section class="mm-section mm-soft"><div class="mm-container"><p class="mm-eyebrow">Gallery</p><h2>Enough visual proof to feel real without fake results.</h2><div class="mm-gallery-grid">{marigoldGallery.slice(0, 3).map((item) => <div class="mm-gallery-tile">{item}</div>)}</div><div class="mm-actions"><a class="mm-btn mm-btn-secondary" href="/templates/luna/salon/gallery">View gallery</a></div></div></section>
  <section class="mm-section"><div class="mm-container mm-split"><div><p class="mm-eyebrow">Visit</p><h2>Hyde Park salon sample with hours, location, and appointment flow.</h2><p>{marigold.address}</p><ul class="mm-info-list">{marigold.hours.map((hour) => <li>{hour}</li>)}</ul></div><div class="mm-card"><h3>Ready to request a time?</h3><p>Send the service you have in mind and the sample salon will reply with timing and next steps.</p><div class="mm-actions"><a class="mm-btn mm-btn-primary" href="/templates/luna/salon/contact#appointment">Request Appointment</a></div></div></div></section>
</MarigoldManeLayout>
