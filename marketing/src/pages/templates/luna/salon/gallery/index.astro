---
import MarigoldManeLayout from "../../../../../components/MarigoldManeLayout.astro";
import { marigold, marigoldGallery } from "../../../../../marigoldMane";
---
<MarigoldManeLayout title="Gallery — MH Electrical and Solar" description="Project planning example gallery for MH Electrical and Solar." path="/templates/luna/salon/gallery">
  <section class="mm-section mm-hero">
    <div class="mm-container">
      <p class="mm-sample">{marigold.badge}</p>
      <p class="mm-eyebrow">Gallery</p>
      <h1>Project planning examples only.</h1>
      <p class="mm-lede">This gallery uses representative planning snapshots to show typical project options.</p>
    </div>
  </section>
  <section class="mm-section mm-soft">
    <div class="mm-container">
      <div class="mm-gallery-grid">{marigoldGallery.map((item) => <div class="mm-gallery-tile">{item}</div>)}</div>
      <div class="mm-actions"><a class="mm-btn mm-btn-primary" href="/templates/luna/salon/contact#appointment">Request Appointment</a></div>
    </div>
  </section>
</MarigoldManeLayout>
