---
import WillowThreadLayout from "../../../../components/WillowThreadLayout.astro";
import { willow, willowCollections, willowGallery, willowTrust } from "../../../../willowThread";
---
<WillowThreadLayout title="Willow Thread — Sample Boutique Website" description="A sales-ready sample boutique website for Willow Thread with collections, visit details, story, and contact paths." path="/templates/luna/boutique">
  <section class="wt-section wt-hero"><div class="wt-container wt-hero-grid"><div><p class="wt-sample">{willow.badge}</p><p class="wt-eyebrow">{willow.location}</p><h1>Easy pieces for warm days.</h1><p class="wt-lede">{willow.tagline} A calm local boutique for linen layers, small gifts, and pieces that feel personal.</p><div class="wt-actions"><a class="wt-btn wt-btn-primary" href="/templates/luna/boutique/collections">Shop Collections</a><a class="wt-btn wt-btn-secondary" href="/templates/luna/boutique/visit">Plan Your Visit</a><a class="wt-btn wt-btn-quiet" href={willow.checkoutHref} data-ga-event="click_willow_home_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a></div></div><figure class="wt-photo-card"><img src={willow.heroImage} alt={willow.heroAlt} width="1400" height="980" loading="eager" /><figcaption class="wt-caption">{willow.name} · fictional boutique sample</figcaption></figure></div></section>
  <section class="wt-section wt-soft"><div class="wt-container"><p class="wt-eyebrow">Collections</p><h2>Clear categories that make a small shop feel easy to browse.</h2><div class="wt-card-grid">{willowCollections.slice(0, 3).map((item) => <article class="wt-card"><h3>{item.name}</h3><p class="wt-price">{item.price}</p><p>{item.body}</p></article>)}</div><div class="wt-actions"><a class="wt-btn wt-btn-secondary" href="/templates/luna/boutique/collections">See all collections</a></div></div></section>
  <section class="wt-section"><div class="wt-container wt-split"><div><p class="wt-eyebrow">Boutique story</p><h2>A local shop needs atmosphere, not just product boxes.</h2><p>Willow Thread is written like a real neighborhood boutique: clear collections, shopping hours, parking details, giftable categories, and a simple path for product questions or styling help.</p><div class="wt-actions"><a class="wt-btn wt-btn-secondary" href="/templates/luna/boutique/about">Read the story</a></div></div><div class="wt-card"><h3>Why shoppers visit</h3><ul class="wt-info-list">{willowTrust.map((item) => <li>{item}</li>)}</ul></div></div></section>
  <section class="wt-section wt-soft"><div class="wt-container"><p class="wt-eyebrow">Shop moments</p><h2>Enough visual direction to feel like a real retail space.</h2><div class="wt-gallery-grid">{willowGallery.slice(0, 3).map((item) => <figure class="wt-gallery-tile"><img src={item.img} alt={item.caption} loading="lazy" /><figcaption class="wt-caption">{item.caption}</figcaption></figure>)}</div></div></section>
  <section class="wt-section"><div class="wt-container wt-split"><div><p class="wt-eyebrow">Visit</p><h2>Downtown St. Pete boutique sample with hours and location.</h2><p>{willow.address}</p><ul class="wt-info-list">{willow.hours.map((hour) => <li>{hour}</li>)}</ul></div><div class="wt-card"><h3>Have a product or styling question?</h3><p>Use the contact page to ask about sizing, a collection, a gift idea, or what is currently in store.</p><div class="wt-actions"><a class="wt-btn wt-btn-primary" href="/templates/luna/boutique/contact#question">Contact Willow Thread</a></div></div></div></section>
</WillowThreadLayout>
