---
import WillowThreadLayout from "../../../../../components/WillowThreadLayout.astro";
import { willow, willowCollections } from "../../../../../willowThread";

const mapPins = [
  { area: "Downtown St. Pete", x: 50, y: 48 },
  { area: "Old Northeast", x: 66, y: 62 },
  { area: "Downtown Tampa", x: 41, y: 72 },
];

const neighborhoods = ["Downtown St. Pete", "Old Northeast", "Waterfront", "Gandy", "Grand Central"];
---
<WillowThreadLayout title="Contact — Willow Thread" description="Contact page for the fictional Willow Thread sample boutique website." path="/templates/luna/boutique/contact">
  <section class="wt-section wt-hero">
    <div class="wt-container">
      <p class="wt-sample">{willow.badge}</p>
      <p class="wt-eyebrow">Contact</p>
      <h1>Ask about sizing, gifts, or what is in store.</h1>
      <p class="wt-lede">Send a simple note about a collection, a product question, or a visit. This form is non-submitting for demo safety.</p>
    </div>
  </section>
  <section class="wt-section wt-soft" id="question">
    <div class="wt-container wt-split">
      <form class="wt-card wt-form" id="willow-form">
        <h2>Boutique question</h2>
        <label>Name<input name="name" required /></label>
        <label>Email<input name="email" type="email" required /></label>
        <label>
          Topic
          <select name="topic" required>
            <option value="">Choose one</option>
            {willowCollections.slice(0, 5).map((item) => <option>{item.name}</option>)}
            <option>General question</option>
          </select>
        </label>
        <label>What should Willow Thread know?
          <textarea name="notes"></textarea>
        </label>
        <button class="wt-btn wt-btn-primary" type="submit">Send Question</button>
        <p id="willow-status" role="status" style="min-height:1.2rem; margin:0;"></p>
      </form>
      <div class="wt-card">
        <h2>Visit details</h2>
        <p>{willow.address}</p>
        <p><a href={willow.phoneHref}>{willow.phoneLabel}</a></p>
        <ul class="wt-info-list">
          {willow.hours.map((hour) => <li>{hour}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="wt-section">
    <div class="wt-container">
      <p class="wt-eyebrow">Neighborhood coverage</p>
      <h2>Shopping map and parking context</h2>
      <p>Before questions are answered, these sample neighborhoods help confirm local pickup and styling visit context.</p>
      <div class="wt-location-map" role="img" aria-label="Boutique location coverage map">
        <span class="wt-location-label">Downtown St. Petersburg area</span>
        {mapPins.map((pin) => <span class="wt-location-pin" style={`left:${pin.x}%;top:${pin.y}%;`}>{pin.area}</span>)}
      </div>
      <div class="wt-location-chipset">
        {neighborhoods.map((item) => <span>{item}</span>)}
      </div>
      <p style="margin-top:0.75rem;color:var(--wt-muted);">This is sample context only. It supports local relevance without inventing real traffic data or routing.</p>
    </div>
  </section>
  <script is:inline>
    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== "willow-form") return;
      event.preventDefault();
      const status = document.getElementById("willow-status");
      if (status instanceof HTMLElement) {
        status.textContent = "This is a sample business form. Production lead capture is added during the real build.";
      }
    });
  </script>
</WillowThreadLayout>
