---
import MoonroomCoffeeLayout from "../../../../components/MoonroomCoffeeLayout.astro";
import { moonroom, moonroomMenu, moonroomFeatured, moonroomEvents } from "../../../../moonroomCoffee";
---
<MoonroomCoffeeLayout title="Moonroom Coffee — Sample Coffee Shop Website" description="A sales-ready sample coffee shop website for Moonroom Coffee with menu, events, hours, location, and contact paths." path="/templates/luna/coffee-shop">
  <section class="mc-section mc-hero"><div class="mc-container mc-hero-grid"><div><p class="mc-sample">{moonroom.badge}</p><p class="mc-eyebrow">{moonroom.location}</p><h1>Coffee for soft mornings.</h1><p class="mc-lede">{moonroom.tagline} A neighborhood room for first cups, quick meetings, pastry runs, and weekend pop-ups.</p><div class="mc-actions"><a class="mc-btn mc-btn-primary" href="/templates/luna/coffee-shop/menu">View Menu</a><a class="mc-btn mc-btn-secondary" href="/templates/luna/coffee-shop/contact#visit">Plan Your Visit</a><a class="mc-btn mc-btn-quiet" href={moonroom.checkoutHref} data-ga-event="click_moonroom_home_style" data-ga-secondary-event="stripe_payment_link_click">Use This Website Style</a></div></div><figure class="mc-photo-card"><img src={moonroom.heroImage} alt={moonroom.heroAlt} width="1400" height="980" loading="eager" /><figcaption class="mc-caption">{moonroom.name} · fictional coffee shop sample</figcaption></figure></div></section>
  <section class="mc-section mc-soft"><div class="mc-container"><p class="mc-eyebrow">Menu highlights</p><h2>Espresso, cold brew, and the pastry case people remember.</h2><div class="mc-card-grid">{moonroomMenu.slice(0, 3).map((item) => <article class="mc-card"><h3>{item.name}</h3><p class="mc-price">{item.price}</p><p>{item.body}</p></article>)}</div><div class="mc-actions"><a class="mc-btn mc-btn-secondary" href="/templates/luna/coffee-shop/menu">See full menu</a></div></div></section>
  <section class="mc-section"><div class="mc-container mc-split"><div><p class="mc-eyebrow">Neighborhood rhythm</p><h2>A real coffee site needs more than a pretty cup.</h2><p>Moonroom Coffee is written like a local cafe people can picture visiting: hours, menu, seating, events, and a simple way to ask about catering or community pop-ups.</p><div class="mc-actions"><a class="mc-btn mc-btn-secondary" href="/templates/luna/coffee-shop/events">See events</a></div></div><div class="mc-card"><h3>Why neighbors stop in</h3><ul class="mc-info-list">{moonroomFeatured.slice(0, 4).map((item) => <li>{item.caption}</li>)}</ul></div></div></section>
  <section class="mc-section mc-soft"><div class="mc-container"><p class="mc-eyebrow">Community</p><h2>Events that make the shop feel alive.</h2><div class="mc-card-grid">{moonroomEvents.map((event) => <article class="mc-card"><h3>{event.title}</h3><p>{event.body}</p></article>)}</div></div></section>
  <section class="mc-section"><div class="mc-container mc-split"><div><p class="mc-eyebrow">Visit</p><h2>Seminole Heights coffee shop sample with hours and location.</h2><p>{moonroom.address}</p><ul class="mc-info-list">{moonroom.hours.map((hour) => <li>{hour}</li>)}</ul></div><div class="mc-card"><h3>Planning a visit or small event?</h3><p>Use the contact page to ask about coffee boxes, weekend pop-ups, or a simple neighborhood gathering.</p><div class="mc-actions"><a class="mc-btn mc-btn-primary" href="/templates/luna/coffee-shop/contact#visit">Contact Moonroom</a></div></div></div></section>
</MoonroomCoffeeLayout>
