---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { WEBSITE_PACKAGE } from "../../../consts";
import { lunaDesignLanguage, lunaVariantList } from "../../../luna";
---

<BaseLayout
  title="Luna Design System — Salon, Coffee Shop, Boutique"
  description="Explore the Luna design system and see how one warm, image-led website style adapts across salon, coffee shop, and boutique businesses."
  path="/templates/luna"
>
  <main class="luna-overview">
    <section class="hero">
      <div class="container" style="max-width:900px;">
        <p class="demo-disclaimer">Design system demo · Fictional businesses</p>
        <p class="kicker">Luna design system</p>
        <h1>One warm website style. Three different businesses.</h1>
        <p class="lede">{lunaDesignLanguage.thesis} Luna proves the Website Support Studio model: choose a style you like, then adapt it to the business you actually run.</p>
        <div class="hero-actions">
          <a class="btn btn-green btn-cta" href={WEBSITE_PACKAGE.ctaHref} data-ga-event="click_luna_overview_build" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
          <a class="btn btn-ghost" href={WEBSITE_PACKAGE.ctaHref} data-ga-event="click_luna_overview_start" data-ga-secondary-event="stripe_payment_link_click">Start With Luna</a>
          <a class="btn btn-ghost" href="/templates/luna/salon">View Luna Salon</a>
          <a class="btn btn-ghost" href="/templates/luna/coffee-shop">View Coffee Shop</a>
          <a class="btn btn-ghost" href="/templates/luna/boutique">View Boutique</a>
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container">
        <p class="kicker">Design language</p>
        <h2>{lunaDesignLanguage.personality}</h2>
        <p class="lede">{lunaDesignLanguage.visualStyle}</p>
        <div class="grid grid-2" style="margin-top:2rem; align-items:start;">
          <div class="card">
            <h3>What stays consistent</h3>
            <ul>
              {lunaDesignLanguage.staysConsistent.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="card">
            <h3>What changes</h3>
            <ul>
              {lunaDesignLanguage.changesByBusiness.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="kicker">Adaptations</p>
        <h2>Same Luna system, different business type.</h2>
        <div class="grid grid-3" style="margin-top:2rem;">
          {lunaVariantList.map((variant) => (
            <article class="card luna-overview-card">
              <img src={variant.image} alt={variant.imageAlt} width="900" height="620" loading="lazy" />
              <p class="marker">{variant.name}</p>
              <h3>{variant.businessName}</h3>
              <p>{variant.description}</p>
              <a class="btn btn-green" href={`/templates/luna/${variant.key}`}>Open {variant.name}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container" style="max-width:900px;">
        <p class="kicker">This design system can also become...</p>
        <h2>Salon, coffee shop, boutique today. Your business next.</h2>
        <p class="lede">Luna keeps the warm visual system and adapts the copy, photos, sections, and CTAs around the business type.</p>
        <div class="hero-actions">
          <a class="btn btn-ghost" href="/templates/luna/salon">View Luna Salon</a>
          <a class="btn btn-ghost" href="/templates/luna/coffee-shop">View Luna Coffee</a>
          <a class="btn btn-ghost" href="/templates/luna/boutique">View Luna Boutique</a>
        </div>
      </div>
    </section>

    <div class="luna-overview-sticky" aria-label="Start Luna website">
      <a href={WEBSITE_PACKAGE.ctaHref} data-ga-event="click_luna_overview_mobile_sticky" data-ga-secondary-event="stripe_payment_link_click">Start With Luna</a>
    </div>
  </main>

  <style is:inline>
    .demo-disclaimer {
      display: inline-block;
      border: 1px dashed var(--border-strong);
      color: var(--text-muted);
      border-radius: 999px;
      padding: 0.35rem 0.72rem;
      font-size: 0.82rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .luna-overview-card img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 11;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid var(--border);
      margin-bottom: 1rem;
    }
    .luna-overview-sticky {
      display: none;
    }
    @media (max-width: 900px) {
      .luna-overview-sticky {
        position: fixed;
        z-index: 80;
        left: 0.75rem;
        right: 0.75rem;
        bottom: 0.75rem;
        display: block;
        padding: 0.35rem;
        border-radius: 999px;
        background: rgba(250,250,247,0.92);
        border: 1px solid var(--border-strong);
        box-shadow: 0 16px 40px rgba(11,18,32,0.22);
        backdrop-filter: blur(10px);
      }
      .luna-overview-sticky a {
        display: flex;
        justify-content: center;
        border-radius: 999px;
        padding: 0.9rem 1rem;
        background: var(--cta-green);
        color: var(--text-strong);
        font-weight: 900;
      }
    }
  </style>
</BaseLayout>
