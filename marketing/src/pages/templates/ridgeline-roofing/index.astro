---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const townList = ["Denver", "Aurora", "Lakewood", "Golden", "Arvada", "Englewood", "Commerce City", "Wheat Ridge", "Centennial", "Westminster", "Broomfield", "Parker"]; 

const roofingImages = {
  hero: "https://images.unsplash.com/photo-1635424824849-1b09bdcc55b1?auto=format&fit=crop&w=1200&q=82",
  replacement: "https://images.unsplash.com/photo-1643225523483-e2c434191bba?auto=format&fit=crop&w=700&q=80",
  repair: "https://images.unsplash.com/photo-1634853982486-c06f0e17940f?auto=format&fit=crop&w=700&q=80",
  storm: "https://images.unsplash.com/photo-1657878054629-28cf610801bf?auto=format&fit=crop&w=700&q=80",
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: "Ridgeline Roofing",
  url: "https://websitesupportstudio.com/templates/ridgeline-roofing",
  description: "Residential roofing services for Denver-area homeowners, including repairs, replacements, and storm recovery support.",
  areaServed: {
    "@type": "City",
    name: "Denver",
    addressRegion: "Colorado",
    addressCountry: "US",
  },
  telephone: "+13035550198",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Denver Metro Demo Area",
    addressLocality: "Denver",
    addressRegion: "CO",
    postalCode: "80202",
    addressCountry: "US",
  },
  sameAs: [
    "https://www.websitesupportstudio.com/contact",
  ],
};
---

<BaseLayout
  title="Ridgeline Roofing — Model Home Demo"
  description="Fictional model website for a Denver residential roofing company. Use this as a sample of a finished $500 Founder Website Package result."
  path="/templates/ridgeline-roofing"
>
  <main>
    <section class="hero" style="padding-top:1.35rem;">
      <div class="container demo-hero-layout">
        <div>
          <p class="demo-disclaimer">Demo website · Fictional demo company</p>
          <p class="roofing-badge" aria-label="Roofing business indicator">[Residential Roofing]</p>
          <h1>Denver Roofing That Stays Solid Through Every Season.</h1>
          <p class="lede">
            Ridgeline Roofing provides residential roof replacement, repair, and storm response in Denver and surrounding neighborhoods. Every section below is sample copy for the Founder Website Package model home.
          </p>
          <div class="hero-actions">
            <a class="btn btn-green btn-cta" href="tel:+13035550198" data-ga-event="demo_call">Call Now</a>
            <a class="btn btn-ghost" href="/templates/ridgeline-roofing/contact" data-ga-event="demo_schedule_inspection">Schedule Inspection</a>
            <a class="btn btn-ghost" href="/templates/ridgeline-roofing/contact#estimate" data-ga-event="demo_estimate">Request a Roof Estimate</a>
          </div>
        </div>
        <div class="roof-photo-panel">
          <img src={roofingImages.hero} alt="Roofer working on a residential shingle roof" width="1200" height="800" loading="eager" />
          <div class="roof-photo-caption">Residential roof work · Denver model-home demo</div>
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container">
        <p class="kicker">Frictionless sample</p>
        <h2>Services homeowners asked for most</h2>
        <div class="demo-grid">
          <article class="card">
            <img class="service-photo" src={roofingImages.replacement} alt="Roofing materials carried across a residential roof" width="700" height="430" loading="lazy" />
            <p class="service-mini-card-label">[Roof Replacement]</p>
            <h3 style="margin-top:0;">Roof Replacement</h3>
            <p style="margin:0.45rem 0 0; color:var(--text-muted);">Full roof system replacement and material guidance for Denver-area weather and exposure patterns.</p>
            <a class="btn btn-ghost" href="/templates/ridgeline-roofing/services#services">See details</a>
          </article>
          <article class="card">
            <img class="service-photo" src={roofingImages.repair} alt="Rainwater running over roof shingles during a leak inspection" width="700" height="430" loading="lazy" />
            <p class="service-mini-card-label">[Roof Repair]</p>
            <h3 style="margin-top:0;">Roof Repair</h3>
            <p style="margin:0.45rem 0 0; color:var(--text-muted);">Leak fixes, flashing repair, shingle lift corrections, and storm-breathing vent checks.</p>
            <a class="btn btn-ghost" href="/templates/ridgeline-roofing/services#services">See details</a>
          </article>
          <article class="card">
            <img class="service-photo" src={roofingImages.storm} alt="Heavy rain falling on a metal roof during a storm" width="700" height="430" loading="lazy" />
            <p class="service-mini-card-label">[Storm Damage]</p>
            <h3 style="margin-top:0;">Storm Damage</h3>
            <p style="margin:0.45rem 0 0; color:var(--text-muted);">Same-day triage after hail or wind events with temporary protection planning and photos for claims.</p>
            <a class="btn btn-ghost" href="/templates/ridgeline-roofing/services#services">See details</a>
          </article>
          <article class="card">
            <img class="service-photo" src={roofingImages.hero} alt="Roofing contractor inspecting shingles on a home" width="700" height="430" loading="lazy" />
            <p class="service-mini-card-label">[Insurance Claims]</p>
            <h3 style="margin-top:0;">Insurance Claim Support</h3>
            <p style="margin:0.45rem 0 0; color:var(--text-muted);">Clear documentation support for claims teams and transparent communication during adjustments.</p>
            <a class="btn btn-ghost" href="/templates/ridgeline-roofing/services#services">See details</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="kicker">Trust points</p>
        <h2>How Ridgeline Roofing builds confidence</h2>
        <div class="demo-grid demo-checks">
          <p class="card" style="margin:0;">Sample trust signals are written for clarity: local process, response priorities, and estimate flow.</p>
          <p class="card" style="margin:0;">Fast callback promise: initial response within one business day.</p>
          <p class="card" style="margin:0;">Service in Denver, Aurora, Lakewood, Golden, and Englewood.</p>
          <p class="card" style="margin:0;">Clear estimate walk-through and invoice-friendly follow-up notes.</p>
        </div>
        <div class="cta-line">
          <a class="btn btn-green" href="/templates/ridgeline-roofing/services">Browse all services</a>
          <a class="btn btn-ghost" href="/templates/ridgeline-roofing/service-area">Service area details</a>
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container">
        <p class="marker">Service area coverage</p>
        <p class="lede" style="margin-top:0.45rem;">Denver metro households and neighborhoods we can model around:</p>
        <div class="demo-list">
          {townList.map((town) => <span>{town}</span>)}
        </div>
        <p style="margin-top:0.9rem; color:var(--text-muted);">Demo route for model-home reference only. <strong>Not an actual customer profile.</strong></p>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container">
        <p class="kicker">Urgent support</p>
        <h2>Storm, leak, or active exposure? Call first.</h2>
        <p class="lede" style="max-width:64ch;">Urgent service is surfaced early so homeowners see the fastest path before reading long service details.</p>
        <div class="hero-actions" style="margin-top:0.95rem;">
          <a class="btn btn-green btn-cta" href="tel:+13035550198" data-ga-event="demo_call_urgent">Call Now</a>
          <a class="btn btn-ghost" href="/templates/ridgeline-roofing/contact#estimate">Request estimate details</a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />

    <style is:inline>
    .demo-disclaimer {
      display: inline-block;
      border: 1px dashed var(--border-strong);
      color: var(--text-muted);
      border-radius: 999px;
      padding: 0.35rem 0.72rem;
      font-size: 0.82rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .demo-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 1rem;
    }
    .demo-hero-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
      gap: 2rem;
      align-items: center;
    }
    .roof-photo-panel {
      position: relative;
      overflow: hidden;
      min-height: 275px;
      border: 1px solid var(--border-strong);
      border-radius: 14px;
      background: #0b1220;
      box-shadow: 0 18px 42px rgba(15, 23, 42, 0.18);
    }
    .roof-photo-panel img,
    .service-photo {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .roof-photo-caption {
      position: absolute;
      left: 1rem;
      bottom: 1rem;
      max-width: calc(100% - 2rem);
      border-radius: 999px;
      background: rgba(11, 18, 32, 0.82);
      color: #fff7ed;
      padding: 0.42rem 0.7rem;
      font-size: 0.78rem;
      font-weight: 700;
    }
    .service-photo {
      aspect-ratio: 16 / 10;
      height: auto;
      border-radius: 8px;
      max-height: 190px;
      margin-bottom: 0.9rem;
      border: 1px solid var(--border);
    }
    .demo-checks {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: start;
    }
    .demo-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .demo-list span {
      padding: 0.24rem 0.55rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--text);
      background: var(--surface-elevated);
      font-size: 0.86rem;
    }
    .cta-line {
      margin-top: 1.1rem;
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .roofing-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid var(--border);
      color: var(--text-muted);
      background: var(--surface-elevated);
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      margin-bottom: 0.8rem;
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .service-mini-card-label {
      margin: 0 0 0.65rem;
      font-weight: 700;
      color: var(--brand-blue);
      letter-spacing: 0.02em;
    }
    .demo-grid .card .btn {
      margin-top: 0.8rem;
    }
    .demo-checks .card {
      margin: 0;
      min-height: 95px;
      display: flex;
      align-items: center;
      color: var(--text);
    }

    @media (max-width: 800px) {
      .demo-hero-layout {
        grid-template-columns: 1fr;
      }
      .roof-photo-panel {
        min-height: 220px;
      }
      .demo-grid,
      .demo-checks {
        grid-template-columns: 1fr;
      }
      .hero-actions {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
