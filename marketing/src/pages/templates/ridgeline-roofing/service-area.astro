---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const serviceAreas = [
  { city: "Denver", neighborhoods: ["Downtown", "Cap Hill", "Stapleton", "Highland", "Cherry Creek"] },
  { city: "Aurora", neighborhoods: ["Aurora Central", "Skyline", "Green Valley Ranch"] },
  { city: "Lakewood", neighborhoods: ["Downtown Lakewood", "Cultural District", "Morrison"] },
  { city: "Golden", neighborhoods: ["Downtown Golden", "Foothills"] },
  { city: "Englewood", neighborhoods: ["Cherry Hills", "Littleton", "Berkley"] },
  { city: "Commerce City", neighborhoods: ["East Commerce", "Gateway"] },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://websitesupportstudio.com/templates/ridgeline-roofing/service-area",
  name: "Ridgeline Roofing",
  areaServed: serviceAreas.map((item) => item.city),
};
---

<BaseLayout
  title="Ridgeline Roofing Service Area — Model Home"
  description="Denver-area service coverage sample for Ridgeline Roofing model home website. Includes neighborhood-level targeting and local SEO structure."
  path="/templates/ridgeline-roofing/service-area"
>
  <main>
    <section class="hero">
      <div class="container">
        <p class="demo-disclaimer">Demo website · Fictional demo company</p>
        <p class="kicker">Denver local SEO</p>
        <h1>Service Area</h1>
        <p class="lede">Ridgeline Roofing serves the metro areas below for residential roofing, inspections, and emergency response.</p>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container">
        <div class="service-grid">
          {serviceAreas.map((entry) => (
            <article class="card">
              <h3 style="margin-top:0;">{entry.city}</h3>
              <ul style="margin:0.5rem 0 0; padding-left:1.05rem; color:var(--text-muted);">
                {entry.neighborhoods.map((name) => <li>{name}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <p style="margin-top:1rem; color:var(--text-muted);">Sample list shown for demo purposes only. Not a real business record.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Area call-to-action</h2>
        <p>Residents in any of the listed neighborhoods can request a demo-style estimate request for how this layout behaves on service-area pages.</p>
        <div class="hero-actions">
          <a class="btn btn-green" href="tel:+13035550198" data-ga-event="demo_call_area">Call Now</a>
          <a class="btn btn-ghost" href="/templates/ridgeline-roofing/contact#estimate">Request a Roof Estimate</a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />

  <style is:inline>
    .demo-disclaimer {
      display: inline-block;
      border: 1px dashed var(--border-strong);
      color: var(--text-muted);
      border-radius: 999px;
      padding: 0.35rem 0.72rem;
      font-size: 0.82rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    @media (max-width: 860px) {
      .service-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
