---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqs = [
  {
    q: "Do you handle insurance photos?",
    a: "In this demo model, the service includes documentation-ready photo updates to support homeowner updates and claim communications.",
  },
  {
    q: "Can I get an estimate today?",
    a: "This demo includes an estimate request form and direct call-to-action for a fast sample workflow.",
  },
  {
    q: "Do you serve the Denver metro area?",
    a: "The sample service area includes core Denver, Aurora, Lakewood, Golden, and Englewood neighborhoods.",
  },
];

const contactImage = "https://images.unsplash.com/photo-1635424824849-1b09bdcc55b1?auto=format&fit=crop&w=900&q=82";
const serviceAreas = ["Denver", "Aurora", "Lakewood", "Golden", "Englewood", "Commerce City", "Wheat Ridge", "Broomfield"];
const servicePins = [
  { city: "Denver", x: 72, y: 74 },
  { city: "Aurora", x: 88, y: 116 },
  { city: "Lakewood", x: 44, y: 144 },
  { city: "Golden", x: 26, y: 166 },
  { city: "Englewood", x: 58, y: 170 },
  { city: "Commerce City", x: 94, y: 50 },
  { city: "Wheat Ridge", x: 34, y: 88 },
  { city: "Broomfield", x: 112, y: 95 },
];
---

<BaseLayout
  title="Contact Ridgeline Roofing — Model Home"
  description="Contact page for the Ridgeline Roofing fictional demo. Includes demo CTAs and non-submitting form handling for safe preview."
  path="/templates/ridgeline-roofing/contact"
>
  <main>
    <section class="hero">
      <div class="container">
        <p class="demo-disclaimer">Demo website · Fictional demo company</p>
        <p class="kicker">Contact</p>
        <p class="roofing-badge">[Roof Inspection & Support]</p>
        <h1>Request a Roof Estimate</h1>
        <p class="lede">This page uses safe demo handling with a non-submitting request form for model-home demonstration.</p>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container" style="max-width: 900px;">
        <div class="contact-grid">
          <div class="card">
            <img class="contact-roof-photo" src={contactImage} alt="Roofing contractor inspecting a residential shingle roof" width="900" height="560" loading="lazy" />
            <h2 style="margin-top:0;">Get started</h2>
            <p>Use one of the options below to request help in this demo layout.</p>
            <p><a class="btn btn-green btn-cta" href="tel:+13035550198">Call Now</a> <a class="btn btn-ghost" href="#">Schedule Inspection</a></p>
            <p class="marker" style="margin-top:1rem;">Demo call script: Monday–Friday, 8am–6pm.</p>
            <p style="color:var(--text-muted);">License/insured language is sample-marked to avoid implying real contractor registrations.</p>
          </div>

          <div class="card">
            <h2 style="margin-top:0;">Estimate request</h2>
            <form id="ridgeline-estimate" class="demo-form">
              <label>
                Name
                <input class="input" name="name" required />
              </label>
              <label>
                Email
                <input class="input" name="email" type="email" required />
              </label>
              <label>
                City
                <input class="input" name="city" required />
              </label>
              <label>
                Service Needed
                <select class="input" name="service" required>
                  <option value="">Choose one</option>
                  <option>Roof Replacement</option>
                  <option>Roof Repair</option>
                  <option>Storm Damage</option>
                  <option>Insurance Claim Support</option>
                  <option>Roof Inspection</option>
                  <option>Emergency Tarping</option>
                </select>
              </label>
              <button class="btn btn-green" type="submit">Request a Roof Estimate</button>
              <p id="ridgeline-estimate-status" role="status" style="margin:0; color:var(--text-muted); min-height:1.2rem;"></p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container" style="max-width: 900px;">
        <h2>Common questions</h2>
        <div class="faq" style="margin-top:0.8rem;">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--surface-muted);">
      <div class="container" style="max-width: 900px;">
        <p class="kicker">Service coverage</p>
        <h2>Coverage confirmation before request</h2>
        <p class="service-coverage-copy">
          Visitors can confirm this demo's metro coverage before choosing call or estimate options.
        </p>
        <div class="ridgeline-map" role="img" aria-label="Denver metro service coverage map">
          <span class="ridgeline-map-label">Denver metro service area</span>
          {servicePins.map((item) => <span class="ridgeline-map-pin" style={`left:${item.x}%;top:${item.y}%;`}>{item.city}</span>)}
        </div>
        <div class="service-list" aria-label="Denver-area service coverage cities">
          {serviceAreas.map((item) => <span>{item}</span>)}
        </div>
        <div class="hero-actions" style="margin-top:1rem;">
          <a class="btn btn-green" href="tel:+13035550198" data-ga-event="demo_call_area">Call Now</a>
          <a class="btn btn-ghost" href="/templates/ridgeline-roofing/service-area">View full service area</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== "ridgeline-estimate") return;
      event.preventDefault();
      const status = document.getElementById("ridgeline-estimate-status");
      if (status instanceof HTMLElement) {
        status.textContent = "This is a demo form. Add your production contact flow to capture leads securely.";
      }
    });
  </script>

  <style is:inline>
    .demo-disclaimer {
      display: inline-block;
      border: 1px dashed var(--border-strong);
      color: var(--text-muted);
      border-radius: 999px;
      padding: 0.35rem 0.72rem;
      font-size: 0.82rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .roofing-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid var(--border);
      color: var(--text-muted);
      background: var(--surface-elevated);
      padding: 0.35rem 0.72rem;
      border-radius: 999px;
      margin-bottom: 0.75rem;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .contact-roof-photo {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid var(--border);
      margin-bottom: 1rem;
    }
    .demo-form {
      display: grid;
      gap: 0.8rem;
    }
    label {
      display: grid;
      gap: 0.45rem;
      font-weight: 700;
      color: var(--text-strong);
      font-size: 0.9rem;
    }
    .input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.6rem 0.75rem;
      background: #fff;
      font: inherit;
    }
    .input:focus-visible {
      outline: 2px solid var(--brand-blue);
      outline-offset: 2px;
    }
    .service-coverage-copy {
      margin: 0.85rem 0 0;
      color: var(--text);
      max-width: 62ch;
    }
    .ridgeline-map {
      position: relative;
      margin-top: 0.95rem;
      height: 180px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: linear-gradient(180deg, var(--surface-muted), #f3f6fb);
      overflow: hidden;
    }
    .ridgeline-map-label {
      position: absolute;
      left: 0.75rem;
      top: 0.75rem;
      background: var(--text-strong);
      color: #fff;
      border-radius: 999px;
      padding: 0.22rem 0.56rem;
      font-size: 0.72rem;
      font-family: var(--font-mono);
      font-weight: 800;
      z-index: 1;
    }
    .ridgeline-map-pin {
      position: absolute;
      transform: translate(-50%, -75%);
      transform-origin: center;
      background: var(--brand-blue);
      color: #fff;
      border-radius: 999px;
      padding: 0.15rem 0.42rem;
      font-size: 0.72rem;
      font-family: var(--font-mono);
      font-weight: 800;
      white-space: nowrap;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
    }
    .service-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.95rem;
    }
    .service-list span {
      border: 1px solid var(--border);
      border-radius: 999px;
      background: #fff;
      padding: 0.27rem 0.65rem;
      font-size: 0.84rem;
    }

    @media (max-width: 860px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
      .ridgeline-map {
        height: 155px;
      }
    }
  </style>
</BaseLayout>
