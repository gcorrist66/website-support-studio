---
import RidgelineOwnerPortal from "../../../../components/sample-sites/RidgelineOwnerPortal.astro";
import { SAMPLE_BUSINESSES } from "../../../../sampleBusinesses";

const business = SAMPLE_BUSINESSES.find((item) => item.slug === "brightwire-electric");

if (!business) {
  throw new Error("Brightwire Electric sample business is missing.");
}
---

