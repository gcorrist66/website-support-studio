---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import QueryParamPreserver from "../../../../components/QueryParamPreserver.astro";
import { APP_URL, WEBSITE_PACKAGE } from "../../../../consts";

const summaryCards = [
  { label: "Visits this month", value: "1,248", note: "+18%" },
  { label: "New leads", value: "23", note: "6 this week" },
  { label: "Website Requests", value: "4", note: "2 completed" },
  { label: "Testimonials waiting", value: "2", note: "Needs approval" },
  { label: "Plan status", value: "Active", note: "Founder" },
];

const analytics = [
  { label: "Visits", value: "1,248" },
  { label: "Form submissions", value: "23" },
  { label: "Top page", value: "Services" },
  { label: "Traffic trend", value: "Up 18%" },
];

const leads = [
  { name: "Maya R.", source: "Contact page", date: "Jun 11", status: "New" },
  { name: "Chris D.", source: "Services page", date: "Jun 10", status: "Replied" },
  { name: "Jordan P.", source: "Homepage CTA", date: "Jun 8", status: "Booked" },
];

const requestActions = ["Request update", "Report issue", "Ask for new page", "Send feedback"];

const profileRows = [
  ["Business name", "Marigold & Mane"],
  ["Phone", "(555) 018-2044"],
  ["Email", "hello@example-salon.com"],
  ["Website", "example-salon.com"],
  ["Service area", "Tampa, FL"],
];

const navItems = ["Dashboard", "Analytics", "Leads", "Testimonials", "Website Requests", "Profile", "Plan", "Support"];
---

<BaseLayout
  title="Sample Back Office | Website Support Studio"
  description="Preview a simple fictional customer dashboard for Website Support Studio."
  path="/templates/sample/back-office"
  hideChrome
>
  <main class="backend-preview">
    <div class="backend-frame">
      <aside class="backend-sidebar" aria-label="Sample Back Office navigation">
        <a class="backend-brand" href="/" aria-label="Back to Website Support Studio homepage">
          <span>Website Support Studio</span>
          <small>Sample Back Office</small>
        </a>
        <nav>
          {navItems.map((item, index) => (
            <a href={`#${item.toLowerCase().replaceAll(" ", "-")}`} aria-current={index === 0 ? "page" : undefined}>{item}</a>
          ))}
        </nav>
      </aside>

      <section class="backend-main">
        <header class="backend-topbar">
          <div>
            <p>Sample customer dashboard · Fictional preview data · No real customer data</p>
            <h1>Marigold & Mane Back Office</h1>
          </div>
          <div class="backend-actions">
            <a href={APP_URL} data-track="back-office-log-in-to-wss" data-ga-event="click_backend_preview_login">Log In To WSS</a>
            <a href="/templates" data-track="back-office-view-sample-sites" data-ga-event="click_backend_preview_samples">View Sample Sites</a>
            <a href="/" data-track="back-office-back-to-wss" data-ga-event="click_backend_preview_home">Back to Website Support Studio</a>
          </div>
        </header>

        <section class="widget-grid" id="dashboard" aria-label="Dashboard summary">
          {summaryCards.map((card) => (
            <article class="stat-widget">
              <p>{card.label}</p>
              <strong>{card.value}</strong>
              <span>{card.note}</span>
            </article>
          ))}
        </section>

        <section class="dashboard-grid">
          <article class="panel analytics-panel" id="analytics">
            <div class="panel-head">
              <div>
                <p>Analytics</p>
                <h2>Website activity</h2>
              </div>
              <span>Sample data</span>
            </div>
            <div class="metric-grid">
              {analytics.map((item) => (
                <div>
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </div>
              ))}
            </div>
            <div class="mini-chart" aria-label="Sample traffic trend chart">
              <i style="height:38%"></i>
              <i style="height:54%"></i>
              <i style="height:47%"></i>
              <i style="height:66%"></i>
              <i style="height:76%"></i>
              <i style="height:88%"></i>
            </div>
          </article>

          <article class="panel leads-panel" id="leads">
            <div class="panel-head">
              <div>
                <p>Leads</p>
                <h2>Recent inquiries</h2>
              </div>
              <span>Fictional leads</span>
            </div>
            <table>
              <thead>
                <tr><th>Name</th><th>Source</th><th>Date</th><th>Status</th></tr>
              </thead>
              <tbody>
                {leads.map((lead) => (
                  <tr><td>{lead.name}</td><td>{lead.source}</td><td>{lead.date}</td><td><span>{lead.status}</span></td></tr>
                ))}
              </tbody>
            </table>
          </article>

          <article class="panel" id="testimonials">
            <div class="panel-head compact">
              <div>
                <p>Testimonials</p>
                <h2>Reviews</h2>
              </div>
            </div>
            <div class="review-grid">
              <div><strong>2</strong><span>Pending approval</span></div>
              <div><strong>5</strong><span>Approved</span></div>
              <button type="button">Request testimonial</button>
            </div>
          </article>

          <article class="panel" id="website-requests">
            <div class="panel-head compact">
              <div>
                <p>Website Requests</p>
                <h2>Ask for help</h2>
              </div>
            </div>
            <div class="request-list">
              {requestActions.map((action) => <button type="button">{action}</button>)}
            </div>
            <button class="primary-action" type="button">Submit Website Request</button>
          </article>

          <article class="panel" id="profile">
            <div class="panel-head compact">
              <div>
                <p>Profile</p>
                <h2>Business info</h2>
              </div>
            </div>
            <dl class="profile-list">
              {profileRows.map(([label, value]) => (
                <div><dt>{label}</dt><dd>{value}</dd></div>
              ))}
            </dl>
          </article>

          <article class="panel plan-panel" id="plan">
            <div class="panel-head compact">
              <div>
                <p>Plan</p>
                <h2>Founder Website Package</h2>
              </div>
            </div>
            <div class="plan-price">
              <strong>$199/month</strong>
              <span>locked while active</span>
            </div>
            <ul>
              <li>Website Requests included</li>
              <li>You own your website, domain, and content</li>
              <li>Support continues after launch</li>
            </ul>
          </article>
        </section>

        <footer class="backend-footer" id="support">
          <div>
            <strong>Ready to get your own dashboard?</strong>
            <span>Start with a sample website, then use your Back Office to manage the basics after launch.</span>
          </div>
          <div class="backend-footer-actions">
            <a class="build" href={WEBSITE_PACKAGE.ctaHref} data-track="back-office-build-my-website" data-ga-event="click_backend_preview_build" data-ga-secondary-event="stripe_payment_link_click">Build My Website</a>
            <a href="/templates" data-track="back-office-view-sample-sites" data-ga-event="click_backend_preview_footer_samples">View Sample Sites</a>
          </div>
        </footer>
      </section>
    </div>
  </main>

  <QueryParamPreserver />

  <style>
    .backend-preview { --ink:#1b2433; --muted:#667386; --line:#dfe6df; --paper:#ffffff; --wash:#f3f6f1; --soft:#e8f1e9; --green:#216b4c; --green-dark:#174f38; --gold:#d7a647; min-height:100vh; color:var(--ink); background:#e8ece8; font-family:var(--font-sans); }
    .backend-frame { min-height:100vh; display:grid; grid-template-columns:260px minmax(0,1fr); overflow:hidden; }
    .backend-sidebar { position:sticky; top:0; height:100vh; min-width:0; display:flex; flex-direction:column; gap:1.25rem; padding:1rem; border-right:1px solid var(--line); background:#f8faf6; box-sizing:border-box; }
    .backend-brand { display:grid; gap:.2rem; padding:.85rem; border-radius:.9rem; color:var(--ink); text-decoration:none; background:var(--paper); border:1px solid var(--line); }
    .backend-brand span { font-weight:950; letter-spacing:-.03em; }
    .backend-brand small { color:var(--green); font-family:var(--font-mono); font-size:.7rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
    .backend-sidebar nav { display:grid; gap:.35rem; }
    .backend-sidebar nav a { display:flex; align-items:center; min-height:2.55rem; padding:0 .8rem; border-radius:.75rem; color:var(--ink); font-weight:850; text-decoration:none; }
    .backend-sidebar nav a[aria-current="page"],.backend-sidebar nav a:hover { background:var(--green); color:#fff; }
    .backend-main { min-width:0; padding:1rem; box-sizing:border-box; }
    .backend-topbar { display:flex; justify-content:space-between; gap:1rem; align-items:center; margin-bottom:1rem; padding:1rem; border:1px solid var(--line); border-radius:1rem; background:var(--paper); box-shadow:0 10px 30px rgba(27,36,51,.05); }
    .backend-topbar p { margin:0 0 .35rem; color:var(--muted); font-family:var(--font-mono); font-size:.72rem; font-weight:900; letter-spacing:.06em; text-transform:uppercase; }
    .backend-topbar h1 { margin:0; font-size:1.55rem; line-height:1.15; letter-spacing:-.035em; }
    .backend-actions,.backend-footer-actions { display:flex; flex-wrap:wrap; gap:.5rem; justify-content:flex-end; }
    .backend-actions a,.backend-footer-actions a,.primary-action,.review-grid button,.request-list button { display:inline-flex; align-items:center; justify-content:center; min-height:2.35rem; border-radius:.7rem; padding:.65rem .8rem; border:1px solid var(--line); background:#fff; color:var(--ink); font-family:var(--font-mono); font-size:.76rem; font-weight:900; text-decoration:none; cursor:pointer; }
    .backend-actions a:first-child,.primary-action,.backend-footer-actions .build { background:var(--green); color:#fff; border-color:var(--green); }
    .widget-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.75rem; margin-bottom:1rem; }
    .stat-widget,.panel,.backend-footer { border:1px solid var(--line); border-radius:1rem; background:var(--paper); box-shadow:0 10px 30px rgba(27,36,51,.05); }
    .stat-widget { padding:1rem; }
    .stat-widget p { margin:0 0 .55rem; color:var(--muted); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; }
    .stat-widget strong { display:block; font-size:1.65rem; line-height:1; letter-spacing:-.04em; }
    .stat-widget span { display:block; margin-top:.5rem; color:var(--muted); font-size:.86rem; }
    .dashboard-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:1rem; align-items:start; }
    .panel { padding:1rem; }
    .panel-head { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; margin-bottom:1rem; }
    .panel-head.compact { margin-bottom:.75rem; }
    .panel-head p { margin:0 0 .25rem; color:var(--green); font-family:var(--font-mono); font-size:.7rem; font-weight:900; letter-spacing:.06em; text-transform:uppercase; }
    .panel-head h2 { margin:0; font-size:1.15rem; line-height:1.2; letter-spacing:-.03em; }
    .panel-head > span { border-radius:999px; padding:.3rem .55rem; background:var(--soft); color:var(--green-dark); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; }
    .metric-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.6rem; }
    .metric-grid div { padding:.75rem; border:1px solid var(--line); border-radius:.8rem; background:var(--wash); }
    .metric-grid span { display:block; color:var(--muted); font-size:.82rem; }
    .metric-grid strong { display:block; margin-top:.25rem; font-size:1.15rem; }
    .mini-chart { display:flex; align-items:end; gap:.45rem; height:120px; margin-top:.75rem; padding:.85rem; border-radius:.8rem; border:1px solid var(--line); background:linear-gradient(180deg,#fff,var(--wash)); }
    .mini-chart i { flex:1; min-height:14px; border-radius:.4rem .4rem .15rem .15rem; background:linear-gradient(180deg,var(--gold),var(--green)); }
    table { width:100%; border-collapse:collapse; font-size:.92rem; }
    th { color:var(--muted); font-family:var(--font-mono); font-size:.68rem; letter-spacing:.06em; text-align:left; text-transform:uppercase; }
    th,td { padding:.75rem .55rem; border-bottom:1px solid var(--line); }
    td span { display:inline-flex; border-radius:999px; padding:.3rem .5rem; background:var(--soft); color:var(--green-dark); font-family:var(--font-mono); font-size:.68rem; font-weight:900; }
    .review-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.55rem; }
    .review-grid div { display:grid; gap:.25rem; padding:.75rem; border:1px solid var(--line); border-radius:.8rem; background:var(--wash); }
    .review-grid strong { font-size:1.35rem; }
    .review-grid span { color:var(--muted); font-size:.86rem; }
    .request-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem; margin-bottom:.6rem; }
    .request-list button { justify-content:flex-start; background:var(--wash); }
    .profile-list { margin:0; display:grid; gap:.25rem; }
    .profile-list div { display:flex; justify-content:space-between; gap:1rem; padding:.65rem 0; border-bottom:1px solid var(--line); }
    .profile-list dt { color:var(--muted); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; }
    .profile-list dd { margin:0; font-weight:850; text-align:right; }
    .plan-price { display:grid; gap:.2rem; margin-bottom:.75rem; padding:.85rem; border-radius:.8rem; background:var(--soft); }
    .plan-price strong { font-size:1.35rem; }
    .plan-price span,.plan-panel li { color:var(--muted); }
    .plan-panel ul { margin:.75rem 0 0; padding-left:1.1rem; line-height:1.65; }
    .backend-footer { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-top:1rem; padding:1rem; }
    .backend-footer strong { display:block; margin-bottom:.25rem; }
    .backend-footer span { color:var(--muted); }
    @media (max-width:1050px) { .backend-frame { grid-template-columns:minmax(0,1fr); } .backend-sidebar { position:static; width:100%; height:auto; border-right:0; border-bottom:1px solid var(--line); } .backend-sidebar nav { display:flex; max-width:100%; min-width:0; overflow-x:auto; padding-bottom:.2rem; } .backend-sidebar nav a { flex:0 0 auto; white-space:nowrap; } .backend-brand span,.backend-brand small { overflow-wrap:anywhere; } .widget-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .dashboard-grid { grid-template-columns:minmax(0,1fr); } }
    @media (max-width:680px) { .backend-main,.backend-sidebar { padding:.75rem; } .backend-topbar,.backend-footer { display:grid; } .backend-actions,.backend-footer-actions { justify-content:stretch; } .backend-actions a,.backend-footer-actions a { width:100%; } .widget-grid,.metric-grid,.review-grid,.request-list { grid-template-columns:1fr; } table,thead,tbody,tr,th,td { display:block; } thead { display:none; } tr { padding:.55rem 0; border-bottom:1px solid var(--line); } td { display:flex; justify-content:space-between; gap:1rem; border-bottom:0; padding:.35rem 0; } td:nth-child(1)::before { content:"Name"; color:var(--muted); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; } td:nth-child(2)::before { content:"Source"; color:var(--muted); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; } td:nth-child(3)::before { content:"Date"; color:var(--muted); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; } td:nth-child(4)::before { content:"Status"; color:var(--muted); font-family:var(--font-mono); font-size:.68rem; font-weight:900; text-transform:uppercase; } .profile-list div { display:grid; } .profile-list dd { text-align:left; } }
  </style>
</BaseLayout>
