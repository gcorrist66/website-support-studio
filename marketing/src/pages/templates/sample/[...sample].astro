---
import SampleBusinessLayout from "../../../components/sample-sites/SampleBusinessLayout.astro";
import RidgelineRoofingSample from "../../../components/sample-sites/RidgelineRoofingSample.astro";
import { SAMPLE_BUSINESSES, type SamplePage } from "../../../sampleBusinesses";

export function getStaticPaths() {
  const samplePages: { suffix: string; page: SamplePage }[] = [
    { suffix: "", page: "home" },
    { suffix: "services", page: "services" },
    { suffix: "about", page: "about" },
    { suffix: "work", page: "proof" },
    { suffix: "contact", page: "contact" },
  ];

  return SAMPLE_BUSINESSES.flatMap((business) =>
    samplePages
      .concat(
        business.serviceArea
          ? [
              { suffix: "service-area", page: "service-area" as const },
              { suffix: "service-areas", page: "service-area" as const },
            ]
          : [],
      )
      .map(({ suffix, page }) => ({
        params: { sample: suffix ? `${business.slug}/${suffix}` : business.slug },
        props: { business, page },
      }))
  );
}

const { business, page } = Astro.props;
const premiumTradeSlugs = new Set(["ridgeline-roofing", "northwind-hvac", "mainline-plumbing", "brightwire-electric", "bluewave-pools", "greenline-irrigation", "overpro-garage-doors", "shieldline-pest-control", "evergreen-lawn-landscape", "canopy-tree-care", "cornerstone-concrete", "brightwash-exterior-cleaning"]);
---
{premiumTradeSlugs.has(business.slug) ? <RidgelineRoofingSample business={business} page={page} /> : <SampleBusinessLayout business={business} page={page} />}
