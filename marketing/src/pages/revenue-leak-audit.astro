</BaseLayout>

<script is:inline>
  (function () {
    const sticky = document.getElementById("audit-mobile-sticky");
    if (!sticky) return;
    const onScroll = () => {
      const show = window.innerWidth <= 839 && window.scrollY > window.innerHeight * 0.5;
      sticky.classList.toggle("is-visible", show);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  })();
</script>
