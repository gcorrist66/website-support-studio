---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import { serviceSchema, breadcrumbSchema } from "../schema";
import { JOIN_PATH } from "../consts";

const lifecycle = [
  { step: "received", desc: "A request enters the desk through a single intake. It is logged, attributed to a site, and given an owner." },
  { step: "triaged", desc: "The request is classified, scope is confirmed, and anything blocked, urgent, or sensitive is flagged." },
  { step: "response_drafted", desc: "The change or reply is prepared — the edit, the fix, the verified configuration — ready for review." },
  { step: "awaiting_approval", desc: "The drafted work is held at a mandatory approval gate. Nothing customer-facing proceeds without sign-off." },
  { step: "approved", desc: "An authorized approver signs off. The platform records who approved it and when." },
  { step: "delivered", desc: "The approved change is executed and the requester receives confirmation." },
  { step: "closed", desc: "The request is closed with a closure note. The full record — source to sign-off — is retained." },
];

// What a customer can actually request — the concrete service offering.
const offerings = [
  { key: "content_updates", desc: "Copy, page, and content edits across your site." },
  { key: "landing_page_changes", desc: "Build-outs and edits to campaign and landing pages." },
  { key: "form_fixes", desc: "Repair broken forms, fields, validation, and submissions." },
  { key: "tracking_repairs", desc: "Fix broken tags, events, and conversion tracking." },
  { key: "schema_markup", desc: "Add or correct structured data so search engines read your pages." },
  { key: "seo_updates", desc: "On-page SEO: metadata, headings, and internal links." },
  { key: "cms_changes", desc: "Edits and configuration inside your CMS." },
  { key: "webflow_updates", desc: "Webflow content, pages, and CMS collections." },
  { key: "wordpress_updates", desc: "WordPress content, pages, and plugin configuration." },
  { key: "asset_replacements", desc: "Swap images, logos, documents, and downloads." },
  { key: "reporting_requests", desc: "Operational reports on requests, activity, and turnaround." },
  { key: "conversion_reviews", desc: "Reviews and recommendations to improve conversion." },
  { key: "configuration_help", desc: "Settings, redirects, and integration configuration." },
];

// What the customer actually receives back — outcomes, not just process.
const deliverables = [
  { title: "the change, made live", desc: "The requested edit, fix, or configuration is completed and published to your site — done for you, not just advised." },
  { title: "a confirmation", desc: "You're notified when the work ships, with a closure note describing exactly what changed." },
  { title: "a reviewed, recorded approval", desc: "Every change carries a mandatory human sign-off and a per-request audit trail: who approved what, and when." },
  { title: "a single point of ownership", desc: "One desk owns the request end to end — no chasing, no hand-offs lost between inboxes." },
];

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Managed Website Operations & Support",
    description:
      "A managed support desk for revenue-critical websites: single-desk intake, deterministic response workflows, human-approved execution, and a complete audit trail per request.",
    path: "/services",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
  ]),
];
---

<BaseLayout
  title="Services"
  description="What you receive from Website Support Studio's managed operations desk — completed changes, confirmation, and a recorded approval — plus what you can request (content, forms, tracking, SEO, CMS, Webflow, WordPress) and the workflow every request follows."
  path="/services"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_services" /></p>
      <h1>a managed operations desk for revenue-critical websites.</h1>
      <p class="lede" style="margin-top:1rem;">
        Website Support Studio is a service, not software you are left to run. An operator-led support
        process, managed by Corriston Consulting, runs inside a defined workflow so every request is
        visible, owned, reviewed, and recorded.
      </p>
      <div class="hero-actions">
        <a class="btn btn-green btn-cta" href={JOIN_PATH}><Label text="_join_now" /></a>
        <a class="btn btn-ghost" href="/pricing">How Engagements Are Priced</a>
      </div>
    </div>
  </section>

  <!-- What you receive — the outcome the customer is actually buying -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_what_you_receive" /></p>
      <h2>Every request comes back as a finished outcome.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        You're not buying advice or a tool to operate yourself — you're buying the completed work, delivered
        and accounted for.
      </p>
      <div class="grid grid-2" style="margin-top:2rem;">
        {
          deliverables.map((d) => (
            <div class="card">
              <h3 style="margin-top:0;">{d.title}</h3>
              <p style="margin:0.4rem 0 0; color:var(--text-muted);">{d.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Service offering — what a customer can actually request -->
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_what_you_can_request" /></p>
      <h2>The kinds of work you can send to the desk.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Submit a request from your account and it enters the workflow below. These are the everyday changes
        the desk handles.
      </p>
      <div class="grid grid-3" style="margin-top:2rem;">
        {
          offerings.map((o) => (
            <div class="card">
              <p class="marker"><Label text={`_${o.key}`} /></p>
              <p style="margin:0.5rem 0 0; color:var(--text-muted); font-size:0.9rem;">{o.desc}</p>
            </div>
          ))
        }
      </div>
      <p style="margin-top:1.5rem; color:var(--text-muted); max-width:64ch;">
        Larger initiatives — full website redesigns, custom application development, and advanced platform
        integrations — sit outside the standing desk and are scoped as separate engagements.
      </p>
    </div>
  </section>

  <!-- Response workflow (kept) -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_response_workflow" /></p>
      <h2>Every request follows the same defined lifecycle.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        The workflow is deterministic and identical whether the request is a one-line copy change or a
        multi-step operational fix — which is what makes it predictable and auditable.
      </p>
      <ol class="deflist" style="margin-top:2rem; counter-reset:step; list-style:none; padding:0;">
        {
          lifecycle.map((l) => (
            <li class="card" style="display:flex; gap:1rem; align-items:flex-start;">
              <span style="font-weight:800; color:var(--brand-blue); white-space:nowrap;">{l.step}</span>
              <span style="color:var(--text);">{l.desc}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Questions → single source of truth at /faqs -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Questions, answered.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Platforms, code changes, SEO, tracking, approvals, and more — all in one place.
      </p>
      <p style="margin-top:1.25rem;">
        <a href="/faqs" style="font-weight:600;"><Label text="see_all_questions" /> →</a>
      </p>
    </div>
  </section>
</BaseLayout>
