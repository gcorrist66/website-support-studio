---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import Faq from "../components/Faq.astro";
import { serviceSchema, breadcrumbSchema, faqSchema } from "../schema";
import { JOIN_PATH } from "../consts";

const lifecycle = [
  { step: "received", desc: "A request enters the desk through a single intake. It is logged, attributed to a site, and given an owner." },
  { step: "triaged", desc: "The request is classified, scope is confirmed, and anything blocked, urgent, or sensitive is flagged." },
  { step: "response_drafted", desc: "The change or reply is prepared — the edit, the fix, the verified configuration — ready for review." },
  { step: "awaiting_approval", desc: "The drafted work is held at a mandatory approval gate. Nothing customer-facing proceeds without sign-off." },
  { step: "approved", desc: "An authorized approver signs off. The platform records who approved it and when." },
  { step: "delivered", desc: "The approved change is executed and the requester receives confirmation." },
  { step: "closed", desc: "The request is closed with a closure note. The full record — source to sign-off — is retained." },
];

// What a customer can actually request — the concrete service offering.
const offerings = [
  { key: "content_updates", desc: "Copy, page, and content edits across your site." },
  { key: "landing_page_changes", desc: "Build-outs and edits to campaign and landing pages." },
  { key: "form_fixes", desc: "Repair broken forms, fields, validation, and submissions." },
  { key: "tracking_repairs", desc: "Fix broken tags, events, and conversion tracking." },
  { key: "schema_markup", desc: "Add or correct structured data so search engines read your pages." },
  { key: "seo_updates", desc: "On-page SEO: metadata, headings, and internal links." },
  { key: "cms_changes", desc: "Edits and configuration inside your CMS." },
  { key: "webflow_updates", desc: "Webflow content, pages, and CMS collections." },
  { key: "wordpress_updates", desc: "WordPress content, pages, and plugin configuration." },
  { key: "asset_replacements", desc: "Swap images, logos, documents, and downloads." },
  { key: "reporting_requests", desc: "Operational reports on requests, activity, and turnaround." },
  { key: "conversion_reviews", desc: "Reviews and recommendations to improve conversion." },
  { key: "configuration_help", desc: "Settings, redirects, and integration configuration." },
];

const faqs = [
  { q: "Who is this for?", a: "Organizations with revenue-critical websites — marketing, marketing-operations, digital, and IT teams who need website changes done reliably without staffing and supervising the work themselves. It is not built for hobby sites or one-off freelance tasks." },
  { q: "How do requests work?", a: "You submit a request from your account. It enters one desk, gets an owner and a status, moves through triage and drafting, passes a mandatory human approval gate, and is delivered and closed — with every step recorded." },
  { q: "How fast are responses?", a: "Requests are acknowledged on the next business day and prioritized by urgency. Urgent production issues are routed through an expedited path while still passing the approval gate." },
  { q: "What counts as a request?", a: "A single, scoped piece of work — a content edit, a form fix, a tracking repair, a CMS change. Larger initiatives like full redesigns or custom application builds are scoped as separate engagements." },
  { q: "What is a Capacity Unit?", a: "Capacity Units measure the effort of a request. Each plan includes a monthly allotment; a simple change costs fewer units, more involved work costs more." },
  { q: "What happens if I run out?", a: "Your allotment refreshes every month. In a busy month you can add a top-up — 50, 100, or 250 Capacity Units — at any time from your account." },
  { q: "Do you work with WordPress?", a: "Yes. WordPress content, page, and configuration changes are a core request type." },
  { q: "Do you work with Webflow?", a: "Yes. Webflow updates — content, pages, and CMS collections — are supported." },
  { q: "Do you work with custom sites?", a: "Yes, for content, configuration, and front-end changes. Deep custom application development is scoped as a separate engagement." },
  { q: "Do you make code changes?", a: "We make scoped front-end and configuration changes — markup, templates, tracking, and schema. Large feature builds and backend development are scoped separately." },
  { q: "Do you provide SEO support?", a: "Yes — on-page SEO updates, metadata, schema markup, and technical fixes. Full SEO strategy engagements are scoped separately." },
  { q: "Do you manage tracking and analytics?", a: "Yes. Tag and analytics verification, tracking repairs, and GA4 / Tag Manager configuration are common requests." },
  { q: "Can you help with forms and integrations?", a: "Yes — form fixes, field changes, and common integrations such as form-to-CRM or email. Complex custom integrations are scoped separately." },
  { q: "Is every change reviewed?", a: "Yes. No customer-facing change ships without a mandatory human approval, recorded with the approver and a timestamp." },
  { q: "Who approves changes?", a: "An authorized approver on the operations side signs off before anything goes live, and the approval is recorded in the request's audit trail." },
  { q: "Do you offer custom plans?", a: "Yes. Enterprise covers custom capacity, site coverage, onboarding, and commercial terms — contact us to scope it." },
];

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Managed Website Operations & Support",
    description:
      "A managed support desk for revenue-critical websites: single-desk intake, deterministic response workflows, human-approved execution, and a complete audit trail per request.",
    path: "/services",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  title="Services"
  description="What you can request from Website Support Studio's managed operations desk — content, landing pages, forms, tracking, SEO, CMS, Webflow, and WordPress changes — and the human-approved workflow every request follows."
  path="/services"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_services" /></p>
      <h1>A managed operations desk for revenue-critical websites.</h1>
      <p class="lede" style="margin-top:1rem;">
        Website Support Studio is a service, not software you are left to run. An operator-led support
        process, managed by Corriston Consulting, runs inside a defined workflow so every request is
        visible, owned, reviewed, and recorded.
      </p>
      <div class="hero-actions">
        <a class="btn btn-green btn-cta" href={JOIN_PATH}><Label text="_join_now" /></a>
        <a class="btn btn-ghost" href="/pricing">How Engagements Are Priced</a>
      </div>
    </div>
  </section>

  <!-- Service offering — what a customer can actually request -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_what_you_can_request" /></p>
      <h2>The kinds of work you can send to the desk.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Submit a request from your account and it enters the workflow below. These are the everyday changes
        the desk handles — pick a plan and start sending work.
      </p>
      <div class="grid grid-3" style="margin-top:2rem;">
        {
          offerings.map((o) => (
            <div class="card">
              <p class="marker"><Label text={`_${o.key}`} /></p>
              <p style="margin:0.5rem 0 0; color:var(--text-muted); font-size:0.9rem;">{o.desc}</p>
            </div>
          ))
        }
      </div>
      <p style="margin-top:1.5rem; color:var(--text-muted); max-width:64ch;">
        Larger initiatives — full website redesigns, custom application development, and advanced platform
        integrations — sit outside the standing desk and are scoped as separate engagements.
      </p>
    </div>
  </section>

  <!-- Response workflow (kept) -->
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_response_workflow" /></p>
      <h2>Every request follows the same defined lifecycle.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        The workflow is deterministic and identical whether the request is a one-line copy change or a
        multi-step operational fix — which is what makes it predictable and auditable.
      </p>
      <ol class="deflist" style="margin-top:2rem; counter-reset:step; list-style:none; padding:0;">
        {
          lifecycle.map((l) => (
            <li class="card" style="display:flex; gap:1rem; align-items:flex-start;">
              <span style="font-weight:800; color:var(--brand-blue); white-space:nowrap;">{l.step}</span>
              <span style="color:var(--text);">{l.desc}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Frequently asked questions</h2>
      <div style="margin-top:1.5rem;">
        <Faq items={faqs} />
      </div>
    </div>
  </section>
</BaseLayout>
