---
import BaseLayout from "../layouts/BaseLayout.astro";
import Label from "../components/Label.astro";
import { serviceSchema, breadcrumbSchema } from "../schema";
import { JOIN_PATH } from "../consts";

const lifecycle = [
  { step: "You send a request", desc: "Tell us exactly what needs help on your site." },
  { step: "We confirm it", desc: "We review, then confirm timing and scope in plain language." },
  { step: "We do the work", desc: "Our team makes the change and checks it works." },
  { step: "You approve it", desc: "Nothing goes live without a person signing off." },
  { step: "You get confirmation", desc: "The request closes with a clear note on what changed." },
];

const sampleRoutes = [
  { name: "Authentic Air Solutions", path: "/authentic-air-solutions/" },
  { name: "Consistent Heating and Cooling", path: "/consistent-ac/" },
  { name: "A Bartlett Roofing", path: "/a-bartlett/" },
  { name: "Kam Roofing", path: "/kam-roofing/" },
  { name: "Ability Air", path: "/ability-air/" },
];

// What a customer can actually request — simplified and non-technical.
const offerings = [
  { key: "content_updates", desc: "Update text, pages, and buttons on your website." },
  { key: "form_repairs", desc: "Fix broken forms and improve lead capture." },
  { key: "site_bug_fixes", desc: "Patch broken links, broken embeds, and layout issues." },
  { key: "campaign_pages", desc: "Add quick campaign pages, events, and offers." },
  { key: "support_questions", desc: "Ask for routine website help without switching tools." },
];

const deliverables = [
  { title: "the change, made live", desc: "Your requested edit is completed and published." },
  { title: "a confirmation", desc: "You receive a clear done note and what was changed." },
  { title: "a reviewed, recorded approval", desc: "Every customer-facing change gets a human sign-off." },
  { title: "single-point ownership", desc: "One desk owns each request end to end." },
];

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Managed Website Operations & Support",
    description:
      "A managed website support desk for small businesses: clear request handling, human review, and completed website updates you can trust.",
    path: "/services",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
  ]),
];
---

<BaseLayout
  title="Services"
  description="Professional website support and website help for small businesses. Request a change and get a clear result: updates, approvals, and a finished outcome."
  path="/services"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker"><Label text="_services" /></p>
      <h1>professional website support and website help for small businesses.</h1>
      <p class="lede" style="margin-top:1rem;">
        One place to request help for your site. You send what needs fixing, we handle it, and you get a clear
        done notice when it is complete.
      </p>
      <div class="hero-actions">
        <a class="btn btn-green btn-cta" href={JOIN_PATH}><Label text="_join_now" /></a>
        <a class="btn btn-ghost" href="/pricing">See pricing</a>
      </div>
    </div>
  </section>

  <!-- What you get — outcomes. -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker"><Label text="_what_you_receive" /></p>
      <h2>What you actually get.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        You are buying completed website changes, not a software product.
      </p>
      <div class="grid grid-2" style="margin-top:2rem;">
        {
          deliverables.map((d) => (
            <div class="card">
              <h3 style="margin-top:0;">{d.title}</h3>
              <p style="margin:0.4rem 0 0; color:var(--text-muted);">{d.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sample websites / preview examples -->
  <section class="section">
    <div class="container">
      <p class="kicker">sample websites</p>
      <h2>Sample websites to review (example pages).</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Browse existing examples while you decide what format you need.
      </p>
      <ul style="margin-top:1rem; padding-left:1.1rem; max-width:68ch;">
        {sampleRoutes.map((sample) => (
          <li style="margin-bottom:0.5rem;"><a href={sample.path} style="font-weight:600;">{sample.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker">how it works</p>
      <h2>How we handle your request.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        You can send any small website task and we move it through a simple path.
      </p>
      <ol class="deflist" style="margin-top:2rem; counter-reset:step; list-style:none; padding:0;">
        {
          lifecycle.map((l) => (
            <li class="card" style="display:flex; gap:1rem; align-items:flex-start;">
              <span style="font-weight:800; color:var(--brand-blue); white-space:nowrap;">{l.step}</span>
              <span style="color:var(--text);">{l.desc}</span>
            </li>
          ))
        }
      </ol>

      <div style="margin-top:2rem;">
        <p class="kicker"><Label text="_what_you_can_request" /></p>
        <h3>Types of support we handle.</h3>
        <div class="grid grid-3" style="margin-top:1rem;">
          {
            offerings.map((o) => (
              <div class="card">
                <p class="marker"><Label text={`_${o.key}`} /></p>
                <p style="margin:0.5rem 0 0; color:var(--text-muted); font-size:0.9rem;">{o.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Questions → single source of truth at /faqs -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="kicker"><Label text="_questions" /></p>
      <h2>Questions, answered.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Platforms, approvals, timing, and pricing details are all in one place.
      </p>
      <p style="margin-top:1.25rem;">
        <a href="/faqs" style="font-weight:600;"><Label text="see_all_questions" /> →</a>
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker">start now</p>
      <h2>Ready to get website support you can trust?</h2>
      <p class="lede" style="margin-top:0.75rem;">
        Start with a small request and see how quickly your site gets improved.
      </p>
      <div class="hero-actions" style="margin-top:1.3rem;">
        <a class="btn btn-green btn-cta" href={JOIN_PATH}><Label text="_join_now" /></a>
        <a class="btn btn-ghost" href="/contact">Talk to us first</a>
      </div>
    </div>
  </section>
</BaseLayout>
