---
import BaseLayout from "../layouts/BaseLayout.astro";
import { serviceSchema, breadcrumbSchema, faqSchema } from "../schema";
import { CONTACT } from "../consts";

const lifecycle = [
  { step: "received", desc: "A request enters the desk through a single intake. It is logged, attributed to a site, and given an owner." },
  { step: "triaged", desc: "The request is classified, scope is confirmed, and anything blocked, urgent, or sensitive is flagged." },
  { step: "response_drafted", desc: "The change or reply is prepared — the edit, the fix, the verified configuration — ready for review." },
  { step: "awaiting_approval", desc: "The drafted work is held at a mandatory approval gate. Nothing customer-facing proceeds without sign-off." },
  { step: "approved", desc: "An authorized approver signs off. The platform records who approved it and when." },
  { step: "delivered", desc: "The approved change is executed and the requester receives confirmation." },
  { step: "closed", desc: "The request is closed with a closure note. The full record — source to sign-off — is retained." },
];

const requestTypes = [
  "Website content and landing-page updates",
  "Broken link and form troubleshooting",
  "Image replacements and asset swaps",
  "CMS edits across common platforms",
  "Tracking and analytics verification",
  "Conversion and configuration recommendations",
];

const faqs = [
  {
    q: "What kinds of requests does Website Support Studio handle?",
    a: "Website content and landing-page updates, broken link and form fixes, image and asset swaps, CMS edits, tracking and analytics verification, and conversion recommendations. Larger initiatives — full redesigns, custom application development, and advanced integrations — are scoped separately.",
  },
  {
    q: "What does the response workflow look like?",
    a: "Every request moves through a deterministic lifecycle: received, triaged, response drafted, awaiting approval, approved, delivered, and closed. Urgent production issues are routed through an expedited path while still passing the approval gate.",
  },
  {
    q: "How do approvals work?",
    a: "No customer-facing change is published without a mandatory human approval. The platform records the approver, the decision, and the timestamp as part of each request's audit trail.",
  },
];

const schemas = [
  serviceSchema({
    name: "Website Support Studio — Managed Website Operations & Support",
    description:
      "A managed support desk for revenue-critical websites: single-desk intake, deterministic response workflows, human-approved execution, and a complete audit trail per request.",
    path: "/services",
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  title="Services"
  description="How Website Support Studio's managed operations desk works: single-desk intake, a deterministic response workflow from triage to closure, human-approved execution, and a full audit trail for every request."
  path="/services"
  schemas={schemas}
>
  <section class="section">
    <div class="container">
      <p class="kicker">services</p>
      <h1>A managed operations desk for revenue-critical websites.</h1>
      <p class="lede" style="margin-top:1rem;">
        Website Support Studio is a service, not software you are left to run. An operator-led support
        process, managed by Corriston Consulting, runs inside a defined workflow so every request is
        visible, owned, reviewed, and recorded.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={CONTACT.bookingUrl} target="_blank" rel="noopener">book a scoping call</a>
        <a class="btn btn-ghost" href="/pricing">how engagements are priced</a>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface-muted);">
    <div class="container">
      <p class="kicker">response_workflow</p>
      <h2>Every request follows the same defined lifecycle.</h2>
      <p class="lede" style="margin-top:0.75rem;">
        The workflow is deterministic and identical whether the request is a one-line copy change or a
        multi-step operational fix — which is what makes it predictable and auditable.
      </p>
      <ol class="deflist" style="margin-top:2rem; counter-reset:step; list-style:none; padding:0;">
        {
          lifecycle.map((l) => (
            <li class="card" style="display:flex; gap:1rem; align-items:flex-start;">
              <span style="font-weight:800; color:var(--brand-blue); white-space:nowrap;">{l.step}</span>
              <span style="color:var(--text);">{l.desc}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">request_types</p>
      <h2>What the desk handles.</h2>
      <div class="grid grid-3" style="margin-top:2rem;">
        {requestTypes.map((r) => <div class="card"><p style="margin:0;">{r}</p></div>)}
      </div>
      <p style="margin-top:1.5rem; color:var(--text-muted); max-width:60ch;">
        Larger initiatives — full website redesigns, custom application development, and advanced platform
        integrations — sit outside the standing desk and are scoped as separate engagements.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--surface-muted);">
    <div class="container" style="max-width:820px;">
      <p class="kicker">questions</p>
      <h2>Frequently asked questions</h2>
      <div class="faq" style="margin-top:1.5rem;">
        {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</BaseLayout>
