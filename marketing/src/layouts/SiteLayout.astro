---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { siteConfig, type SiteConfig } from "../data/site";
import type { DesignSystem } from "../data/prospectPreviews";

type JsonLdType = "home" | "services" | "gallery" | "about" | "contact" | "default";

interface Props {
  title: string;
  description: string;
  path: string;
  type?: JsonLdType;
  basePath?: string;
  designSystem?: DesignSystem;
  siteConfigOverride?: Partial<SiteConfig>;
}

const {
  title,
  description,
  path,
  type = "default",
  basePath = "/",
  designSystem,
  siteConfigOverride
} = Astro.props as Props;
const resolvedSiteConfig: SiteConfig = { ...siteConfig, ...(siteConfigOverride ?? {}) };
const docTitle = `${title} · ${resolvedSiteConfig.siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={docTitle} description={description} path={path} siteConfigOverride={resolvedSiteConfig} />
    <JsonLd title={title} description={description} path={path} type={type} siteConfigOverride={resolvedSiteConfig} />
  </head>
  <body class:list={designSystem ? ["preview-theme", designSystem] : []}>
    <Header basePath={basePath} siteConfig={resolvedSiteConfig} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer siteConfig={resolvedSiteConfig} basePath={basePath} />
    <script is:inline>
      (function() {
        const firstInput = document.querySelector("main");
        if (firstInput) firstInput.focus();
      })();
    </script>
  </body>
</html>
