---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { siteConfig } from "../data/site";

type JsonLdType = "home" | "services" | "gallery" | "about" | "contact" | "default";

interface Props {
  title: string;
  description: string;
  path: string;
  type?: JsonLdType;
}

const { title, description, path, type = "default" } = Astro.props as Props;
const docTitle = `${title} · ${siteConfig.siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={docTitle} description={description} path={path} />
    <JsonLd title={title} description={description} path={path} type={type} />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <script is:inline>
      (function() {
        const firstInput = document.querySelector("main");
        if (firstInput) firstInput.focus();
      })();
    </script>
  </body>
</html>
